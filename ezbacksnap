die() { echo "ezbacksnap: $*" >&2; exit 1; }


# ======================= backup ==========================================
# A backup is a dated copy of a directory inside a destination directory: DEST/YYYY-MM-DD_HHMMSS. Same idea as
# snapshots (create, list, prune, delete) plus what a backup really needs: restore, and named jobs so the same
# backup can be run again with one word (or from cron / a timer).
#   ezbacksnap backup SRC DEST                   create (also: backup create SRC DEST)
#   ezbacksnap backup list DEST                  the copies in DEST, oldest first, with sizes
#   ezbacksnap backup prune DEST [KEEP]          drop the oldest beyond KEEP (default BACKUP_KEEP)
#   ezbacksnap backup delete DEST NAME
#   ezbacksnap backup restore DEST NAME TARGET [--dry-run] [--delete]
#   ezbacksnap backup add JOB SRC DEST [KEEP] | remove JOB | jobs | run JOB|--all
JOBS_FILE="${EZBACKSNAP_JOBS:-${XDG_CONFIG_HOME:-$HOME/.config}/ezbacksnap/jobs}"   # JOB <TAB> SRC <TAB> DEST [<TAB> KEEP]

# DEST -> the copies in it, oldest first (only exactly timestamped names are ever touched)
bk_names() {
	for d in "$1"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]; do
		[ -d "$d" ] && basename "$d"
	done
}

# Deleting a subvolume needs root unless the fs is mounted with user_subvol_rm_allowed, so fall back to sudo.
# (A btrfs subvolume root always has inode 256, which is how snapshots are told from plain dirs.)
bk_rmsub() {
	btrfs subvolume delete "$1" >/dev/null 2>&1 && return 0
	[ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1 && sudo btrfs subvolume delete "$1" >/dev/null
}

bk_rm() {   # DEST NAME
	old=$1/$2
	if [ "$(stat -f -c %T "$1")" = btrfs ] && [ "$(stat -c %i "$old")" = 256 ]; then
		bk_rmsub "$old" || { echo "backup: could not delete $old (needs root or the user_subvol_rm_allowed mount option)" >&2; return 1; }
	else
		rm -rf -- "$old" || { echo "backup: could not delete $old" >&2; return 1; }
	fi
}

bk_prune() {   # DEST [KEEP]
	keep=${2:-$BACKUP_KEEP}
	case $keep in ''|*[!0-9]*|0) die "KEEP must be a positive number, got '$keep'";; esac
	total=$(bk_names "$1" | wc -l)
	[ "$total" -gt "$keep" ] || return 0
	bk_names "$1" | head -n $((total - keep)) | while read -r old; do
		echo "removing old backup $old"
		bk_rm "$1" "$old"
	done
}

bk_create() {   # SRC DEST [KEEP]
	src=${1%/}; dest=${2%/}; keep=${3:-$BACKUP_KEEP}
	case $keep in ''|*[!0-9]*|0) die "KEEP must be a positive number, got '$keep'";; esac
	[ -d "$src" ] || die "SRC is not a directory: $src"
	command -v rsync >/dev/null 2>&1 || die "rsync not found"
	mkdir -p "$dest" || die "cannot create $dest"

	name=$(date +%Y-%m-%d_%H%M%S)
	while [ -e "$dest/$name" ]; do sleep 1; name=$(date +%Y-%m-%d_%H%M%S); done   # two runs in one second must not share a name
	fs=$(stat -f -c %T "$dest")
	echo "backing up $src -> $dest/$name ($fs, keep $keep) ..."

	if [ "$fs" = btrfs ]; then
		command -v btrfs >/dev/null 2>&1 || die "btrfs-progs not found"
		cur=$dest/current
		if [ ! -e "$cur" ]; then
			btrfs subvolume create "$cur" >/dev/null || die "cannot create subvolume $cur"
		fi
		rsync -a --delete --info=progress2 "$src"/ "$cur"/ || die "rsync failed, no backup taken"
		btrfs subvolume snapshot -r "$cur" "$dest/$name" >/dev/null || die "snapshot failed"
	else
		tmp=$dest/.partial-$name
		prev=$(bk_names "$dest" | tail -n 1)
		if [ -n "$prev" ]; then
			rsync -a --delete --info=progress2 --link-dest="$dest/$prev" "$src"/ "$tmp"/ || { rm -rf -- "$tmp"; die "rsync failed, no backup taken"; }
		else
			rsync -a --delete --info=progress2 "$src"/ "$tmp"/ || { rm -rf -- "$tmp"; die "rsync failed, no backup taken"; }
		fi
		mv -- "$tmp" "$dest/$name" || die "cannot finalize $dest/$name"
	fi

	bk_prune "$dest" "$keep"
	echo "done: $(bk_names "$dest" | wc -l) backup(s) in $dest"
}

bk_list() {   # DEST
	[ -d "$1" ] || die "no such directory: $1"
	n=$(bk_names "$1" | wc -l)
	echo "$n backup(s) in $1 (oldest first):"
	bk_names "$1" | while read -r name; do
		printf '%s\t%s\n' "$name" "$(du -sh --apparent-size "$1/$name" 2>/dev/null | cut -f1)"
	done
}

bk_restore() {   # DEST NAME TARGET [--dry-run] [--delete]
	dest=${1%/}; name=$2; target=${3%/}; shift 3
	dry=; del=
	for o in "$@"; do case $o in --dry-run|-n) dry=--dry-run ;; --delete) del=--delete ;; *) die "unknown option $o" ;; esac; done
	[ -d "$dest/$name" ] || die "no backup $name in $dest"
	command -v rsync >/dev/null 2>&1 || die "rsync not found"
	# only files that changed are copied; nothing is removed from TARGET unless --delete was asked for
	echo "restoring $dest/$name -> $target${dry:+ (dry run: nothing is written)}${del:+ (deleting what the backup does not have)}"
	mkdir -p "$target" || die "cannot create $target"
	rsync -a $dry $del --info=progress2 "$dest/$name"/ "$target"/
}

# ---- named jobs (so one word repeats a backup) ----
job_all() { [ -f "$JOBS_FILE" ] && cat "$JOBS_FILE"; return 0; }
job_add() {   # JOB SRC DEST [KEEP]
	case $1 in ''|*[!A-Za-z0-9._-]*) die "job names use letters, digits . _ - only, got '$1'";; esac
	[ -d "$2" ] || die "SRC is not a directory: $2"
	mkdir -p "$(dirname -- "$JOBS_FILE")"
	tmp=$JOBS_FILE.new
	job_all | awk -F'\t' -v n="$1" '$1 != n' >"$tmp"
	printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:-}" >>"$tmp"
	mv -- "$tmp" "$JOBS_FILE" && echo "job $1: $2 -> $3"
}
job_remove() {
	job_all | awk -F'\t' -v n="$1" '$1 == n { f = 1 } END { exit !f }' || die "no job $1"
	job_all | awk -F'\t' -v n="$1" '$1 != n' >"$JOBS_FILE.new" && mv -- "$JOBS_FILE.new" "$JOBS_FILE" && echo "removed job $1"
}
job_run() {   # JOB | --all
	if [ "$1" = --all ]; then
		job_all | while IFS='	' read -r j s d k; do [ -n "$j" ] && { echo "== $j"; ( bk_create "$s" "$d" "$k" ) || echo "job $j failed" >&2; }; done
		return 0
	fi
	line=$(job_all | awk -F'\t' -v n="$1" '$1 == n') || true
	[ -n "$line" ] || die "no job $1 (ezbacksnap backup jobs)"
	IFS='	' read -r _j s d k <<EOF
$line
EOF
	bk_create "$s" "$d" "$k"
}

bk_main() {
	case ${1:-} in
		create)         shift; [ $# -ge 2 ] || die "usage: ezbacksnap backup create SRC DEST [KEEP]"; bk_create "$@" ;;
		list)           [ $# -eq 2 ] || die "usage: ezbacksnap backup list DEST"; bk_list "$2" ;;
		prune)          [ $# -ge 2 ] || die "usage: ezbacksnap backup prune DEST [KEEP]"; bk_prune "$2" "${3:-}" ;;
		delete)         [ $# -eq 3 ] || die "usage: ezbacksnap backup delete DEST NAME"; [ -d "$2/$3" ] || die "no backup $3 in $2"; bk_rm "$2" "$3" && echo "deleted $3" ;;
		restore)        [ $# -ge 4 ] || die "usage: ezbacksnap backup restore DEST NAME TARGET [--dry-run] [--delete]"; shift; bk_restore "$@" ;;
		add)            [ $# -ge 4 ] || die "usage: ezbacksnap backup add JOB SRC DEST [KEEP]"; shift; job_add "$@" ;;
		remove | rm)    [ $# -eq 2 ] || die "usage: ezbacksnap backup remove JOB"; job_remove "$2" ;;
		jobs)           job_all | awk -F'\t' '{ printf "%-16s %s -> %s%s\n", $1, $2, $3, ($4 != "" ? "  (keep " $4 ")" : "") }' ;;
		run)            [ $# -eq 2 ] || die "usage: ezbacksnap backup run JOB|--all"; job_run "$2" ;;
		*)              [ $# -ge 2 ] || die "usage: ezbacksnap backup SRC DEST | list|prune|delete|restore|add|remove|jobs|run ..."; bk_create "$@" ;;
	esac
}

# ======================= snapshot ========================================
# NAME pattern: date, time, optional label
is_snap_name() {
	case $1 in
		[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9] | \
		[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_*) return 0 ;;
	esac
	return 1
}

tname() {   # mount point -> short name
	[ "$1" = / ] && { echo root; return; }
	echo "${1#/}" | tr / _
}

stamp() { date +%Y-%m-%d_%H%M%S; }

# newest-last list of snapshot names found in DIR
names_in() {
	for d in "$1"/*; do
		[ -e "$d" ] || continue
		n=$(basename -- "$d")
		is_snap_name "$n" && echo "$n"
	done
}

# The label of a snapshot is what follows DATE_TIME_ ("daily", "pre-update", ...); no label = a manual one.
tier_of() { x=${1#*_}; case $x in *_*) echo "${x#*_}" ;; *) echo manual ;; esac; }
keep_for() {   # LABEL -> how many to keep
	for kv in $SNAPSHOT_TIERS; do [ "${kv%%:*}" = "$1" ] && { echo "${kv#*:}"; return; }; done
	echo "$KEEP"
}
# stdin: snapshot names, oldest first -> stdout: the ones beyond the keep count of their own label
to_remove() {
	all=$(cat)
	for tier in $(printf '%s\n' "$all" | while read -r n; do [ -n "$n" ] && tier_of "$n"; done | sort -u); do
		k=$(keep_for "$tier")
		mine=$(printf '%s\n' "$all" | while read -r n; do [ -n "$n" ] && [ "$(tier_of "$n")" = "$tier" ] && echo "$n"; done)
		cnt=$(printf '%s\n' "$mine" | wc -l)
		[ "$cnt" -gt "$k" ] && printf '%s\n' "$mine" | head -n $((cnt - k))
	done
}

# ======================= btrfs ==========================================
# Targets are grouped by device; one top-level (subvolid=5) mount each.
btrfs_devs() {
	for t in $TARGETS; do
		findmnt -no SOURCE -T "$t" | sed 's/\[.*//'
	done | sort -u
}

btrfs_with_top() {   # DEV FUNC...  mounts the top level, runs FUNC with $TOP set
	dev=$1; shift
	TOP=$(mktemp -d) || die "mktemp failed"
	mount -o subvolid=5 "$dev" "$TOP" || { rmdir "$TOP"; die "cannot mount top-level of $dev"; }
	# die() exits from inside $@, so unmount from a trap as well
	trap 'umount "$TOP" 2>/dev/null; rmdir "$TOP" 2>/dev/null' EXIT
	"$@"; rc=$?
	trap - EXIT
	umount "$TOP"; rmdir "$TOP"
	return $rc
}

btrfs_holder() {
	[ -d "$TOP/$SNAP_SUBVOL" ] || btrfs subvolume create "$TOP/$SNAP_SUBVOL" >/dev/null || die "cannot create $SNAP_SUBVOL"
	echo "$TOP/$SNAP_SUBVOL"
}

btrfs_rm() {   # NAME: delete the nested subvolumes then the directory
	holder=$1; n=$2
	for sv in "$holder/$n"/*; do
		[ -e "$sv" ] && { btrfs subvolume delete "$sv" >/dev/null || echo "snapshot: could not delete $sv" >&2; }
	done
	rmdir "$holder/$n" 2>/dev/null
}

btrfs_prune() {
	holder=$(btrfs_holder)
	names_in "$holder" | to_remove | while read -r n; do
		echo "removing old snapshot $n"; btrfs_rm "$holder" "$n"
	done
}

btrfs_create() {
	holder=$(btrfs_holder)
	mkdir "$holder/$NAME" || die "snapshot $NAME already exists"
	done_n=0; failed=
	for t in $TARGETS; do
		[ "$(findmnt -no SOURCE -T "$t" | sed 's/\[.*//')" = "$DEV" ] || continue
		root=$(findmnt -no FSROOT -T "$t")
		if err=$(btrfs subvolume snapshot -r "$TOP$root" "$holder/$NAME/$(tname "$t")" 2>&1); then
			echo "  $t -> $SNAP_SUBVOL/$NAME/$(tname "$t")"; done_n=$((done_n + 1))
		else
			echo "snapshot: $t FAILED: ${err#ERROR: }" >&2; failed="$failed $t"
			# btrfs refuses to snapshot a subvolume that holds an active swapfile
			case $err in *busy*) echo "  (an active swapfile probably lives on the subvolume of $t; give it its own:" >&2
				echo "   btrfs subvolume create /swap, chattr +C, recreate the swapfile there)" >&2 ;; esac
		fi
	done
	if [ "$done_n" -eq 0 ]; then btrfs_rm "$holder" "$NAME"; die "nothing snapshotted"; fi
	btrfs_prune
	[ -z "$failed" ] || { echo "snapshot: kept a partial snapshot, missing:$failed" >&2; return 1; }
}

btrfs_list() {
	holder=$(btrfs_holder)
	names_in "$holder" | while read -r n; do echo "$n  [$(tier_of "$n")]  ($(ls "$holder/$n" | tr '\n' ' '))"; done
}

btrfs_delete() { holder=$(btrfs_holder); [ -d "$holder/$DELNAME" ] || die "no snapshot $DELNAME"; btrfs_rm "$holder" "$DELNAME"; }

# ---- restore: what Timeshift calls rollback ---------------------------------------------------------------
sub_of() { findmnt -no FSROOT -T "$1" | sed 's|^/||'; }   # mount point -> its subvolume on the device ("@", "@home")

# Rolls the system back to snapshot $RESTORE (a whole set: root, and home with --with-home). For every target:
#   1. a read-only snapshot of what is there now goes into @snapshots as DATE_before-restore  (the way back)
#   2. the live subvolume is renamed to NAME.replaced-DATE  (the running system keeps using it until the reboot)
#   3. a writable copy of the snapshot becomes the new NAME
# Nothing is copied or deleted; if step 3 fails step 2 is undone. Reboot to land in the restored system, and
# `snapshot cleanup` removes the .replaced-* leftovers once you are happy.
btrfs_restore() {
	holder=$TOP/$SNAP_SUBVOL; snap=$holder/$RESTORE
	[ -d "$snap" ] || die "no snapshot $RESTORE"
	# the bootloader has to pick the root subvolume by NAME; by ID it would keep booting the replaced one
	if grep -qE 'subvolid=[0-9]+' /proc/cmdline; then
		die "this system boots by subvolume id (see /proc/cmdline); a rollback would keep booting the old one. Point the bootloader at rootflags=subvol=@ first."
	fi
	plan=
	for t in $TARGETS; do
		[ "$(findmnt -no SOURCE -T "$t" | sed 's/\[.*//')" = "$DEV" ] || continue
		[ -d "$snap/$(tname "$t")" ] || continue
		[ "$t" != "$HOME_TARGET" ] || [ "${WITH_HOME:-0}" = 1 ] || continue   # your files in /home stay as they are unless asked
		sub=$(sub_of "$t"); [ -d "$TOP/$sub" ] || die "no subvolume $sub on the top level for $t"
		plan="$plan $t"
	done
	[ -n "$plan" ] || die "nothing to restore from $RESTORE (a snapshot of /home is only used with --with-home)"
	echo "roll back to $RESTORE:"
	for t in $plan; do echo "  $t   ($(sub_of "$t") is replaced by a copy of $SNAP_SUBVOL/$RESTORE/$(tname "$t"))"; done
	echo "  the current state is kept: snapshot ${SAFE:=$(stamp)_before-restore} and the old subvolume renamed *.replaced-*"
	[ "${YES:-0}" = 1 ] || { printf 'continue? [y/N] '; read -r a </dev/tty; case $a in y|Y|yes|t|T|tak) ;; *) echo cancelled; return 0 ;; esac; }
	mkdir "$holder/$SAFE" || die "cannot create $holder/$SAFE"
	done_t=
	for t in $plan; do
		sub=$(sub_of "$t"); tn=$(tname "$t"); old="$sub.replaced-$(stamp)"
		btrfs subvolume snapshot -r "$TOP/$sub" "$holder/$SAFE/$tn" >/dev/null || die "cannot snapshot the current $sub - nothing changed for $t"
		mv "$TOP/$sub" "$TOP/$old" || die "cannot rename $sub - nothing changed for $t"
		if btrfs subvolume snapshot "$snap/$tn" "$TOP/$sub" >/dev/null; then
			echo "  $sub restored (old one: $old)"; done_t="$done_t $t"
		else
			mv "$TOP/$old" "$TOP/$sub"; die "restoring $sub failed and was undone"
		fi
	done
	echo "done. REBOOT to boot the restored system. Later: ezbacksnap snapshot cleanup  (removes the *.replaced-* leftovers)"
}

# a subvolume left behind by a rollback: NAME.replaced-DATE on the top level
btrfs_cleanup() {
	left=$(for d in "$TOP"/*.replaced-*; do [ -d "$d" ] && basename -- "$d"; done)
	[ -n "$left" ] || { echo "nothing to clean up"; return 0; }
	printf '%s\n' "$left" | sed 's/^/  /'
	[ "${YES:-0}" = 1 ] || { printf 'delete these old subvolumes? [y/N] '; read -r a </dev/tty; case $a in y|Y|yes|t|T|tak) ;; *) echo cancelled; return 0 ;; esac; }
	printf '%s\n' "$left" | while read -r d; do btrfs subvolume delete -R "$TOP/$d" >/dev/null && echo "deleted $d" || echo "could not delete $d" >&2; done
}

# copy one file or directory out of a snapshot: PATH is the live path (/etc/fstab, /home/me/notes.txt)
btrfs_get() {
	holder=$TOP/$SNAP_SUBVOL; t=
	for c in $TARGETS; do   # the target holding PATH: the longest mount point that is a prefix of it
		case $GETPATH in "$c" | "$c"/*) [ "${#c}" -gt "${#t}" ] && t=$c ;; esac
		[ "$c" = / ] && [ -z "$t" ] && t=/
	done
	[ -n "$t" ] || die "$GETPATH is not under any snapshotted target ($TARGETS)"
	rel=${GETPATH#"$t"}; rel=${rel#/}
	src=$holder/$GETNAME/$(tname "$t")/$rel; src=${src%/}
	[ -e "$src" ] || die "$GETPATH is not in snapshot $GETNAME"
	dest=${GETDEST:-$GETPATH}
	if [ -z "$GETDEST" ] && [ -e "$dest" ]; then
		mv -- "$dest" "$dest.before-restore-$(stamp)" || die "cannot move the current $dest aside"
		echo "  the current one is kept as $dest.before-restore-*"
	fi
	[ -d "$dest" ] && [ -n "$GETDEST" ] && dest=$dest/$(basename -- "$GETPATH")
	cp -a --reflink=auto -- "$src" "$dest" && echo "  $GETNAME:$GETPATH -> $dest"
}

btrfs_run() {   # ACTION
	for DEV in $(btrfs_devs); do
		echo "[$DEV]"
		btrfs_with_top "$DEV" "btrfs_$1" || exit 1
	done
}

# ======================= zfs ============================================
zfs_datasets() { for t in $TARGETS; do findmnt -no SOURCE -T "$t"; done | sort -u; }
zfs_names() {  # oldest first
	for ds in $(zfs_datasets); do zfs list -H -t snapshot -o name -s creation -d 1 "$ds" 2>/dev/null; done \
		| sed 's/.*@//' | sort -u | while read -r n; do is_snap_name "$n" && echo "$n"; done
}
zfs_prune() {
	zfs_names | to_remove | while read -r n; do
		echo "removing old snapshot $n"
		for ds in $(zfs_datasets); do zfs destroy -r "$ds@$n" 2>/dev/null; done
	done
}
zfs_run() {
	case $1 in
		create) for ds in $(zfs_datasets); do zfs snapshot -r "$ds@$NAME" || die "zfs snapshot of $ds failed"; echo "  $ds@$NAME"; done; zfs_prune ;;
		list)   zfs_names ;;
		prune)  zfs_prune ;;
		delete) for ds in $(zfs_datasets); do zfs destroy -r "$ds@$DELNAME"; done ;;
	esac
}

# ======================= rsync ==========================================
rsync_create() {
	command -v rsync >/dev/null 2>&1 || die "rsync not found"
	mkdir -p "$RSYNC_DIR" || die "cannot create $RSYNC_DIR"
	prev=$(names_in "$RSYNC_DIR" | tail -n 1)
	tmp="$RSYNC_DIR/.partial-$NAME"
	mkdir "$tmp" || die "cannot create $tmp"
	set -f
	for t in $TARGETS; do
		dest="$tmp/$(tname "$t")"
		set --
		for e in $RSYNC_EXCLUDES "$RSYNC_DIR"; do set -- "$@" --exclude="$e"; done
		[ -n "$prev" ] && [ -d "$RSYNC_DIR/$prev/$(tname "$t")" ] && set -- "$@" --link-dest="$RSYNC_DIR/$prev/$(tname "$t")"
		rsync -aAXH --numeric-ids --one-file-system "$@" "$t"/ "$dest"/ \
			|| { rm -rf "$tmp"; die "rsync of $t failed"; }
		echo "  $t -> $RSYNC_DIR/$NAME/$(tname "$t")"
	done
	set +f
	mv "$tmp" "$RSYNC_DIR/$NAME" || die "cannot finalize $NAME"
	rsync_prune
}
rsync_prune() {
	names_in "$RSYNC_DIR" | to_remove | while read -r n; do
		echo "removing old snapshot $n"; rm -rf -- "${RSYNC_DIR:?}/$n"
	done
}
rsync_run() {
	case $1 in
		create) rsync_create ;;
		list)   [ -d "$RSYNC_DIR" ] && names_in "$RSYNC_DIR" | while read -r n; do echo "$n  ($(ls "$RSYNC_DIR/$n" | tr '\n' ' '))"; done ;;
		prune)  [ -d "$RSYNC_DIR" ] && rsync_prune ;;
		delete) [ -d "$RSYNC_DIR/$DELNAME" ] || die "no snapshot $DELNAME"; rm -rf -- "${RSYNC_DIR:?}/$DELNAME" ;;
	esac
}

snap_main() {
	if [ "$(id -u)" -ne 0 ]; then
		exec sudo env SNAPSHOT_KEEP="${SNAPSHOT_KEEP:-}" SNAPSHOT_TARGETS="${SNAPSHOT_TARGETS:-}" \
			SNAPSHOT_SUBVOL="${SNAPSHOT_SUBVOL:-}" SNAPSHOT_DIR="${SNAPSHOT_DIR:-}" \
			SNAPSHOT_EXCLUDES="${SNAPSHOT_EXCLUDES:-}" SNAPSHOT_BACKEND="${SNAPSHOT_BACKEND:-}" SNAPSHOT_TIERS="${SNAPSHOT_TIERS:-}" SNAPSHOT_HOME="${SNAPSHOT_HOME:-}" "$(cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")" snapshot "$@"
	fi

	KEEP=$SNAPSHOT_KEEP
	case $KEEP in '' | *[!0-9]*) die "SNAPSHOT_KEEP must be a positive number, got '$KEEP'" ;; esac
	[ "$KEEP" -gt 0 ] || die "SNAPSHOT_KEEP must be a positive number, got '$KEEP'"

	cmd=${1:-create}; [ $# -gt 0 ] && shift
	first=${TARGETS%% *}
	[ -d "$first" ] || die "target $first is not a directory"
	BACKEND=${SNAPSHOT_BACKEND:-}
	if [ -z "$BACKEND" ]; then
		case $(stat -f -c %T "$first") in
			btrfs) BACKEND=btrfs ;;
			zfs)   BACKEND=zfs ;;
			*)     BACKEND=rsync ;;
		esac
	fi

	NAME=$(stamp)
	case $cmd in
		create)
			if [ -n "${1:-}" ]; then
				case $1 in *[!A-Za-z0-9._-]*) die "LABEL may only contain letters, digits . _ -" ;; esac
				NAME="${NAME}_$1"
			fi
			echo "snapshot $NAME ($BACKEND, keep $KEEP)"
			action=create ;;
		list)   action=list ;;
		prune)  action=prune ;;
		delete) DELNAME=${1:?usage: snapshot delete NAME}; is_snap_name "$DELNAME" || die "not a snapshot name: $DELNAME"; action=delete ;;
		restore) RESTORE=${1:?usage: snapshot restore NAME [--with-home] [--yes]}; is_snap_name "$RESTORE" || die "not a snapshot name: $RESTORE"; shift
		         for o in "$@"; do case $o in --with-home) WITH_HOME=1 ;; --yes|-y) YES=1 ;; *) die "unknown option $o" ;; esac; done
		         [ "$BACKEND" = btrfs ] || die "restore is for btrfs snapshots; a $BACKEND snapshot is a plain copy - copy files out of it"
		         action=restore ;;
		get)    GETNAME=${1:?usage: snapshot get NAME PATH [DEST]}; GETPATH=${2:?usage: snapshot get NAME PATH [DEST]}; GETDEST=${3:-}
		        is_snap_name "$GETNAME" || die "not a snapshot name: $GETNAME"
		        [ "$BACKEND" = btrfs ] || die "get works on btrfs snapshots"
		        action=get ;;
		cleanup) [ "${1:-}" = --yes ] && YES=1; [ "$BACKEND" = btrfs ] || die "cleanup is for btrfs rollbacks"; action=cleanup ;;
		*) die "usage: snapshot [create [LABEL]|list|prune|delete NAME|restore NAME [--with-home]|get NAME PATH [DEST]|cleanup]" ;;
	esac

	case $BACKEND in
		btrfs) btrfs_run "$action" ;;
		zfs)   zfs_run "$action" ;;
		rsync) rsync_run "$action" ;;
		*)     die "unknown backend $BACKEND" ;;
	esac

}



# ======================= schedule + update hook ==========================
# ezbacksnap timer install [TIER...] | remove [TIER...|all] | status      snapshots on a schedule (systemd timers, cron if no systemd)
# ezbacksnap hook install | remove | status                                a snapshot before every package transaction (pacman, apt)
# Tiers: hourly daily weekly monthly boot. Each snapshot is labelled with its tier and rotated by SNAPSHOT_TIERS.
# Both copy this script to /usr/local/bin/ezbacksnap first, so the units keep working when you move this folder.
ETC=${EZBACKSNAP_ETC:-/etc}                       # only changed by tests
BIN=${EZBACKSNAP_BIN:-/usr/local/bin/ezbacksnap}
ALL_TIERS="hourly daily weekly monthly boot"

sys_root() {
	[ "$(id -u)" -eq 0 ] && return 0
	exec sudo env SNAPSHOT_TARGETS="${SNAPSHOT_TARGETS:-}" SNAPSHOT_KEEP="${SNAPSHOT_KEEP:-}" SNAPSHOT_TIERS="${SNAPSHOT_TIERS:-}" \
		SNAPSHOT_SUBVOL="${SNAPSHOT_SUBVOL:-}" SNAPSHOT_HOME="${SNAPSHOT_HOME:-}" "$(cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")" "$@"
}

install_bin() {
	me=$(cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")
	[ "$me" = "$BIN" ] && return 0
	install -m 755 "$me" "$BIN" || die "cannot install $BIN"
	echo "  installed $BIN"
}

# the settings that differ from the defaults travel with the units
unit_env() {
	# (defaults are left out: the installed copy carries them)
	envdiff() { eval "val=\${$1:-}"; [ -n "$val" ] && [ "$val" != "$2" ] && printf 'Environment="%s=%s"\n' "$1" "$val"; return 0; }
	envdiff SNAPSHOT_TARGETS "/ /home"; envdiff SNAPSHOT_SUBVOL "@snapshots"; envdiff SNAPSHOT_HOME /home; envdiff SNAPSHOT_KEEP 5
	envdiff SNAPSHOT_TIERS "hourly:6 daily:5 weekly:3 monthly:2 boot:5 pre-update:5"
}

tier_calendar() {   # TIER -> cron time
	case $1 in hourly) echo "7 * * * *" ;; daily) echo "30 3 * * *" ;; weekly) echo "40 3 * * 0" ;; monthly) echo "50 3 1 * *" ;; esac
}

timer_install() {
	tiers=${*:-daily weekly monthly boot}
	for t in $tiers; do case " $ALL_TIERS " in *" $t "*) ;; *) die "unknown tier $t (one of: $ALL_TIERS)" ;; esac; done
	install_bin
	if [ -z "${EZBACKSNAP_CRON:-}" ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then   # EZBACKSNAP_CRON=1 forces cron
		for t in $tiers; do
			cat >"$ETC/systemd/system/ezbacksnap-$t.service" <<EOF
[Unit]
Description=ezbacksnap $t snapshot

[Service]
Type=oneshot
$(unit_env)
ExecStart=$BIN snapshot create $t
EOF
			if [ "$t" = boot ]; then when="OnBootSec=2min"; else when="OnCalendar=$t
Persistent=true"; fi
			cat >"$ETC/systemd/system/ezbacksnap-$t.timer" <<EOF
[Unit]
Description=ezbacksnap $t snapshot

[Timer]
$when

[Install]
WantedBy=timers.target
EOF
		done
		systemctl daemon-reload
		for t in $tiers; do systemctl enable --now "ezbacksnap-$t.timer" >/dev/null 2>&1 && echo "  $t: on" || echo "  $t: could not enable" >&2; done
	else
		{
			echo "# ezbacksnap - written by 'ezbacksnap timer install'"
			[ -f $ETC/cron.d/ezbacksnap ] && grep -v -E " snapshot create ($(echo $tiers | tr ' ' '|'))\$" $ETC/cron.d/ezbacksnap | grep -v '^# ezbacksnap'
			for t in $tiers; do
				if [ "$t" = boot ]; then echo "@reboot root sleep 120; $BIN snapshot create boot"; else echo "$(tier_calendar "$t") root $BIN snapshot create $t"; fi
			done
		} >$ETC/cron.d/ezbacksnap.new && mv $ETC/cron.d/ezbacksnap.new $ETC/cron.d/ezbacksnap
		echo "  no systemd: cron entries written to $ETC/cron.d/ezbacksnap"
	fi
}

timer_remove() {
	tiers=${*:-all}; [ "$tiers" = all ] && tiers=$ALL_TIERS
	for t in $tiers; do
		if [ -f "$ETC/systemd/system/ezbacksnap-$t.timer" ]; then
			systemctl disable --now "ezbacksnap-$t.timer" >/dev/null 2>&1
			rm -f "$ETC/systemd/system/ezbacksnap-$t.timer" "$ETC/systemd/system/ezbacksnap-$t.service" && echo "  $t: off"
		fi
	done
	command -v systemctl >/dev/null 2>&1 && systemctl daemon-reload 2>/dev/null
	if [ -f $ETC/cron.d/ezbacksnap ]; then
		for t in $tiers; do grep -v " snapshot create $t\$" $ETC/cron.d/ezbacksnap >$ETC/cron.d/ezbacksnap.new; mv $ETC/cron.d/ezbacksnap.new $ETC/cron.d/ezbacksnap; done
		grep -q ' snapshot create ' $ETC/cron.d/ezbacksnap || rm -f $ETC/cron.d/ezbacksnap
	fi
	return 0
}

timer_status() {
	if command -v systemctl >/dev/null 2>&1 && ls $ETC/systemd/system/ezbacksnap-*.timer >/dev/null 2>&1; then
		systemctl list-timers 'ezbacksnap-*' --no-pager 2>/dev/null
	elif [ -f $ETC/cron.d/ezbacksnap ]; then grep -v '^#' $ETC/cron.d/ezbacksnap
	else echo "no schedule: ezbacksnap timer install [hourly daily weekly monthly boot]"; fi
}

hook_kind() {
	if [ -d "$ETC/pacman.d" ] && command -v pacman >/dev/null 2>&1; then echo pacman
	elif [ -d "$ETC/apt/apt.conf.d" ]; then echo apt
	else echo none; fi
}

hook_install() {
	install_bin
	case $(hook_kind) in
		pacman) mkdir -p $ETC/pacman.d/hooks
			cat >$ETC/pacman.d/hooks/00-ezbacksnap.hook <<EOF
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = ezbacksnap: snapshot before the transaction
When = PreTransaction
Exec = /bin/sh -c '$BIN snapshot create pre-update || true'
EOF
			echo "  pacman hook: $ETC/pacman.d/hooks/00-ezbacksnap.hook" ;;
		apt)    printf 'DPkg::Pre-Invoke { "%s snapshot create pre-update || true"; };\n' "$BIN" >$ETC/apt/apt.conf.d/00ezbacksnap
			echo "  apt hook: $ETC/apt/apt.conf.d/00ezbacksnap" ;;
		*)      die "no pacman or apt found: run '$BIN snapshot create pre-update' yourself before updating" ;;
	esac
}
hook_remove() { rm -f $ETC/pacman.d/hooks/00-ezbacksnap.hook $ETC/apt/apt.conf.d/00ezbacksnap && echo "  hook removed"; }
hook_status() {
	if [ -f $ETC/pacman.d/hooks/00-ezbacksnap.hook ]; then echo "on: $ETC/pacman.d/hooks/00-ezbacksnap.hook"
	elif [ -f $ETC/apt/apt.conf.d/00ezbacksnap ]; then echo "on: $ETC/apt/apt.conf.d/00ezbacksnap"
	else echo "off ($(hook_kind) detected)"; fi
}

sys_main() {   # timer|hook ...
	what=$1; shift
	case $what:${1:-status} in
		timer:status) timer_status ;;
		hook:status)  hook_status ;;
		*) sys_root "$what" "$@" ;;
	esac
	case $what:${1:-status} in
		timer:install) shift; timer_install "$@" ;;
		timer:remove)  shift; timer_remove "$@" ;;
		hook:install)  hook_install ;;
		hook:remove)   hook_remove ;;
		timer:status | hook:status) ;;
		*) die "usage: ezbacksnap $what install|remove|status" ;;
	esac
}

# ======================= entry point ====================================
_have() { command -v "$1" >/dev/null 2>&1; }

menu_backup() {
	SELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")
	while :; do
		act=$(printf '%s\t%s\n' \
			run     "Backup: run a job" \
			newbk   "Backup: back up a directory now..." \
			addjob  "Backup: save a job (a name for SRC -> DEST)" \
			blist   "Backup: list the copies in a destination" \
			restore "Backup: restore from a copy..." \
			bdel    "Backup: delete a copy" \
			bprune  "Backup: prune a destination (keep $BACKUP_KEEP)" \
			rmjob   "Backup: forget a job" \
			| lt_select --nth 2 --header 'directory backups (rsync)' --prompt 'action> ') || return 0
		case $act in
			run)   j=$( { printf '%s\t%s\n' --all "every job"; job_all | awk -F'\t' '{ print $1 "\t" $1 "  " $2 " -> " $3 }'; } | lt_select --nth 2 --header 'run which backup job?') || continue
			       "$SELF" backup run "$j" ;;
			newbk) s=$(lt_input "back up which directory") || continue
			       d=$(lt_input "into which destination directory") || continue
			       [ -n "$s" ] && [ -n "$d" ] || continue
			       "$SELF" backup create "$s" "$d" || continue
			       j=$(lt_input "save it as a job named (empty = do not save)") || continue
			       [ -z "$j" ] || "$SELF" backup add "$j" "$s" "$d" ;;
			addjob) j=$(lt_input "job name") || continue
			        s=$(lt_input "back up which directory") || continue
			        d=$(lt_input "into which destination directory") || continue
			        [ -n "$j" ] && [ -n "$s" ] && [ -n "$d" ] && "$SELF" backup add "$j" "$s" "$d" ;;
			blist | restore | bdel | bprune)
			       d=$(_pick_dest) || continue
			       case $act in
			           blist)  "$SELF" backup list "$d" ;;
			           bprune) lt_confirm "drop the oldest copies in $d beyond $BACKUP_KEEP?" && "$SELF" backup prune "$d" ;;
			           bdel)   n=$(bk_names "$d" | lt_select --header "delete which copy of $d?") || continue
			                   lt_confirm "delete backup $n?" && "$SELF" backup delete "$d" "$n" ;;
			           restore) n=$(bk_names "$d" | sort -r | lt_select --header "restore which copy of $d?") || continue
			                    t=$(lt_input "restore into which directory" "$(job_all | awk -F'\t' -v d="$d" '$3 == d { print $2; exit }')") || continue
			                    [ -n "$t" ] || continue
			                    "$SELF" backup restore "$d" "$n" "$t" --dry-run || continue
			                    lt_confirm "that was a dry run - really restore $n into $t?" && "$SELF" backup restore "$d" "$n" "$t" ;;
			       esac ;;
			rmjob) j=$(job_all | awk -F'\t' '{ print $1 "\t" $1 "  " $2 " -> " $3 }' | lt_select --nth 2 --header 'forget which job?') || continue
			       "$SELF" backup remove "$j" ;;
		esac
		printf '\npress Enter ' >&2; read -r _ </dev/tty || return 0
	done
}


# ---- the menu: what Timeshift does, for btrfs ----
_snap_pick() {   # header -> the chosen snapshot name
	"$SELF" snapshot list 2>/dev/null | awk '/^[0-9]/ { print $1 "\t" $0 }' | lt_select --nth 2 --header "$1" --prompt 'snapshot> '
}

menu() {
	SELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")
	while :; do
		act=$(printf '%s\t%s\n' \
			create  "Create a snapshot now" \
			browse  "Snapshots: roll the system back / delete..." \
			files   "Restore a file or folder from a snapshot..." \
			sched   "Schedule: hourly / daily / weekly / monthly / boot snapshots..." \
			hook    "Snapshot before every update ($("$SELF" hook status 2>/dev/null | cut -d: -f1))" \
			prune   "Prune old snapshots (each label has its own keep count)" \
			cleanup "After a rollback: delete the old system subvolumes" \
			backup  "Advanced: back up a directory with rsync..." \
			| lt_select --nth 2 --header 'ezbacksnap' --prompt 'action> ') || return 0
		case $act in
			create) l=$(lt_input "label (optional, letters digits . _ -)") || continue
			        "$SELF" snapshot create $l ;;
			browse) n=$(_snap_pick "pick a snapshot") || continue
			        a=$(printf '%s\t%s\n' back "back" restore "Roll the system back to it (asks first, then reboot)" \
			                homeback "Roll back the system AND /home (your files go back too)" \
			                file "Restore a file or folder from it..." del "Delete it" \
			            | lt_select --nth 2 --header "$n") || continue
			        case $a in
			            restore)  "$SELF" snapshot restore "$n" ;;
			            homeback) "$SELF" snapshot restore "$n" --with-home ;;
			            file)     p=$(lt_input "path (as it is now, e.g. /etc/fstab or /home/you/notes.txt)") || continue
			                      [ -n "$p" ] && "$SELF" snapshot get "$n" "$p" ;;
			            del)      lt_confirm "delete snapshot $n?" && "$SELF" snapshot delete "$n" ;;
			        esac ;;
			files)  n=$(_snap_pick "restore a file from which snapshot?") || continue
			        p=$(lt_input "path (as it is now, e.g. /etc/fstab or /home/you/notes.txt)") || continue
			        [ -n "$p" ] || continue
			        d=$(lt_input "put it here instead (empty = back where it was; the current one is kept aside)") || continue
			        "$SELF" snapshot get "$n" "$p" $d ;;
			sched)  "$SELF" timer status 2>&1 | head -12
			        t=$(printf '%s\tevery hour\n%s\tevery day\n%s\tevery week\n%s\tevery month\n%s\tat every boot\n%s\tturn every schedule off\n' \
			                hourly daily weekly monthly boot off \
			            | lt_select --mode select --nth 1,2 --header 'schedule: mark what you want (space), Enter to apply' --prompt 'when> ') || continue
			        [ -n "$t" ] || continue
			        case $t in off*) "$SELF" timer remove all ;; *) "$SELF" timer install $t ;; esac ;;
			hook)   if "$SELF" hook status | grep -q '^on'; then lt_confirm "remove the update hook?" && "$SELF" hook remove
			        else lt_confirm "take a snapshot before every package update from now on?" && "$SELF" hook install; fi ;;
			prune)  "$SELF" snapshot prune ;;
			cleanup) "$SELF" snapshot cleanup ;;
			backup) menu_backup; continue ;;
		esac
		printf '\npress Enter ' >&2; read -r _ </dev/tty || return 0
	done
}

# a destination: one of the saved jobs' or typed in
_pick_dest() {
	c=$( { job_all | awk -F'\t' '!seen[$3]++ { print $3 "\t" $3 "  (job " $1 ")" }'; printf '%s\t%s\n' '' 'type a directory...'; } | lt_select --nth 2 --header 'which backup destination?') || return 1
	if [ -z "$c" ]; then c=$(lt_input "destination directory") || return 1; fi
	[ -n "$c" ] || return 1
	printf '%s\n' "$c"
}

case ${1:-} in
	backup)         shift; ( bk_main "$@" ) ;;
	snapshot | snap) shift; snap_main "$@" ;;
	timer | hook)   sys_main "$@" ;;
	"")             menu ;;
	-h | --help)    sed -n '2,/^# <\/manwriter>/p' "$0" | sed 's/^# \{0,1\}//; /manwriter>/d' ;;
	*)              die "usage: ezbacksnap backup SRC DEST | snapshot [create [LABEL]|list|prune|delete NAME]" ;;
esac
