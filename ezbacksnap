BACKUP_KEEP="${BACKUP_KEEP:-5}"               # backups kept per destination

SNAPSHOT_KEEP="${SNAPSHOT_KEEP:-5}"                    # how many snapshots to keep (manual ones, and any label not listed below)
HOME_TARGET="${SNAPSHOT_HOME:-/home}"             # the target a rollback leaves alone unless --with-home
SNAPSHOT_TIERS="${SNAPSHOT_TIERS:-hourly:6 daily:5 weekly:3 monthly:2 boot:5 pre-update:5}"   # LABEL:KEEP - each label is rotated on its own, like Timeshift
TARGETS="${SNAPSHOT_TARGETS:-/ /home}"        # mount points to snapshot
SNAP_SUBVOL="${SNAPSHOT_SUBVOL:-@snapshots}"  # btrfs: subvolume that holds them
RSYNC_DIR="${SNAPSHOT_DIR:-/var/snapshots}"   # rsync backend: where copies go
RSYNC_EXCLUDES="${SNAPSHOT_EXCLUDES:-/tmp/* /var/tmp/* /var/cache/* /proc/* /sys/* /dev/* /run/* /mnt/* /media/* /lost+found}"
