# Copy this to .env (gitignored) and fill in real values, or just export
# these in your shell - the tools read them from the environment either
# way, .env isn't auto-loaded by anything here.

# gitgrab - GitHub (raw file download). Public API works without it; needed for private
# repos or to avoid rate limits.
GH_TOKEN=

# ezhf - Hugging Face Hub. Needed for private/gated repos.
HF_TOKEN=
