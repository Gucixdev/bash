#!/bin/sh
# flatseal - terminal manager for Flatpak apps and their permissions, in
# one tool, built on lib/lazytui.sh. It wraps the real flatpak, which it
# finds in PATH skipping itself.
#
#   flatseal [apps | perms APP | global | audit | who KEY | APP-ID]
#   flatseal allow|deny|default APP KEY...     scripting, no UI
#   flatseal show APP|@global [modified]       the effective permissions as text
#   flatseal export [FILE] | import FILE       copy your overrides out / back in

case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac

