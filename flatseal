# catalog | _gate: drops what the installed flatpak is too old to know (Flatseal does the same)
_gate() {
	_cur=$("$FP" --version 2>/dev/null | sed 's/[^0-9.]//g'); [ -n "$_cur" ] || _cur=99
	while IFS='	' read -r _k _d _min; do
		if [ -z "$_min" ] || [ "$(printf '%s\n%s\n' "$_min" "$_cur" | sort -V | head -n 1)" = "$_min" ]; then
			printf '%s\t%s\n' "$_k" "$_d"
		fi
	done
}

# Portal permissions (what Flatseal shows under "Portals"): they live in the xdg-desktop-portal permission store,
# not in the override files, and are read and written with `flatpak permissions` / permission-set / permission-remove.
# Unlike Flatseal this also works before the portal has stored anything for the app (it creates the entry).
# KEY <TAB> description <TAB> table <TAB> id <TAB> allow values <TAB> deny values
_portals() {
	cat <<'EOF'
portal=background/background	background: keep running without a window	background	background	yes	no
portal=notifications/notification	notifications (portal)	notifications	notification	yes	no
portal=devices/microphone	microphone (portal)	devices	microphone	yes	no
portal=devices/speakers	speakers (portal)	devices	speakers	yes	no
portal=devices/camera	camera (portal)	devices	camera	yes	no
portal=location/location	location (portal)	location	location	EXACT 0	NONE 0
EOF
}

# _portal_rows APP -> table rows for the portal permissions (nothing when the permission store is not running)
_portal_rows() {
	[ -z "${EZFP_NOPORTAL:-}" ] || return 0
	flatpak permissions >/dev/null 2>&1 || return 0
	_portals | while IFS='	' read -r key desc table id allow _; do
		cur=$(flatpak permissions "$table" 2>/dev/null | awk -F'\t' -v id="$id" -v app="$1" '$2 == id && $3 == app { print $4; exit }')
		if [ -z "$cur" ]; then printf '%s\toff\t0\t%s (not set: the app is asked)\n' "$key" "$desc"
		elif [ "${cur%%,*}" = "${allow%% *}" ]; then printf '%s\ton\t2\t%s\n' "$key" "$desc"
		else printf '%s\toff\t2\t%s\n' "$key" "$desc"; fi
	done
}

# _portal_set allow|deny|drop APP KEY
_portal_set() {
	set -- "$1" "$2" "$(_portals | awk -F'\t' -v k="$3" '$1 == k')"
	[ -n "$3" ] || return 1
	IFS='	' read -r _k _d _t _i _al _de <<EOF
$3
EOF
	case $1 in
		allow) flatpak permission-set "$_t" "$_i" "$2" $_al ;;
		deny)  flatpak permission-set "$_t" "$_i" "$2" $_de ;;
		drop)  flatpak permission-remove "$_t" "$_i" "$2" ;;
	esac
}

# _table APP -> KEY<TAB>on|off<TAB>0|1|2<TAB>description: the effective
# permissions, layered like flatpak does it - the app's manifest, then your
# global overrides, then your overrides for the app. Column 3 says which
# layer set it last: 0 manifest/default, 1 global, 2 the app itself. APP
# @global shows just the global layer (as layer 2).
_table() {
	{
		catalog | _gate | sed 's/^/C\t/'
		if [ "$1" = @global ]; then
			flatpak override --user --show 2>/dev/null | sed 's/^/O\t/'
		else
			flatpak info --show-metadata "$1" 2>/dev/null | sed 's/^/B\t/'
			flatpak override --user --show 2>/dev/null | sed 's/^/G\t/'
			flatpak override --user --show "$1" 2>/dev/null | sed 's/^/O\t/'
		fi
	} | awk -F'\t' '
	function note(key, desc) { if (!(key in seen)) { seen[key] = 1; order[++n] = key } if (desc != "") d[key] = desc }
	function set(src, key, on, desc) {
		note(key, desc)
		st[key] = on
		if (src == "G") gv[key] = 1
		else if (src == "O") ov[key] = 1
	}
	function kind(k) {
		if (k == "sockets") return "socket"; if (k == "shared") return "share"
		if (k == "devices") return "device"; if (k == "features") return "feature"
		if (k == "filesystems") return "filesystem"; if (k == "persistent") return "persist"
		return ""
	}
	function bus(sec, pol) {
		p = (sec ~ /^System/) ? "system-" : ""
		if (pol == "own") return p "own-name"
		if (pol == "see") return p "see-name"
		return p "talk-name"
	}
	$1 == "C" { note($2, $3); if (!($2 in st)) st[$2] = "off"; next }
	{
		line = $2
		if (line ~ /^\[/) { sec = substr(line, 2, length(line) - 2); next }
		i = index(line, "="); if (i == 0) next
		k = substr(line, 1, i - 1); v = substr(line, i + 1); src = $1
		if (sec == "Context") {
			kd = kind(k); if (kd == "") next
			m = split(v, t, ";")
			for (j = 1; j <= m; j++) {
				if (t[j] == "") continue
				neg = (substr(t[j], 1, 1) == "!"); val = neg ? substr(t[j], 2) : t[j]
				set(src, kd "=" val, neg ? "off" : "on", (src == "B") ? "(app)" : (src == "G") ? "(global)" : "(override)")
			}
		} else if (sec ~ /Bus Policy$/) {
			if (v == "none") { key = bus(sec, "talk") "=" k; set(src, key, "off", (src == "G") ? "(global)" : "(override)") }
			else { key = bus(sec, v) "=" k; set(src, key, "on", (src == "B") ? "(app)" : (src == "G") ? "(global)" : "(override)") }
		} else if (sec == "Environment") {
			key = "env=" k
			set(src, key, (v == "" && src == "O") ? "off" : "on", "= " v)
		}
	}
	END { for (i = 1; i <= n; i++) { k = order[i]; printf "%s\t%s\t%d\t%s\n", k, (k in st) ? st[k] : "off", (k in ov) ? 2 : (k in gv) ? 1 : 0, d[k] } }'
	[ "$1" = @global ] || _portal_rows "$1"
}

# _rows APP [only] -> KEY<TAB>display for fzf: coloured state, layer marker
# (* = this app's override, g = a global override), key, description.
# "only" lists just what is overridden.
_rows() {
	_table "$1" | while IFS='	' read -r key st ov desc; do
		[ "${2:-}" = only ] && [ "$ov" = 0 ] && continue
		if [ "$st" = on ]; then s=$(printf '\033[32m on\033[0m'); else s=$(printf '\033[31moff\033[0m'); fi
		case $ov in 2) mark='*' ;; 1) mark=g ;; *) mark=' ' ;; esac
		case $desc in *broad*) [ "$st" = on ] && desc=$(printf '\033[1;31m%s\033[0m' "$desc") ;; esac
		printf '%s\t%s%s %-40s %s\n' "$key" "$s" "$mark" "$key" "$desc"
	done
}

# Every change first saves the layer it is about to change, so ^Z reset,
# drop and mistakes can be taken back with Alt-Z (undo).
_odir() { echo "${FLATPAK_USER_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/flatpak}/overrides"; }
_ofile() { if [ "$1" = @global ]; then echo "$(_odir)/global"; else echo "$(_odir)/$1"; fi; }
_bdir() { echo "${XDG_STATE_HOME:-$HOME/.local/state}/flatpak-tui/backups/$(printf %s "$1" | tr -c 'A-Za-z0-9._-' _)"; }
_backup() {
	d=$(_bdir "$1"); mkdir -p "$d" || return 0
	if [ "$1" = @global ]; then cur=$(flatpak override --user --show 2>/dev/null); else cur=$(flatpak override --user --show "$1" 2>/dev/null); fi
	[ -n "$cur" ] || return 0
	last=$(ls -1 "$d" 2>/dev/null | tail -n 1)
	[ -n "$last" ] && [ "$(cat "$d/$last")" = "$cur" ] && return 0
	printf '%s\n' "$cur" >"$d/$(date +%Y%m%d_%H%M%S_%N)"
	ls -1 "$d" | head -n -20 | while read -r old; do rm -f "$d/$old"; done
}
_undo() {
	d=$(_bdir "$1"); last=$(ls -1 "$d" 2>/dev/null | tail -n 1)
	[ -n "$last" ] || { echo "flatseal: nothing to undo for $1" >&2; printf 'press Enter ' >&2; read -r _ </dev/tty; return 0; }
	f=$(_ofile "$1"); mkdir -p "$(dirname "$f")"
	cp "$d/$last" "$f.tmp.$$" && mv "$f.tmp.$$" "$f" && rm -f "$d/$last"
	echo "restored the overrides of $1 from $last"
}

# _ov APP OPTION... -> flatpak override --user for one app, or globally for @global
_ov() {
	_a=$1; shift
	_backup "$_a"
	if [ "$_a" = @global ]; then flatpak override --user "$@"; else flatpak override --user "$@" "$_a"; fi
}

# _opts VERB KEY -> the flatpak override option that allows/denies KEY
_opts() {
	kind=${2%%=*}; val=${2#*=}
	if [ "$1" = allow ]; then
		case $kind in
			feature) printf -- '--allow=%s' "$val" ;;
			persist) printf -- '--persist=%s' "$val" ;;
			env)     printf -- '--env=%s=%s' "$val" "${ENVVAL:-1}" ;;
			*)       printf -- '--%s=%s' "$kind" "$val" ;;
		esac
	else
		case $kind in
			share)              printf -- '--unshare=%s' "$val" ;;
			feature)            printf -- '--disallow=%s' "$val" ;;
			env)                printf -- '--unset-env=%s' "$val" ;;
			talk-name)          printf -- '--no-talk-name=%s' "$val" ;;
			system-talk-name)   printf -- '--system-no-talk-name=%s' "$val" ;;
			own-name | system-own-name | see-name | system-see-name | persist)
				echo "flatseal: $kind can't be denied one by one - use ^U to drop its override or ^Z to reset" >&2
				return 1 ;;
			*)                  printf -- '--no%s=%s' "$kind" "$val" ;;
		esac
	fi
}

# _apply VERB APP KEY... -> one flatpak override call per key
_apply() {
	verb=$1; app=$2; shift 2
	for key in "$@"; do
		case $key in portal=*) _portal_set "$verb" "$app" "$key" || echo "flatseal: failed for $key" >&2; continue ;; esac
		opt=$(_opts "$verb" "$key") || continue
		_ov "$app" "$opt" || echo "flatseal: failed for $key" >&2
	done
}

# _drop APP KEY... -> remove the keys from the user override file, so the
# app's own default applies again
_drop() {
	app=$1; shift
	_backup "$app"
	f="${FLATPAK_USER_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/flatpak}/overrides/$app"
	[ "$app" = @global ] && f="${f%/@global}/global"
	[ -f "$f" ] || return 0
	tmp=$(mktemp) || return 1
	awk -v keys="$(printf '%s\n' "$@")" '
	BEGIN { n = split(keys, kk, "\n"); for (i = 1; i <= n; i++) drop[kk[i]] = 1 }
	function ctx(k) {
		if (k == "sockets") return "socket"; if (k == "shared") return "share"
		if (k == "devices") return "device"; if (k == "features") return "feature"
		if (k == "filesystems") return "filesystem"; if (k == "persistent") return "persist"
		return ""
	}
	function busk(sec, pol) { p = (sec ~ /^System/) ? "system-" : ""; return p ((pol == "own") ? "own-name" : (pol == "see") ? "see-name" : "talk-name") }
	/^\[/ { sec = substr($0, 2, length($0) - 2); print; next }
	{
		i = index($0, "="); if (i == 0) { print; next }
		k = substr($0, 1, i - 1); v = substr($0, i + 1)
		if (sec == "Context" && ctx(k) != "") {
			m = split(v, t, ";"); out = ""
			for (j = 1; j <= m; j++) {
				if (t[j] == "") continue
				val = (substr(t[j], 1, 1) == "!") ? substr(t[j], 2) : t[j]
				if (!((ctx(k) "=" val) in drop)) out = out t[j] ";"
			}
			if (out != "") print k "=" out
		} else if (sec ~ /Bus Policy$/) {
			if (!((busk(sec, v) "=" k) in drop) && !((busk(sec, "talk") "=" k) in drop)) print
		} else if (sec == "Environment") {
			if (!(("env=" k) in drop)) print
		} else print
	}' "$f" >"$tmp" && cat "$tmp" >"$f"
	rm -f "$tmp"
}

# ---- across all apps (Flatseal shows one app at a time) -------------------------------------------------
# _audit_rows -> score TAB app TAB name TAB what is broad, riskiest first. The score adds up the broad
# permissions an app has in effect (manifest + global + own overrides).
_audit_rows() {
	flatpak list --app --columns=application,name | while IFS='	' read -r app name; do
		EZFP_NOPORTAL=1 _table "$app" | awk -F'\t' -v app="$app" -v name="$name" '
		BEGIN {
			w["filesystem=host"] = 10;                  l["filesystem=host"] = "whole filesystem"
			w["talk-name=org.freedesktop.Flatpak"] = 10; l["talk-name=org.freedesktop.Flatpak"] = "sandbox escape"
			w["socket=session-bus"] = 8;                l["socket=session-bus"] = "session bus"
			w["socket=system-bus"] = 8;                 l["socket=system-bus"] = "system bus"
			w["device=all"] = 6;                        l["device=all"] = "all devices"
			w["filesystem=home"] = 5;                   l["filesystem=home"] = "home"
			w["filesystem=host-os"] = 5;                l["filesystem=host-os"] = "host os"
			w["filesystem=host-etc"] = 4;               l["filesystem=host-etc"] = "host etc"
			w["socket=ssh-auth"] = 4;                   l["socket=ssh-auth"] = "ssh agent"
			w["socket=gpg-agent"] = 3;                  l["socket=gpg-agent"] = "gpg agent"
			w["feature=devel"] = 3;                     l["feature=devel"] = "ptrace"
			w["socket=x11"] = 2;                        l["socket=x11"] = "x11"
		}
		$2 == "on" {
			k = $1
			if (k in w) { score += w[k]; list = list (list == "" ? "" : ", ") l[k] }
			else if (k ~ /^filesystem=/ && k !~ /^filesystem=xdg-/) { paths++; score += 2 }
		}
		END {
			if (paths) list = list (list == "" ? "" : ", ") paths " extra path" (paths > 1 ? "s" : "")
			printf "%d\t%s\t%s\t%s\n", score, app, name, list
		}'
	done | sort -t "$(printf '\t')" -k1,1nr -k3,3
}

# _audit_view -> rows for the picker: APP TAB coloured line
_audit_view() {
	_audit_rows | while IFS='	' read -r score app name list; do
		if [ "$score" -ge 15 ]; then c='1;31'; elif [ "$score" -ge 6 ]; then c='33'; else c='32'; fi
		printf '%s\t\033[%sm%3d\033[0m  %-30s %s\n' "$app" "$c" "$score" "$name" "$list"
	done
}

# _who_rows KEY -> the apps that have KEY in effect, and on which layer it was set
_who_rows() {
	flatpak list --app --columns=application,name | while IFS='	' read -r app name; do
		EZFP_NOPORTAL=1 _table "$app" | awk -F'\t' -v k="$1" -v app="$app" -v name="$name" \
			'$1 == k && $2 == "on" { printf "%s\t%-30s %s\n", app, name, ($3 == 2 ? "(its own override)" : $3 == 1 ? "(global override)" : "(manifest)") }'
	done
}

case ${1:-} in
	# scripting: flatseal allow|deny|default APP KEY...   flatseal show APP [modified]
	allow | deny)
		verb=$1; app=${2:-}
		[ -n "$app" ] && [ $# -ge 3 ] || { echo "usage: flatseal $verb APP KEY...   (KEY like share=network, filesystem=home, portal=notifications/notification)" >&2; exit 2; }
		shift 2; _apply "$verb" "$app" "$@"; exit 0 ;;
	default)
		app=${2:-}; [ -n "$app" ] && [ $# -ge 3 ] || { echo "usage: flatseal default APP KEY...   (drops your override)" >&2; exit 2; }
		shift; exec "$SELF" _drop "$@" ;;
	show)
		app=${2:-}; [ -n "$app" ] || { echo "usage: flatseal show APP|@global [modified]" >&2; exit 2; }
		_table "$app" | awk -F'\t' -v only="${3:-}" '
			only == "modified" && $3 == 0 { next }
			{ printf "%-3s %s %-46s %s\n", $2, ($3 == 2 ? "*" : $3 == 1 ? "g" : " "), $1, $4 }'
		exit 0 ;;
	# a copy of every override you set (they are plain files), and the way back
	export)
		out=${2:-flatseal-overrides-$(date +%Y%m%d).tar}
		tar -cf "$out" -C "$(_odir)/.." overrides && echo "wrote $out"; exit 0 ;;
	import)
		in=${2:-}; [ -f "$in" ] || { echo "usage: flatseal import FILE   (a file made by flatseal export)" >&2; exit 2; }
		lt_confirm "replace ALL your overrides with the ones in $in? (a backup tar is written first)" || exit 0
		bak=flatseal-overrides-before-import-$(date +%Y%m%d%H%M%S).tar
		tar -cf "$bak" -C "$(_odir)/.." overrides 2>/dev/null && echo "backup: $bak"
		tar -xf "$in" -C "$(_odir)/.." && echo "imported $in"; exit 0 ;;
	# run the app once with the marked rows flipped, nothing is saved
	_try)
		app=$2; shift 2; _n=$#
		while [ "$_n" -gt 0 ]; do
			_k=$1; shift; _n=$((_n - 1))
			case $_k in portal=*) continue ;; esac
			_cur=$(_table "$app" | awk -F'\t' -v k="$_k" '$1 == k { print $2 }')
			if [ "$_cur" = on ]; then _v=deny; else _v=allow; fi
			_o=$(_opts "$_v" "$_k") || continue
			set -- "$@" "$_o"
		done
		[ $# -gt 0 ] || { printf 'nothing to flip. press Enter ' >&2; read -r _ </dev/tty; exit 0; }
		echo "running $app once with: $*   (not saved)"
		setsid -f "$FP" run "$@" "$app" </dev/null >/dev/null 2>&1
		sleep 1; exit 0 ;;
	# change one permission for every marked app at once
	_bulk)
		[ $# -gt 1 ] || { printf 'mark apps with Space first. press Enter ' >&2; read -r _ </dev/tty; exit 0; }
		shift
		_v=$(printf '%s\n' allow deny default | lt_select --header "$# app(s): what to do" --prompt 'do> ') || exit 0
		_k=$(catalog | _gate | lt_select --header "$_v for $# app(s)" --prompt 'permission> ' --nth 1,2) || exit 0
		_k=${_k%%	*}
		lt_confirm "$_v $_k for $# app(s)?" || exit 0
		for _a in "$@"; do
			if [ "$_v" = default ]; then "$SELF" _drop "$_a" "$_k"; else _apply "$_v" "$_a" "$_k"; fi
		done
		exit 0 ;;
	_audit) _audit_view; exit 0 ;;
	_who)   shift; _who_rows "$1"; exit 0 ;;
	_whopick)
		key=$(catalog | _gate | lt_select --header 'which apps have ...' --prompt 'permission> ' --nth 1,2) || exit 0
		exec "$SELF" who "$key" ;;
	_rows)   shift; _rows "$@"; exit 0 ;;
	# first row = the global layer ("All applications", like Flatseal), then every installed app
	_approws) printf '@global\tAll applications\t(global overrides)\t\n'
		flatpak list --app --columns=application,name,version,origin; exit 0 ;;
	_preview) shift
		if [ "$1" = @global ]; then
			printf 'All applications\n\nGlobal overrides apply to every app; an app can still override them\nfor itself. Enter opens them.\n\nCurrent global overrides:\n\n'
			flatpak override --user --show 2>/dev/null
		else flatpak info "$1"; fi
		exit 0 ;;
	_table)  shift; _table "$@"; exit 0 ;;
	_allow | _deny) verb=${1#_}; shift; _apply "$verb" "$@"; exit 0 ;;
	_toggle)
		app=$2; shift 2
		for key in "$@"; do
			cur=$(_table "$app" | awk -F'\t' -v k="$key" '$1 == k { print $2 }')
			if [ "$cur" = on ]; then _apply deny "$app" "$key"; else _apply allow "$app" "$key"; fi
		done
		exit 0 ;;
	_drop)   shift; _dapp=$1; shift
		# portal keys are removed from the permission store, the rest is edited in the override file
		_n=$#
		while [ "$_n" -gt 0 ]; do
			_k=$1; shift; _n=$((_n - 1))
			case $_k in portal=*) _portal_set drop "$_dapp" "$_k" ;; *) set -- "$@" "$_k" ;; esac
		done
		[ $# -eq 0 ] || _drop "$_dapp" "$@"
		exit 0 ;;
	_undo)   _undo "$2"; exit 0 ;;
	_add)
		app=$2
		kind=$(printf '%s\n' filesystem env talk-name own-name system-talk-name persist socket device share feature \
			| lt_select --header "add to $app" --prompt 'kind> ') || exit 0
		case $kind in
			filesystem) hint='path, e.g. ~/Games, /mnt/data, xdg-download, home:ro' ;;
			env)        hint='variable name' ;;
			*-name)     hint='bus name, e.g. org.freedesktop.Flatpak' ;;
			persist)    hint='dir under home, e.g. .mozilla' ;;
			*)          hint='name' ;;
		esac
		val=$(lt_input "$kind ($hint)") || exit 0
		[ -n "$val" ] || exit 0
		if [ "$kind" = env ]; then ENVVAL=$(lt_input "value of $val") || exit 0; export ENVVAL; fi
		_apply allow "$app" "$kind=$val"
		exit 0 ;;
	_reset)
		app=$2
		lt_confirm "reset ALL overrides of $app?" && _ov "$app" --reset
		exit 0 ;;
esac


view=${1:-apps}
mode=${2:-}
case $view in
	apps)
		LT_KEYS="enter:  >$SELF perms      # Permissions
alt-g:  >$SELF global             # Global
alt-a:  >$SELF audit              # Audit
alt-p:  !$SELF _bulk              # Permission for marked apps
alt-r:  >sh -c 'exec \"$FP\" run \"\$1\"' _   # Run
ctrl-u: !$FP update               # Update
ctrl-a: !sh -c '$FP update'       # Update all
ctrl-d: !$FP uninstall            # Uninstall
ctrl-r: refresh                   # Refresh"
		export LT_KEYS
		lt_select --mode select --refresh "$REFRESH_MS" --header 'Flatpak apps' --prompt 'search> ' --nth 2,3,4 \
			--seed "$SELF _approws" --preview "$SELF _preview" --keys - >/dev/null || true
		exit 0 ;;
	audit)
		if [ "${2:-}" = --plain ]; then _audit_rows | awk -F'\t' '{ printf "%3d  %-42s %-28s %s\n", $1, $2, $3, $4 }'; exit 0; fi
		LT_KEYS="enter:  >$SELF perms      # Permissions
ctrl-w: >$SELF _whopick          # Who has ...
ctrl-r: refresh                   # Refresh
alt-b:  >$SELF apps               # Apps"
		export LT_KEYS
		lt_select --refresh 0 --header 'audit: risk score of every app (red >=15, yellow >=6); broad = whole filesystem/home, buses, all devices, ...' \
			--prompt 'search> ' --nth 2 --seed "$SELF _audit" --keys - >/dev/null || true
		exit 0 ;;
	who)
		key=${2:-}; [ -n "$key" ] || { echo "usage: flatseal who KEY   (e.g. share=network, filesystem=home)" >&2; exit 2; }
		if [ "${3:-}" = --plain ]; then _who_rows "$key" | cut -f2-; exit 0; fi
		LT_KEYS="enter:  >$SELF perms      # Permissions
alt-b:  >$SELF audit              # Audit"
		export LT_KEYS
		lt_select --refresh 0 --header "apps that have $key" --prompt 'search> ' --nth 2 \
			--seed "$SELF _who $key" --keys - >/dev/null || true
		exit 0 ;;
	perms) app=${2:-}; mode=${3:-}
		[ -n "$app" ] || { echo "usage: flatseal perms APP-ID" >&2; exit 2; } ;;
	global) app=@global; mode=${2:-} ;;
	*.*)    app=$view; mode=${2:-} ;;
	*)      echo "usage: flatseal [apps | perms APP | global | audit [--plain] | who KEY [--plain] | APP-ID]" >&2; exit 2 ;;
esac

case $mode in only) other=all; mlabel='Show all' ;; *) other=only; mlabel='Only modified' ;; esac
[ "$app" = @global ] && title='all applications (global overrides)' || title=$app
LT_KEYS="enter:  !$SELF _toggle $app   # Toggle
ctrl-g: !$SELF _allow $app     # Allow
ctrl-x: !$SELF _deny $app      # Deny
ctrl-u: !$SELF _drop $app      # Default
ctrl-n: !$SELF _add $app       # Add
ctrl-z: !$SELF _reset $app     # Reset all
alt-t:  !$SELF _try $app       # Try once (not saved)
alt-z:  !$SELF _undo $app      # Undo
---
alt-m:  >$SELF $( [ "$app" = @global ] && echo global || echo perms $app ) $other   # $mlabel
alt-g:  >$SELF global          # Global layer
alt-b:  >$SELF apps            # Apps"
export LT_KEYS
lt_select --mode select --refresh "$REFRESH_MS" --header "permissions: $title   (on/off = effective, * this layer, g global)" \
	--prompt 'search> ' --nth 2 --seed "$SELF _rows $app $mode" --keys - >/dev/null || true
