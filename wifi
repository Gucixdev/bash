#!/usr/bin/env bash
# wifi - Wi-Fi picker over the Linux Wi-Fi backends, first one that is
# running wins: NetworkManager (nmcli), then iwd (iwctl), then bare
# wpa_supplicant (wpa_cli).
#
# Each path lets its own tool handle the password (nmcli --ask, iwd's
# prompt) except wpa_cli, which has no prompt of its own, so the password
# is read here without echo. The NetworkManager list is a fzf picker from
# lib/lazytui (numbered prompt when fzf is missing).
#
# Needs an interactive terminal.
#
# Verification note: the iwctl and wpa_cli paths follow those tools'
# documented command syntax and were not run against a live setup; the
# nmcli path was checked for syntax only (nmcli is not installed on the
# machine it was written on).
# shellcheck disable=SC1007  # a= b= sets several variables to empty on purpose

case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac

# real, backend-agnostic device detection (sysfs, not any particular
# manager) - a directory named "wireless" under a real net interface
# means it's a real wifi device, regardless of who's managing it.
# >>> lazytui (copy of lib/lazytui) >>>
# _lt_hint KEYNAME LABEL -> key caps then LABEL (the nnn hint-bar look). KEYNAME is an fzf key
# (ctrl-r, alt-enter, ctrl-alt-x, shift-up, f5, space...). Every modifier gets its own coloured cap
# (Ctrl blue, Alt yellow, Shift green), the key itself is a reverse-video cap.
_lt_hint() {
	_lt_h=$1
	while :; do
		case $_lt_h in
			ctrl-?*)  printf '\033[30;44m Ctrl \033[0m'; _lt_h=${_lt_h#ctrl-} ;;
			alt-?*)   printf '\033[30;43m Alt \033[0m'; _lt_h=${_lt_h#alt-} ;;
			shift-?*) printf '\033[30;42m Shift \033[0m'; _lt_h=${_lt_h#shift-} ;;
			*) break ;;
		esac
	done
	case $_lt_h in
		?) _lt_h=$(printf %s "$_lt_h" | tr '[:lower:]' '[:upper:]') ;;
		enter) _lt_h=Enter ;; esc) _lt_h=Esc ;; tab) _lt_h=Tab ;; btab) _lt_h='Shift+Tab' ;; space) _lt_h=Space ;;
		bspace) _lt_h=Backspace ;; pgup) _lt_h=PgUp ;; pgdn) _lt_h=PgDn ;; del) _lt_h=Del ;;
		up) _lt_h='↑' ;; down) _lt_h='↓' ;; left) _lt_h='←' ;; right) _lt_h='→' ;;
	esac
	printf '\033[7m %s \033[0m %s   ' "$_lt_h" "$2"
}

# _lt_trim STR -> STR without leading/trailing blanks
_lt_trim() { printf %s "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

# _lt_script FILE CMD -> FILE runs CMD "$@" (keeps quoting out of fzf binds)
_lt_script() { printf '%s "$@"\n' "$2" >"$1"; }

lt_select() {
	_lt_mode=raw _lt_refresh=${LT_REFRESH:-0} _lt_seed= _lt_more= _lt_reload= _lt_preview= _lt_keys= \
	_lt_key=1 _lt_nth= _lt_header= _lt_prompt='> '
	while [ $# -gt 0 ]; do
		case $1 in
			--mode)    _lt_mode=$2;    shift 2 ;;
			--seed)    _lt_seed=$2;    shift 2 ;;
			--more)    _lt_more=$2;    shift 2 ;;
			--refresh) _lt_refresh=$2; shift 2 ;;
			--reload)  _lt_reload=$2;  shift 2 ;;
			--preview) _lt_preview=$2; shift 2 ;;
			--keys)    _lt_keys=$2;    shift 2 ;;
			--key)     _lt_key=$2;     shift 2 ;;
			--nth)     _lt_nth=$2;     shift 2 ;;
			--header)  _lt_header=$2;  shift 2 ;;
			--prompt)  _lt_prompt=$2;  shift 2 ;;
			*) echo "lt_select: unknown arg $1" >&2; return 2 ;;
		esac
	done
	case $_lt_refresh in '' | *[!0-9]*) echo "lt_select: --refresh wants milliseconds, got '$_lt_refresh'" >&2; return 2 ;; esac
	case $_lt_mode in raw | select) ;; *) echo "lt_select: --mode must be raw or select" >&2; return 2 ;; esac

	_lt_tmp=$(mktemp -d) || return 1
	if [ -n "$_lt_seed" ]; then
		_lt_script "$_lt_tmp/seed.sh" "$_lt_seed"
	else
		cat >"$_lt_tmp/list"
		printf 'cat "%s/list"\n' "$_lt_tmp" >"$_lt_tmp/seed.sh"
	fi

	if ! command -v fzf >/dev/null 2>&1; then
		_lt_fallback; _lt_rc=$?
		rm -rf "$_lt_tmp"; return $_lt_rc
	fi
	# what this fzf can do: the C fzf the menus were built with takes a label on each bind and draws the
	# key bar itself (--hints); upstream fzf needs 0.63 for the footer bar, 0.71 to keep the cursor on its
	# row across refreshes. An older one gets the numbered list.
	_lt_hints= _lt_fzfv=$(fzf --version 2>/dev/null)
	case $_lt_fzfv in *-c\ * | *-c) _lt_hints=1 ;; esac
	_lt_minor=$(printf '%s\n' "$_lt_fzfv" | sed -n 's/^0\.\([0-9][0-9]*\).*/\1/p')
	[ -n "$_lt_minor" ] || _lt_minor=999
	if [ -z "$_lt_hints" ] && [ "$_lt_minor" -lt 63 ]; then
		echo "lt_select: fzf ${_lt_fzfv%% *} is too old for these menus (0.63 or newer), here is a numbered list" >&2
		_lt_fallback; _lt_rc=$?
		rm -rf "$_lt_tmp"; return $_lt_rc
	fi

	TAB=$(printf '\t')
	_lt_k="{+$_lt_key}"
	set -- --delimiter="$TAB" --ansi --prompt="$_lt_prompt" --footer-border=none --layout=reverse-list
	[ -n "$_lt_header" ] && set -- "$@" --header="$_lt_header"
	[ -n "$_lt_nth" ] && set -- "$@" --with-nth="$_lt_nth"
	if [ -n "$_lt_preview" ]; then
		_lt_script "$_lt_tmp/preview.sh" "$_lt_preview"
		set -- "$@" --preview="sh $_lt_tmp/preview.sh {$_lt_key}" \
			--preview-window="${LT_PREVIEW_WINDOW:-down,60%,wrap}"
	fi
	_lt_start=
	if [ -n "$_lt_more" ]; then
		cat >"$_lt_tmp/more.sh" <<EOF
out=\$(mktemp)
$_lt_more > "\$out" 2>/dev/null || true
if [ -s "\$out" ]; then
	curl -s -XPOST "127.0.0.1:\$1" --data "reload(cat \$out; rm -f \$out)" >/dev/null 2>&1 || rm -f "\$out"
else rm -f "\$out"; fi
EOF
		_lt_start="$_lt_start sh $_lt_tmp/more.sh \$FZF_PORT &"
	fi
	if [ "$_lt_refresh" -gt 0 ] && [ -z "$_lt_reload" ] && command -v curl >/dev/null 2>&1; then
		# background loop: run the seed, post it to fzf only when it changed;
		# it ends by itself once fzf's port stops answering
		_lt_secs=$(awk -v ms="$_lt_refresh" 'BEGIN { if (ms < 50) ms = 50; printf "%.3f", ms / 1000 }')
		cat >"$_lt_tmp/refresh.sh" <<EOF
port=\$1; last=$_lt_tmp/last; new=$_lt_tmp/new
sh $_lt_tmp/seed.sh >"\$last" 2>/dev/null
while sleep $_lt_secs; do
	[ -d $_lt_tmp ] || exit 0
	sh $_lt_tmp/seed.sh >"\$new" 2>/dev/null || continue
	cmp -s "\$last" "\$new" && continue
	cp "\$new" "\$last"
	curl -s -m 2 -XPOST "127.0.0.1:\$port" --data "reload-sync(cat $_lt_tmp/last)" >/dev/null 2>&1 || exit 0
done
EOF
		_lt_start="$_lt_start sh $_lt_tmp/refresh.sh \$FZF_PORT &"
		if [ -n "$_lt_hints" ] || [ "$_lt_minor" -ge 71 ]; then set -- "$@" --track --id-nth="$_lt_key"; fi
	fi
	[ -n "$_lt_start" ] && set -- "$@" --listen --bind="start:execute-silent($_lt_start)"
	if [ -n "$_lt_reload" ]; then
		printf '%s\n' "$_lt_reload" | sed 's/{q}/"$1"/g' >"$_lt_tmp/reload.sh"
		set -- "$@" --bind="change:reload(sh $_lt_tmp/reload.sh {q})"
	fi

	# mode: select = no input line, space marks, / opens search
	_lt_bar= _lt_ubar=
	# our own fzf draws the key hint bar itself (--hints, held modifiers, clickable); others get a footer
	if [ "$_lt_mode" = select ]; then
		if [ -n "$_lt_hints" ]; then _lt_mark=' # mark' _lt_find=' # search'; else _lt_mark= _lt_find=; fi
		set -- "$@" --multi --no-input \
			--bind="space:toggle+down$_lt_mark,tab:down,btab:up,/:show-input$_lt_find" \
			--bind='esc:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo abort || echo "clear-query+hide-input"'
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint space mark)$(_lt_hint / search)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	else
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint type filter)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	fi

	# yaml key map -> binds + key bar
	_lt_n=0
	if [ -n "$_lt_keys" ]; then
		[ "$_lt_keys" = - ] && printf '%s\n' "${LT_KEYS:-}" >"$_lt_tmp/keys" || cat "$_lt_keys" >"$_lt_tmp/keys"
		while IFS= read -r _lt_line || [ -n "$_lt_line" ]; do
			_lt_line=$(_lt_trim "$_lt_line")
			case $_lt_line in '' | '#'*) continue ;; esac
			# a line of just --- starts a new line in the key bar
			[ "$_lt_line" = --- ] && { _lt_ubar="$_lt_ubar
"; _lt_fresh=1; continue; }
			_lt_kn=$(_lt_trim "${_lt_line%%:*}")
			_lt_rest=${_lt_line#*:}
			case $_lt_rest in
				*' # '*) _lt_label=$(_lt_trim "${_lt_rest##* # }"); _lt_act=$(_lt_trim "${_lt_rest% # *}") ;;
				*)       _lt_label=; _lt_act=$(_lt_trim "$_lt_rest") ;;
			esac
			_lt_n=$((_lt_n + 1))
			_lt_reloadact="+reload(sh $_lt_tmp/seed.sh)"
			case $_lt_act in
				refresh)  _lt_bind="reload(sh $_lt_tmp/seed.sh)" ;;
				quit)     _lt_bind=abort ;;
				'!'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#!}"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)$_lt_reloadact" ;;
				'>'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#>}"
				          _lt_bind="become(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
				accept | select-all | deselect-all | toggle | toggle-all | first | last | up | down | page-up | page-down | abort | clear-query | show-input | hide-input)
				          _lt_bind=$_lt_act ;;
				*)        _lt_script "$_lt_tmp/a$_lt_n.sh" "$_lt_act"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
			esac
			if [ -n "$_lt_hints" ] && [ -n "$_lt_label" ]; then set -- "$@" --bind="$_lt_kn:$_lt_bind # $_lt_label"
			else set -- "$@" --bind="$_lt_kn:$_lt_bind"; fi
			if [ -n "$_lt_label" ]; then
				_lt_ubar="$_lt_ubar$(_lt_hint "$_lt_kn" "$_lt_label")"
				_lt_fresh=
			fi
		done <"$_lt_tmp/keys"
	fi
	# defaults on line one, the key map's labels on line two
	if [ -n "$_lt_hints" ]; then set -- "$@" --hints
	else set -- "$@" --footer="$_lt_bar${_lt_ubar:+
$_lt_ubar}"; fi

	_lt_sel=$(sh "$_lt_tmp/seed.sh" | fzf "$@"); _lt_rc=$?
	rm -rf "$_lt_tmp"
	[ $_lt_rc -eq 0 ] || return 1
	[ -n "$_lt_sel" ] && printf '%s\n' "$_lt_sel" | cut -f"$_lt_key"
	return 0
}

# numbered prompt when fzf is missing
_lt_fallback() {
	sh "$_lt_tmp/seed.sh" >"$_lt_tmp/fb"
	[ -s "$_lt_tmp/fb" ] || return 1
	awk -F'\t' '{ printf "%3d) %s\n", NR, ($1 == "" ? $0 : $0) }' "$_lt_tmp/fb" | tr '\t' ' ' >&2
	printf 'pick number%s, q to cancel: ' "$([ "$_lt_mode" = select ] && echo 's (space separated)')" >&2
	read -r _lt_ans || return 1
	case $_lt_ans in '' | q) return 1 ;; esac
	for _lt_i in $_lt_ans; do sed -n "${_lt_i}p" "$_lt_tmp/fb"; done | cut -f"$_lt_key"
}

# <<< lazytui <<<

wifi_iface() {
	for d in /sys/class/net/*/; do
		if [ -d "${d}wireless" ]; then
			basename "$d"
			return 0
		fi
	done
	return 1
}

# NetworkManager: pick from nmcli's terse (machine-readable) list.
wifi_via_nmcli() {
	echo "scanning for Wi-Fi networks (nmcli)..."
	nmcli dev wifi rescan >/dev/null 2>&1
	sleep 2
	list="$(nmcli -t -f SSID,SIGNAL,SECURITY dev wifi list | awk -F: '$1 != "" && !seen[$1]++ { printf "%s\t%-32s %3s%%  %s\n", $1, $1, $2, $3 }')"
	if [ -z "$list" ]; then
		echo "no Wi-Fi networks found"
		return 1
	fi
	# lt_select falls back to a numbered prompt by itself when fzf is missing
	ssid="$(printf '%s\n' "$list" | lt_select --nth 2 --prompt 'wifi> ' --header 'pick a network')" || { echo "cancelled"; return 0; }
	echo "connecting to: $ssid"
	# --ask: nmcli prompts for the password only if the network needs one.
	nmcli --ask dev wifi connect "$ssid"
}

wifi_via_iwctl() {
	iface="$(wifi_iface)"
	if [ -z "$iface" ]; then
		echo "no real wireless interface found"
		return 1
	fi

	echo "scanning for real Wi-Fi networks (iwctl/iwd, device $iface)..."
	iwctl station "$iface" scan
	sleep 2

	# iwctl's own get-networks table isn't a stable machine-parseable
	# format (no real terse/-t mode the way nmcli has) - shown as-is,
	# real output, and you type the exact real SSID rather than picking
	# a number. Honest, not a fabricated numbered menu over data we
	# can't reliably parse.
	iwctl station "$iface" get-networks

	printf "type the exact SSID to connect to, or q to cancel: "
	read -r ssid
	if [ "$ssid" = "q" ] || [ -z "$ssid" ]; then
		echo "cancelled"
		return 0
	fi

	echo "connecting to real network: $ssid"
	# real iwd secrets prompt appears right here, only if needed.
	iwctl station "$iface" connect "$ssid"
}

wifi_via_wpa_cli() {
	iface="$(wifi_iface)"
	if [ -z "$iface" ]; then
		echo "no real wireless interface found"
		return 1
	fi

	echo "scanning for real Wi-Fi networks (wpa_cli, device $iface)..."
	wpa_cli -i "$iface" scan >/dev/null 2>&1
	sleep 2

	tmp_ssids="$(mktemp)"
	trap 'rm -f "$tmp_ssids"' EXIT

	# real wpa_cli scan_results: tab-separated "bssid freq signal flags
	# ssid", one real header row first (skipped via NR>1).
	wpa_cli -i "$iface" scan_results | awk -F'\t' -v ssids="$tmp_ssids" '
		NR > 1 && $5 != "" {
			if (!($5 in seen)) { order[++n] = $5; seen[$5] = 1 }
			printf "%2d) %-32s %s  %s\n", n, $5, $3, $4
			print $5 >> ssids
		}
	'

	if [ ! -s "$tmp_ssids" ]; then
		echo "no real Wi-Fi networks found"
		return 1
	fi

	printf "pick a network (number), or q to cancel: "
	read -r choice
	if [ "$choice" = "q" ] || [ -z "$choice" ]; then
		echo "cancelled"
		return 0
	fi

	ssid="$(sed -n "${choice}p" "$tmp_ssids")"
	if [ -z "$ssid" ]; then
		echo "invalid choice"
		return 1
	fi

	# wpa_cli has no built-in interactive secrets prompt of its own
	# (unlike iwd) - the real password has to be supplied to a real
	# network profile directly, so it's read here (masked, no echo).
	printf "password for '%s' (leave blank if open): " "$ssid"
	stty -echo
	read -r psk
	stty echo
	echo

	id="$(wpa_cli -i "$iface" add_network | tail -1)"
	wpa_cli -i "$iface" set_network "$id" ssid "\"$ssid\"" >/dev/null
	if [ -n "$psk" ]; then
		wpa_cli -i "$iface" set_network "$id" psk "\"$psk\"" >/dev/null
	else
		wpa_cli -i "$iface" set_network "$id" key_mgmt NONE >/dev/null
	fi
	wpa_cli -i "$iface" enable_network "$id" >/dev/null
	echo "connecting to real network: $ssid"
	wpa_cli -i "$iface" select_network "$id"
}


if command -v nmcli >/dev/null 2>&1 && systemctl is-active --quiet NetworkManager 2>/dev/null; then
	wifi_via_nmcli
elif command -v iwctl >/dev/null 2>&1 && systemctl is-active --quiet iwd 2>/dev/null; then
	wifi_via_iwctl
elif command -v wpa_cli >/dev/null 2>&1 && systemctl is-active --quiet wpa_supplicant 2>/dev/null; then
	wifi_via_wpa_cli
else
	echo "no supported Wi-Fi backend found (need NetworkManager+nmcli, iwd+iwctl, or wpa_supplicant+wpa_cli)"
	exit 1
fi
