#!/bin/sh
# <manwriter>
# real symlink-candidate finder for a dotfiles-style setup: walks $HOME
# and $HOME/.config one level deep, skips anything that's already a
# symlink (nothing to do) and a real blocklist of cache/state/sensitive
# dirs (never suggests .ssh, .gnupg, .cache, .npm, .cargo, .steam, .var,
# __pycache__, node_modules, .git, elpa/eln-cache, target/.build - cache
# and secrets, not config), then reports what's left as a candidate:
# real, loose config sitting outside the dotfiles pattern this project
# already uses elsewhere (move the real file into a dotfiles dir,
# symlink back from its original path).
#
# usage: ezlink                    report candidates, do nothing
#        ezlink apply DEST_DIR     report, then let you pick which to
#                                   actually move+symlink into DEST_DIR
#
# Read-only unless you explicitly ask for apply and then confirm a pick
# - this never moves anything on its own.
# </manwriter>

set -eu

BLOCKLIST='^\.(cache|npm|cargo|steam|var|ssh|gnupg|pki|local|claude|git|config|mozilla|cargo)$|^(__pycache__|node_modules|elpa|eln-cache|target|\.build|\.mc-lists\.el|auto-save-list|backups)$'

scan_dir() {
	dir="$1"
	[ -d "$dir" ] || return 0
	for entry in "$dir"/.[!.]* "$dir"/..?* "$dir"/*; do
		[ -e "$entry" ] || continue
		name=$(basename "$entry")
		[ -L "$entry" ] && continue
		printf '%s\n' "$name" | grep -qE "$BLOCKLIST" && continue
		printf '%s\n' "$entry"
	done
}

report() {
	i=0
	for entry in $(scan_dir "$HOME"; scan_dir "$HOME/.config"); do
		i=$((i + 1))
		size=$(du -sh "$entry" 2>/dev/null | cut -f1)
		printf '%2d) %-50s %s\n' "$i" "$entry" "${size:-?}"
	done
	if [ "$i" -eq 0 ]; then
		echo "nothing found outside the blocklist"
	fi
	return 0
}

case "${1:-}" in
'' | report)
	report
	;;
apply)
	dest="${2:?usage: ezlink apply DEST_DIR}"
	mkdir -p "$dest"
	tmp=$(mktemp)
	trap 'rm -f "$tmp"' EXIT
	i=0
	for entry in $(scan_dir "$HOME"; scan_dir "$HOME/.config"); do
		i=$((i + 1))
		printf '%s\n' "$entry" >>"$tmp"
		size=$(du -sh "$entry" 2>/dev/null | cut -f1)
		printf '%2d) %-50s %s\n' "$i" "$entry" "${size:-?}"
	done
	if [ "$i" -eq 0 ]; then echo "nothing found outside the blocklist"; exit 0; fi

	printf "pick numbers to move+symlink into %s (space-separated, or 'all'), empty to cancel: " "$dest"
	read -r picks
	[ -z "$picks" ] && { echo "cancelled"; exit 0; }
	[ "$picks" = all ] && picks=$(seq 1 "$i")

	for n in $picks; do
		src=$(sed -n "${n}p" "$tmp")
		[ -z "$src" ] && { echo "skip: no entry $n"; continue; }
		name=$(basename "$src")
		target="$dest/$name"
		if [ -e "$target" ]; then
			echo "skip $name: $target already exists"
			continue
		fi
		mv "$src" "$target"
		ln -s "$target" "$src"
		echo "linked: $src -> $target"
	done
	;;
*)
	echo "usage: ezlink [report | apply DEST_DIR]" >&2
	exit 2
	;;
esac
