#!/bin/sh
# <manwriter>
# ezlog - read any log with fzf: journal, units, kernel and plain log
# files, coloured by severity, live or as a snapshot. Built on
# lib/lazytui.sh; replaces the old `log`.
#
#   ezlog                    pick a source, then read it
#   ezlog SOURCE [MODE] [LEVEL]
#
# Sources are listed in one searchable list: the systemd journal (this
# boot, everything, previous boot, errors, user), the kernel, every
# service unit, and log files found under LOG_DIRS (top of the script).
# Without systemd only the files (and dmesg) are offered, so it works
# everywhere. Compressed logs (.gz) open as snapshots.
#
# In the reader, type to filter (exact match), arrows scroll, Ctrl-/ shows
# the whole line wrapped, Tab marks lines and Ctrl-Y copies them. MODE is
# static (last LINES_MAX lines) or follow (live, Ctrl-F toggles). LEVEL
# keeps only errors (Alt-E), warnings and above (Alt-W) or everything
# (Alt-A). Lines mentioning error/fail/fatal/panic/denied are red,
# warn/timeout/deprecated yellow, started/connected/success green.
#
# @flag SOURCE:journal:boot, journal:all, journal:prev, journal:err, journal:user, kernel, unit:NAME or file:PATH
# @flag MODE:static or follow
# @flag LEVEL:all, warn or err
# </manwriter>

# ---- edit me ---------------------------------------------------------
LINES_MAX="${EZLOG_LINES:-5000}"                        # lines loaded per source
LOG_DIRS="${EZLOG_DIRS:-/var/log $HOME/.local/state}"   # searched for *.log files
LOG_DEPTH="${EZLOG_DEPTH:-2}"
# ----------------------------------------------------------------------

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SELF=$HERE/$(basename -- "$0")
# >>> lazytui (vendored from lib/lazytui.sh by ./vendor - edit the library, not this block) >>>
# _lt_hint KEYNAME LABEL -> key caps then LABEL (the nnn hint-bar look). KEYNAME is an fzf key
# (ctrl-r, alt-enter, ctrl-alt-x, shift-up, f5, space...). Every modifier gets its own coloured cap
# (Ctrl blue, Alt yellow, Shift green), the key itself is a reverse-video cap.
_lt_hint() {
	_lt_h=$1
	while :; do
		case $_lt_h in
			ctrl-?*)  printf '\033[30;44m Ctrl \033[0m'; _lt_h=${_lt_h#ctrl-} ;;
			alt-?*)   printf '\033[30;43m Alt \033[0m'; _lt_h=${_lt_h#alt-} ;;
			shift-?*) printf '\033[30;42m Shift \033[0m'; _lt_h=${_lt_h#shift-} ;;
			*) break ;;
		esac
	done
	case $_lt_h in
		?) _lt_h=$(printf %s "$_lt_h" | tr a-z A-Z) ;;
		enter) _lt_h=Enter ;; esc) _lt_h=Esc ;; tab) _lt_h=Tab ;; btab) _lt_h='Shift+Tab' ;; space) _lt_h=Space ;;
		bspace) _lt_h=Backspace ;; pgup) _lt_h=PgUp ;; pgdn) _lt_h=PgDn ;; del) _lt_h=Del ;;
		up) _lt_h='↑' ;; down) _lt_h='↓' ;; left) _lt_h='←' ;; right) _lt_h='→' ;;
	esac
	printf '\033[7m %s \033[0m %s   ' "$_lt_h" "$2"
}

# _lt_trim STR -> STR without leading/trailing blanks
_lt_trim() { printf %s "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

# _lt_script FILE CMD -> FILE runs CMD "$@" (keeps quoting out of fzf binds)
_lt_script() { printf '%s "$@"\n' "$2" >"$1"; }

lt_select() {
	_lt_mode=raw _lt_refresh=${LT_REFRESH:-0} _lt_seed= _lt_more= _lt_reload= _lt_preview= _lt_keys= \
	_lt_key=1 _lt_nth= _lt_header= _lt_prompt='> '
	while [ $# -gt 0 ]; do
		case $1 in
			--mode)    _lt_mode=$2;    shift 2 ;;
			--seed)    _lt_seed=$2;    shift 2 ;;
			--more)    _lt_more=$2;    shift 2 ;;
			--refresh) _lt_refresh=$2; shift 2 ;;
			--reload)  _lt_reload=$2;  shift 2 ;;
			--preview) _lt_preview=$2; shift 2 ;;
			--keys)    _lt_keys=$2;    shift 2 ;;
			--key)     _lt_key=$2;     shift 2 ;;
			--nth)     _lt_nth=$2;     shift 2 ;;
			--header)  _lt_header=$2;  shift 2 ;;
			--prompt)  _lt_prompt=$2;  shift 2 ;;
			*) echo "lt_select: unknown arg $1" >&2; return 2 ;;
		esac
	done
	case $_lt_refresh in '' | *[!0-9]*) echo "lt_select: --refresh wants milliseconds, got '$_lt_refresh'" >&2; return 2 ;; esac
	case $_lt_mode in raw | select) ;; *) echo "lt_select: --mode must be raw or select" >&2; return 2 ;; esac

	_lt_tmp=$(mktemp -d) || return 1
	if [ -n "$_lt_seed" ]; then
		_lt_script "$_lt_tmp/seed.sh" "$_lt_seed"
	else
		cat >"$_lt_tmp/list"
		printf 'cat "%s/list"\n' "$_lt_tmp" >"$_lt_tmp/seed.sh"
	fi

	if ! command -v fzf >/dev/null 2>&1; then
		_lt_fallback; _lt_rc=$?
		rm -rf "$_lt_tmp"; return $_lt_rc
	fi

	TAB=$(printf '\t')
	_lt_k="{+$_lt_key}"
	set -- --delimiter="$TAB" --ansi --prompt="$_lt_prompt" --footer-border=none --layout=reverse-list
	[ -n "$_lt_header" ] && set -- "$@" --header="$_lt_header"
	[ -n "$_lt_nth" ] && set -- "$@" --with-nth="$_lt_nth"
	if [ -n "$_lt_preview" ]; then
		_lt_script "$_lt_tmp/preview.sh" "$_lt_preview"
		set -- "$@" --preview="sh $_lt_tmp/preview.sh {$_lt_key}" \
			--preview-window="${LT_PREVIEW_WINDOW:-down,60%,wrap}"
	fi
	_lt_start=
	if [ -n "$_lt_more" ]; then
		cat >"$_lt_tmp/more.sh" <<EOF
out=\$(mktemp)
$_lt_more > "\$out" 2>/dev/null || true
if [ -s "\$out" ]; then
	curl -s -XPOST "127.0.0.1:\$1" --data "reload(cat \$out; rm -f \$out)" >/dev/null 2>&1 || rm -f "\$out"
else rm -f "\$out"; fi
EOF
		_lt_start="$_lt_start sh $_lt_tmp/more.sh \$FZF_PORT &"
	fi
	if [ "$_lt_refresh" -gt 0 ] && [ -z "$_lt_reload" ] && command -v curl >/dev/null 2>&1; then
		# background loop: run the seed, post it to fzf only when it changed;
		# it ends by itself once fzf's port stops answering
		_lt_secs=$(awk -v ms="$_lt_refresh" 'BEGIN { if (ms < 50) ms = 50; printf "%.3f", ms / 1000 }')
		cat >"$_lt_tmp/refresh.sh" <<EOF
port=\$1; last=$_lt_tmp/last; new=$_lt_tmp/new
sh $_lt_tmp/seed.sh >"\$last" 2>/dev/null
while sleep $_lt_secs; do
	[ -d $_lt_tmp ] || exit 0
	sh $_lt_tmp/seed.sh >"\$new" 2>/dev/null || continue
	cmp -s "\$last" "\$new" && continue
	cp "\$new" "\$last"
	curl -s -m 2 -XPOST "127.0.0.1:\$port" --data "reload-sync(cat $_lt_tmp/last)" >/dev/null 2>&1 || exit 0
done
EOF
		_lt_start="$_lt_start sh $_lt_tmp/refresh.sh \$FZF_PORT &"
		set -- "$@" --track --id-nth="$_lt_key"
	fi
	[ -n "$_lt_start" ] && set -- "$@" --listen --bind="start:execute-silent($_lt_start)"
	if [ -n "$_lt_reload" ]; then
		printf '%s\n' "$_lt_reload" | sed 's/{q}/"$1"/g' >"$_lt_tmp/reload.sh"
		set -- "$@" --bind="change:reload(sh $_lt_tmp/reload.sh {q})"
	fi

	# mode: select = no input line, space marks, / opens search
	_lt_bar= _lt_ubar=
	# our own fzf draws the key hint bar itself (--hints, held modifiers, clickable); others get a footer
	_lt_hints=
	case $(fzf --version 2>/dev/null) in *-c\ *) _lt_hints=1 ;; esac
	if [ "$_lt_mode" = select ]; then
		set -- "$@" --multi --no-input \
			--bind='space:toggle+down # mark,tab:down,btab:up,/:show-input # search' \
			--bind='esc:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo abort || echo "clear-query+hide-input"'
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint space mark)$(_lt_hint / search)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	else
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint type filter)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	fi

	# yaml key map -> binds + key bar
	_lt_n=0
	if [ -n "$_lt_keys" ]; then
		[ "$_lt_keys" = - ] && printf '%s\n' "${LT_KEYS:-}" >"$_lt_tmp/keys" || cat "$_lt_keys" >"$_lt_tmp/keys"
		while IFS= read -r _lt_line || [ -n "$_lt_line" ]; do
			_lt_line=$(_lt_trim "$_lt_line")
			case $_lt_line in '' | '#'*) continue ;; esac
			# a line of just --- starts a new line in the key bar
			[ "$_lt_line" = --- ] && { _lt_ubar="$_lt_ubar
"; _lt_fresh=1; continue; }
			_lt_kn=$(_lt_trim "${_lt_line%%:*}")
			_lt_rest=${_lt_line#*:}
			case $_lt_rest in
				*' # '*) _lt_label=$(_lt_trim "${_lt_rest##* # }"); _lt_act=$(_lt_trim "${_lt_rest% # *}") ;;
				*)       _lt_label=; _lt_act=$(_lt_trim "$_lt_rest") ;;
			esac
			_lt_n=$((_lt_n + 1))
			_lt_reloadact="+reload(sh $_lt_tmp/seed.sh)"
			case $_lt_act in
				refresh)  _lt_bind="reload(sh $_lt_tmp/seed.sh)" ;;
				quit)     _lt_bind=abort ;;
				'!'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#!}"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)$_lt_reloadact" ;;
				'>'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#>}"
				          _lt_bind="become(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
				accept | select-all | deselect-all | toggle | toggle-all | first | last | up | down | page-up | page-down | abort | clear-query | show-input | hide-input)
				          _lt_bind=$_lt_act ;;
				*)        _lt_script "$_lt_tmp/a$_lt_n.sh" "$_lt_act"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
			esac
			if [ -n "$_lt_hints" ] && [ -n "$_lt_label" ]; then set -- "$@" --bind="$_lt_kn:$_lt_bind # $_lt_label"
			else set -- "$@" --bind="$_lt_kn:$_lt_bind"; fi
			if [ -n "$_lt_label" ]; then
				_lt_ubar="$_lt_ubar$(_lt_hint "$_lt_kn" "$_lt_label")"
				_lt_fresh=
			fi
		done <"$_lt_tmp/keys"
	fi
	# defaults on line one, the key map's labels on line two
	if [ -n "$_lt_hints" ]; then set -- "$@" --hints
	else set -- "$@" --footer="$_lt_bar${_lt_ubar:+
$_lt_ubar}"; fi

	_lt_sel=$(sh "$_lt_tmp/seed.sh" | fzf "$@"); _lt_rc=$?
	rm -rf "$_lt_tmp"
	[ $_lt_rc -eq 0 ] || return 1
	[ -n "$_lt_sel" ] && printf '%s\n' "$_lt_sel" | cut -f"$_lt_key"
	return 0
}

# numbered prompt when fzf is missing
_lt_fallback() {
	sh "$_lt_tmp/seed.sh" >"$_lt_tmp/fb"
	[ -s "$_lt_tmp/fb" ] || return 1
	awk -F'\t' '{ printf "%3d) %s\n", NR, ($1 == "" ? $0 : $0) }' "$_lt_tmp/fb" | tr '\t' ' ' >&2
	printf 'pick number%s, q to cancel: ' "$([ "$_lt_mode" = select ] && echo 's (space separated)')" >&2
	read -r _lt_ans || return 1
	case $_lt_ans in '' | q) return 1 ;; esac
	for _lt_i in $_lt_ans; do sed -n "${_lt_i}p" "$_lt_tmp/fb"; done | cut -f"$_lt_key"
}

# <<< lazytui <<<
have() { command -v "$1" >/dev/null 2>&1; }
ERE_ERR='error|fail|fatal|panic|critical|denied|segfault|oops|traceback|exception'
ERE_WARN="warn|timeout|timed out|deprecated|unable|refused|$ERE_ERR"

# _color: severity colouring, one awk pass
_color() {
	awk -v err="$ERE_ERR" -v warn='warn|timeout|timed out|deprecated|unable|refused' -v ok='started|connected|success|listening|ready|reached target' '
	{
		l = tolower($0); c = ""
		if (l ~ err) c = "\033[31m"
		else if (l ~ warn) c = "\033[33m"
		else if (l ~ ok) c = "\033[32m"
		if (c != "") printf "%s%s\033[0m\n", c, $0; else print
		fflush()   # live sources: do not sit on lines in a pipe buffer
	}'
}

# _raw SPEC MODE LEVEL -> the log lines, uncoloured
_raw() {
	spec=$1 mode=${2:-static} level=${3:-all}
	n=$LINES_MAX
	case $spec in
	journal:* | unit:* | kernel)
		if ! have journalctl; then
			[ "$spec" = kernel ] || { echo "ezlog: journalctl not found (no systemd)" >&2; return 1; }
			if [ "$mode" = follow ]; then dmesg -w 2>/dev/null; else dmesg -T 2>/dev/null | tail -n "$n"; fi
			return
		fi
		set -- -o short-iso --no-pager
		case $spec in
			journal:boot) set -- "$@" -b ;;
			journal:prev) set -- "$@" -b -1 ;;
			journal:err)  set -- "$@" -b -p err ;;
			journal:user) set -- "$@" --user ;;
			journal:all)  ;;
			unit:*)       set -- "$@" -u "${spec#unit:}" ;;
			kernel)       set -- "$@" -k -b ;;
		esac
		case $level in err) [ "$spec" = journal:err ] || set -- "$@" -p err ;; warn) set -- "$@" -p warning ;; esac
		if [ "$mode" = follow ]; then journalctl "$@" -n "$n" -f; else journalctl "$@" -n "$n"; fi ;;
	file:*)
		f=${spec#file:}
		[ -r "$f" ] || { echo "ezlog: cannot read $f (try sudo)" >&2; return 1; }
		{
			case $f in
				*.gz) zcat "$f" | tail -n "$n" ;;
				*)    if [ "$mode" = follow ]; then tail -n "$n" -F "$f"; else tail -n "$n" "$f"; fi ;;
			esac
		} | case $level in
			err)  grep --line-buffered -iE "$ERE_ERR" ;;
			warn) grep --line-buffered -iE "$ERE_WARN" ;;
			*)    cat ;;
		esac ;;
	*) echo "ezlog: unknown source $spec" >&2; return 1 ;;
	esac
}

_copy() {
	if [ -n "${WAYLAND_DISPLAY:-}" ] && have wl-copy; then wl-copy
	elif have xclip; then xclip -selection clipboard
	elif have xsel; then xsel -bi
	else cat >/dev/null; fi
}

_view() {
	spec=$1 mode=${2:-static} level=${3:-all}
	case $mode in follow) other=static ;; *) other=follow ;; esac
	hdr="$spec · $mode · $level"
	bar1='type to filter · ↑↓ scroll · tab mark · ^/ full line · esc quit'
	bar2="^F $other · M-A all · M-W warn+ · M-E errors · ^Y copy marked · M-B sources"
	# The producer runs in its own session so it can be killed as a whole
	# when fzf exits; otherwise `tail -F` / `journalctl -f` would outlive it.
	fifo=$(mktemp -u) && mkfifo "$fifo" || exit 1
	if have setsid; then setsid "$SELF" _stream "$spec" "$mode" "$level" >"$fifo" 2>&1 &
	else "$SELF" _stream "$spec" "$mode" "$level" >"$fifo" 2>&1 & fi
	prod=$!
	fzf --ansi --tac --no-sort --exact --multi \
		--header="$hdr" --footer="$bar1
$bar2" \
		--preview='printf "%s\n" {}' --preview-window='down,4,wrap,hidden' \
		--bind='ctrl-/:toggle-preview' \
		--bind="ctrl-f:become(kill -- -$prod 2>/dev/null; rm -f $fifo; $SELF _view '$spec' $other $level)" \
		--bind="alt-a:become(kill -- -$prod 2>/dev/null; rm -f $fifo; $SELF _view '$spec' $mode all)" \
		--bind="alt-w:become(kill -- -$prod 2>/dev/null; rm -f $fifo; $SELF _view '$spec' $mode warn)" \
		--bind="alt-e:become(kill -- -$prod 2>/dev/null; rm -f $fifo; $SELF _view '$spec' $mode err)" \
		--bind="alt-b:become(kill -- -$prod 2>/dev/null; rm -f $fifo; $SELF)" \
		--bind="ctrl-y:execute-silent(printf '%s\n' {+} | $SELF _copy)" \
		<"$fifo" >/dev/null
	kill -- "-$prod" 2>/dev/null || kill "$prod" 2>/dev/null
	rm -f "$fifo"
	exit 0
}

# _sources -> KEY<TAB>display, one per source
_sources() {
	C=$(printf '\033[36m'); G=$(printf '\033[32m'); D=$(printf '\033[90m'); Z=$(printf '\033[0m')
	if have journalctl; then
		printf '%s\t%s%-8s%s %s\n' journal:boot "$C" journal "$Z" "this boot" \
			journal:all "$C" journal "$Z" "everything" \
			journal:prev "$C" journal "$Z" "previous boot" \
			journal:err "$C" journal "$Z" "errors, this boot" \
			journal:user "$C" journal "$Z" "user session" \
			kernel "$C" kernel "$Z" "kernel messages, this boot"
		if have systemctl; then
			systemctl list-units --type=service --all --no-legend --plain 2>/dev/null | awk -v g="$G" -v d="$D" -v z="$Z" '{
				c = ($3 == "active") ? g : d
				printf "unit:%s\t%sunit    %s %-40.40s %s%s%s\n", $1, "\033[35m", z, $1, c, $3 " " $4, z }'
		fi
	else
		printf '%s\t%s%-8s%s %s\n' kernel "$C" kernel "$Z" "dmesg"
	fi
	for d in $LOG_DIRS; do
		[ -d "$d" ] || continue
		find "$d" -maxdepth "$LOG_DEPTH" -type f \( -name '*.log' -o -name '*.log.*' -o -name syslog -o -name messages \) -readable -size +0 2>/dev/null
	done | sort -u | while read -r f; do
		printf 'file:%s\t\033[33mfile    \033[0m %s\n' "$f" "$f"
	done
}

case ${1:-} in
	_view)    shift; _view "$@" ;;
	_copy)    _copy; exit 0 ;;
	_stream)  shift; _raw "$@" | _color; exit 0 ;;
	_sources) _sources; exit 0 ;;
	_preview) shift; LINES_MAX=60 _raw "$1" static all 2>&1 | _color; exit 0 ;;
	"")       ;;
	-h | --help) sed -n '2,/^# <\/manwriter>/p' "$0" | sed 's/^# \{0,1\}//; /manwriter>/d'; exit 0 ;;
	*)        _view "$@" ;;
esac

LT_KEYS="enter: >$SELF _view                                          # Read
alt-f: >sh -c 'exec \"\$0\" _view \"\$1\" follow' $SELF               # Follow
alt-e: >sh -c 'exec \"\$0\" _view \"\$1\" static err' $SELF           # Errors only"
export LT_KEYS
lt_select --seed "$SELF _sources" --nth 2 --header 'log sources' --prompt 'source> ' \
	--preview "$SELF _preview" --keys - >/dev/null || true
