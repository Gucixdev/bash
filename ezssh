#!/bin/sh
# <manwriter>
# ezssh - terminal manager for SSH: hosts, tunnels and keys in one tool,
# built on lib/lazytui.sh. It only drives the real ssh, ssh-keygen,
# ssh-copy-id, scp/rsync and sshfs, and edits ~/.ssh/config (a dated backup
# is written before every change).
#
#   ezssh [hosts | tunnels | keys]
#
# Hosts lists every Host in your ssh config (wildcards left out) with what
# ssh will really use for it, plus a live "reachable" marker filled in a
# moment after the list appears. Enter connects. Tunnels lists the port
# forwards started from here, which run in the background on a control
# socket so they can be stopped again. Keys lists ~/.ssh/*.pub with their
# fingerprints. Tab / Shift-Tab cycle the three views.
#
# Hosts:   Enter connect, Alt-T open a tunnel (local port forward), Alt-C
#          install your key on the host (ssh-copy-id), Alt-F upload a file,
#          Alt-G download a file, Alt-M / Alt-U mount / unmount with sshfs
#          under ~/mnt, Alt-K forget the host key, Alt-N add a host, Ctrl-D
#          remove a host block, Alt-E edit the config.
# Tunnels: Ctrl-X stop the marked tunnels.
# Keys:    Alt-N generate a key (ed25519), Enter show the public key, Alt-Y
#          copy it to the clipboard, Alt-A add it to ssh-agent.
#
# Set EZSSH_CONFIG to use another config file. Anything that needs a tool
# you don't have (sshfs, rsync, a clipboard) tells you instead of failing.
#
# @flag hosts:hosts from the ssh config (default)
# @flag tunnels:tunnels started by ezssh
# @flag keys:your public keys
# </manwriter>

# ---- edit me ---------------------------------------------------------
REFRESH_MS="${EZSSH_REFRESH:-3000}"            # auto-refresh, milliseconds, 0 = off
CONFIG="${EZSSH_CONFIG:-$HOME/.ssh/config}"
MOUNT_DIR="${EZSSH_MOUNTS:-$HOME/mnt}"         # sshfs mounts go to MOUNT_DIR/HOST
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ezssh"   # tunnel records + control sockets
PROBE_SECONDS="${EZSSH_PROBE:-1}"              # timeout of the reachable check
# ----------------------------------------------------------------------

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SELF=$HERE/$(basename -- "$0")
# >>> lazytui (vendored from lib/lazytui.sh by ./vendor - edit the library, not this block) >>>
# _lt_hint KEYNAME LABEL -> key caps then LABEL (the nnn hint-bar look). KEYNAME is an fzf key
# (ctrl-r, alt-enter, ctrl-alt-x, shift-up, f5, space...). Every modifier gets its own coloured cap
# (Ctrl blue, Alt yellow, Shift green), the key itself is a reverse-video cap.
_lt_hint() {
	_lt_h=$1
	while :; do
		case $_lt_h in
			ctrl-?*)  printf '\033[30;44m Ctrl \033[0m'; _lt_h=${_lt_h#ctrl-} ;;
			alt-?*)   printf '\033[30;43m Alt \033[0m'; _lt_h=${_lt_h#alt-} ;;
			shift-?*) printf '\033[30;42m Shift \033[0m'; _lt_h=${_lt_h#shift-} ;;
			*) break ;;
		esac
	done
	case $_lt_h in
		?) _lt_h=$(printf %s "$_lt_h" | tr a-z A-Z) ;;
		enter) _lt_h=Enter ;; esc) _lt_h=Esc ;; tab) _lt_h=Tab ;; btab) _lt_h='Shift+Tab' ;; space) _lt_h=Space ;;
		bspace) _lt_h=Backspace ;; pgup) _lt_h=PgUp ;; pgdn) _lt_h=PgDn ;; del) _lt_h=Del ;;
		up) _lt_h='↑' ;; down) _lt_h='↓' ;; left) _lt_h='←' ;; right) _lt_h='→' ;;
	esac
	printf '\033[7m %s \033[0m %s   ' "$_lt_h" "$2"
}

# _lt_trim STR -> STR without leading/trailing blanks
_lt_trim() { printf %s "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

# _lt_script FILE CMD -> FILE runs CMD "$@" (keeps quoting out of fzf binds)
_lt_script() { printf '%s "$@"\n' "$2" >"$1"; }

lt_confirm() {   # lt_confirm "question" -> 0 on y
	printf '%s [y/N] ' "$1" >&2
	read -r _lt_a || return 1
	case $_lt_a in y | Y | yes | YES | t | T | tak) return 0 ;; *) return 1 ;; esac
}

lt_select() {
	_lt_mode=raw _lt_refresh=${LT_REFRESH:-0} _lt_seed= _lt_more= _lt_reload= _lt_preview= _lt_keys= \
	_lt_key=1 _lt_nth= _lt_header= _lt_prompt='> '
	while [ $# -gt 0 ]; do
		case $1 in
			--mode)    _lt_mode=$2;    shift 2 ;;
			--seed)    _lt_seed=$2;    shift 2 ;;
			--more)    _lt_more=$2;    shift 2 ;;
			--refresh) _lt_refresh=$2; shift 2 ;;
			--reload)  _lt_reload=$2;  shift 2 ;;
			--preview) _lt_preview=$2; shift 2 ;;
			--keys)    _lt_keys=$2;    shift 2 ;;
			--key)     _lt_key=$2;     shift 2 ;;
			--nth)     _lt_nth=$2;     shift 2 ;;
			--header)  _lt_header=$2;  shift 2 ;;
			--prompt)  _lt_prompt=$2;  shift 2 ;;
			*) echo "lt_select: unknown arg $1" >&2; return 2 ;;
		esac
	done
	case $_lt_refresh in '' | *[!0-9]*) echo "lt_select: --refresh wants milliseconds, got '$_lt_refresh'" >&2; return 2 ;; esac
	case $_lt_mode in raw | select) ;; *) echo "lt_select: --mode must be raw or select" >&2; return 2 ;; esac

	_lt_tmp=$(mktemp -d) || return 1
	if [ -n "$_lt_seed" ]; then
		_lt_script "$_lt_tmp/seed.sh" "$_lt_seed"
	else
		cat >"$_lt_tmp/list"
		printf 'cat "%s/list"\n' "$_lt_tmp" >"$_lt_tmp/seed.sh"
	fi

	if ! command -v fzf >/dev/null 2>&1; then
		_lt_fallback; _lt_rc=$?
		rm -rf "$_lt_tmp"; return $_lt_rc
	fi

	TAB=$(printf '\t')
	_lt_k="{+$_lt_key}"
	set -- --delimiter="$TAB" --ansi --prompt="$_lt_prompt" --footer-border=none --layout=reverse-list
	[ -n "$_lt_header" ] && set -- "$@" --header="$_lt_header"
	[ -n "$_lt_nth" ] && set -- "$@" --with-nth="$_lt_nth"
	if [ -n "$_lt_preview" ]; then
		_lt_script "$_lt_tmp/preview.sh" "$_lt_preview"
		set -- "$@" --preview="sh $_lt_tmp/preview.sh {$_lt_key}" \
			--preview-window="${LT_PREVIEW_WINDOW:-down,60%,wrap}"
	fi
	_lt_start=
	if [ -n "$_lt_more" ]; then
		cat >"$_lt_tmp/more.sh" <<EOF
out=\$(mktemp)
$_lt_more > "\$out" 2>/dev/null || true
if [ -s "\$out" ]; then
	curl -s -XPOST "127.0.0.1:\$1" --data "reload(cat \$out; rm -f \$out)" >/dev/null 2>&1 || rm -f "\$out"
else rm -f "\$out"; fi
EOF
		_lt_start="$_lt_start sh $_lt_tmp/more.sh \$FZF_PORT &"
	fi
	if [ "$_lt_refresh" -gt 0 ] && [ -z "$_lt_reload" ] && command -v curl >/dev/null 2>&1; then
		# background loop: run the seed, post it to fzf only when it changed;
		# it ends by itself once fzf's port stops answering
		_lt_secs=$(awk -v ms="$_lt_refresh" 'BEGIN { if (ms < 50) ms = 50; printf "%.3f", ms / 1000 }')
		cat >"$_lt_tmp/refresh.sh" <<EOF
port=\$1; last=$_lt_tmp/last; new=$_lt_tmp/new
sh $_lt_tmp/seed.sh >"\$last" 2>/dev/null
while sleep $_lt_secs; do
	[ -d $_lt_tmp ] || exit 0
	sh $_lt_tmp/seed.sh >"\$new" 2>/dev/null || continue
	cmp -s "\$last" "\$new" && continue
	cp "\$new" "\$last"
	curl -s -m 2 -XPOST "127.0.0.1:\$port" --data "reload-sync(cat $_lt_tmp/last)" >/dev/null 2>&1 || exit 0
done
EOF
		_lt_start="$_lt_start sh $_lt_tmp/refresh.sh \$FZF_PORT &"
		set -- "$@" --track --id-nth="$_lt_key"
	fi
	[ -n "$_lt_start" ] && set -- "$@" --listen --bind="start:execute-silent($_lt_start)"
	if [ -n "$_lt_reload" ]; then
		printf '%s\n' "$_lt_reload" | sed 's/{q}/"$1"/g' >"$_lt_tmp/reload.sh"
		set -- "$@" --bind="change:reload(sh $_lt_tmp/reload.sh {q})"
	fi

	# mode: select = no input line, space marks, / opens search
	_lt_bar= _lt_ubar=
	# our own fzf draws the key hint bar itself (--hints, held modifiers, clickable); others get a footer
	_lt_hints=
	case $(fzf --version 2>/dev/null) in *-c\ *) _lt_hints=1 ;; esac
	if [ "$_lt_mode" = select ]; then
		set -- "$@" --multi --no-input \
			--bind='space:toggle+down # mark,tab:down,btab:up,/:show-input # search' \
			--bind='esc:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo abort || echo "clear-query+hide-input"'
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint space mark)$(_lt_hint / search)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	else
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint type filter)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	fi

	# yaml key map -> binds + key bar
	_lt_n=0
	if [ -n "$_lt_keys" ]; then
		[ "$_lt_keys" = - ] && printf '%s\n' "${LT_KEYS:-}" >"$_lt_tmp/keys" || cat "$_lt_keys" >"$_lt_tmp/keys"
		while IFS= read -r _lt_line || [ -n "$_lt_line" ]; do
			_lt_line=$(_lt_trim "$_lt_line")
			case $_lt_line in '' | '#'*) continue ;; esac
			# a line of just --- starts a new line in the key bar
			[ "$_lt_line" = --- ] && { _lt_ubar="$_lt_ubar
"; _lt_fresh=1; continue; }
			_lt_kn=$(_lt_trim "${_lt_line%%:*}")
			_lt_rest=${_lt_line#*:}
			case $_lt_rest in
				*' # '*) _lt_label=$(_lt_trim "${_lt_rest##* # }"); _lt_act=$(_lt_trim "${_lt_rest% # *}") ;;
				*)       _lt_label=; _lt_act=$(_lt_trim "$_lt_rest") ;;
			esac
			_lt_n=$((_lt_n + 1))
			_lt_reloadact="+reload(sh $_lt_tmp/seed.sh)"
			case $_lt_act in
				refresh)  _lt_bind="reload(sh $_lt_tmp/seed.sh)" ;;
				quit)     _lt_bind=abort ;;
				'!'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#!}"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)$_lt_reloadact" ;;
				'>'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#>}"
				          _lt_bind="become(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
				accept | select-all | deselect-all | toggle | toggle-all | first | last | up | down | page-up | page-down | abort | clear-query | show-input | hide-input)
				          _lt_bind=$_lt_act ;;
				*)        _lt_script "$_lt_tmp/a$_lt_n.sh" "$_lt_act"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
			esac
			if [ -n "$_lt_hints" ] && [ -n "$_lt_label" ]; then set -- "$@" --bind="$_lt_kn:$_lt_bind # $_lt_label"
			else set -- "$@" --bind="$_lt_kn:$_lt_bind"; fi
			if [ -n "$_lt_label" ]; then
				_lt_ubar="$_lt_ubar$(_lt_hint "$_lt_kn" "$_lt_label")"
				_lt_fresh=
			fi
		done <"$_lt_tmp/keys"
	fi
	# defaults on line one, the key map's labels on line two
	if [ -n "$_lt_hints" ]; then set -- "$@" --hints
	else set -- "$@" --footer="$_lt_bar${_lt_ubar:+
$_lt_ubar}"; fi

	_lt_sel=$(sh "$_lt_tmp/seed.sh" | fzf "$@"); _lt_rc=$?
	rm -rf "$_lt_tmp"
	[ $_lt_rc -eq 0 ] || return 1
	[ -n "$_lt_sel" ] && printf '%s\n' "$_lt_sel" | cut -f"$_lt_key"
	return 0
}

# numbered prompt when fzf is missing
_lt_fallback() {
	sh "$_lt_tmp/seed.sh" >"$_lt_tmp/fb"
	[ -s "$_lt_tmp/fb" ] || return 1
	awk -F'\t' '{ printf "%3d) %s\n", NR, ($1 == "" ? $0 : $0) }' "$_lt_tmp/fb" | tr '\t' ' ' >&2
	printf 'pick number%s, q to cancel: ' "$([ "$_lt_mode" = select ] && echo 's (space separated)')" >&2
	read -r _lt_ans || return 1
	case $_lt_ans in '' | q) return 1 ;; esac
	for _lt_i in $_lt_ans; do sed -n "${_lt_i}p" "$_lt_tmp/fb"; done | cut -f"$_lt_key"
}

# lt_wizard: steps on stdin, one per line:
#   var|prompt              free text
#   var|prompt|a,b,c        pick one (fzf)
#   var|prompt|a,b,c|def    same, with default
# prints eval-able VAR='value' lines; Esc goes back a step, Esc on the
# first step cancels (return 1). Usage: eval "$(lt_wizard <<EOF ... EOF)"
lt_wizard() {
	_lt_wd=$(mktemp -d) || return 1
	cat >"$_lt_wd/steps"
	_lt_total=$(wc -l <"$_lt_wd/steps")
	_lt_i=1
	while [ "$_lt_i" -le "$_lt_total" ]; do
		IFS='|' read -r _lt_var _lt_q _lt_ch _lt_def <<EOF
$(sed -n "${_lt_i}p" "$_lt_wd/steps")
EOF
		_lt_prev=
		[ -f "$_lt_wd/v.$_lt_i" ] && _lt_prev=$(cat "$_lt_wd/v.$_lt_i")
		_lt_hdr="[$_lt_i/$_lt_total] $_lt_q"
		if [ -n "$_lt_ch" ]; then
			_lt_pick=${_lt_prev:-$_lt_def}
			_lt_ans=$( { [ -n "$_lt_pick" ] && printf '%s\n' "$_lt_pick"; printf '%s\n' "$_lt_ch" | tr ',' '\n' | grep -vxF -- "$_lt_pick"; } | fzf --layout=reverse-list --header="$_lt_hdr" --footer='↑↓ move · enter accept · esc back' --no-multi) || _lt_ans=__back__
		else
			_lt_ans=$(printf '' | fzf --print-query --no-info --bind=enter:accept-or-print-query --header="$_lt_hdr" --footer='type · enter accept · esc back' --query="${_lt_prev:-$_lt_def}" | head -1) || _lt_ans=__back__
		fi
		if [ "$_lt_ans" = __back__ ]; then
			[ "$_lt_i" -eq 1 ] && { rm -rf "$_lt_wd"; return 1; }
			_lt_i=$((_lt_i - 1)); continue
		fi
		printf '%s' "$_lt_ans" >"$_lt_wd/v.$_lt_i"
		_lt_i=$((_lt_i + 1))
	done
	_lt_i=1
	while [ "$_lt_i" -le "$_lt_total" ]; do
		_lt_var=$(sed -n "${_lt_i}p" "$_lt_wd/steps" | cut -d'|' -f1)
		printf "%s='%s'\n" "$_lt_var" "$(sed "s/'/'\\\\''/g" "$_lt_wd/v.$_lt_i")"
		_lt_i=$((_lt_i + 1))
	done
	rm -rf "$_lt_wd"
}

# lt_realbin NAME -> path of the real NAME in PATH, skipping this script
# itself. For tools that wrap a program of the same name (a script called
# docker or flatpak) so they never call themselves.
lt_realbin() {
	_lt_old=$IFS; IFS=:
	for _lt_d in $PATH; do
		IFS=$_lt_old
		_lt_c=$_lt_d/$1
		if [ -x "$_lt_c" ] && [ ! -d "$_lt_c" ] && ! [ "$_lt_c" -ef "$0" ]; then printf '%s\n' "$_lt_c"; return 0; fi
		IFS=:
	done
	IFS=$_lt_old
	return 1
}

# <<< lazytui <<<
have() { command -v "$1" >/dev/null 2>&1; }
have ssh || { echo "ezssh: ssh not found" >&2; exit 1; }
SSH=$(lt_realbin ssh) || SSH=ssh
pause() { printf '\npress Enter ' >&2; read -r _ </dev/tty; }
err() { echo "ezssh: $*" >&2; ERR=1; }
ERR=0

# ---- config ------------------------------------------------------------
# hosts: ALIAS<TAB>HostName<TAB>User<TAB>Port, wildcards skipped
_hosts() {
	[ -f "$CONFIG" ] || return 0
	awk '
	function flush() { if (h != "") printf "%s\t%s\t%s\t%s\n", h, hn, us, po }
	tolower($1) == "host" { flush(); h = ""; hn = us = po = ""; for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) { h = $i; break }; next }
	tolower($1) == "hostname" { hn = $2 } tolower($1) == "user" { us = $2 } tolower($1) == "port" { po = $2 }
	END { flush() }' "$CONFIG"
}

_backup() { [ -f "$CONFIG" ] && cp -p "$CONFIG" "$CONFIG.ezssh-bak.$(date +%Y%m%d_%H%M%S)"; }

# ---- views ---------------------------------------------------------------
# rows: KEY<TAB>display
_rows_hosts() {
	_hosts | while IFS='	' read -r a hn us po; do
		printf '%s\t   %-20.20s %s%s%s\n' "$a" "$a" "${us:+$us@}" "${hn:-$a}" "${po:+:$po}"
	done
}
# same rows with a reachable marker (slow: one TCP probe per host)
_rows_hosts_probe() {
	_hosts | while IFS='	' read -r a hn us po; do
		h=${hn:-$a}; p=${po:-22}
		if have bash && timeout "$PROBE_SECONDS" bash -c ": >/dev/tcp/$h/$p" 2>/dev/null; then m=$(printf '\033[32m●\033[0m')
		else m=$(printf '\033[90m○\033[0m'); fi
		printf '%s\t %s %-20.20s %s%s%s\n' "$a" "$m" "$a" "${us:+$us@}" "$h" "${po:+:$po}"
	done
}
_rows_tunnels() {
	for f in "$STATE"/tunnels/*.rec; do
		[ -f "$f" ] || continue
		. "$f"   # HOST LPORT RHOST RPORT SOCK
		if "$SSH" -S "$SOCK" -O check "$HOST" >/dev/null 2>&1; then m=$(printf '\033[32m●\033[0m'); else m=$(printf '\033[31m✗\033[0m'); fi
		printf '%s\t %s %-16.16s localhost:%-6s -> %s:%s\n' "$(basename "$f" .rec)" "$m" "$HOST" "$LPORT" "$RHOST" "$RPORT"
	done
}
_rows_keys() {
	for f in "$HOME"/.ssh/*.pub; do
		[ -f "$f" ] || continue
		fp=$(ssh-keygen -lf "$f" 2>/dev/null)
		printf '%s\t   %-24.24s %s\n' "$f" "$(basename "$f")" "$(printf '%s' "$fp" | awk '{ print $4 " " $1 "  " $2 "  " $3 }')"
	done
}

_preview() {   # VIEW KEY
	case $1 in
		hosts)   "$SSH" -G "$2" 2>/dev/null | grep -E '^(hostname|user|port|identityfile|proxyjump|forwardagent|localforward) ' ;;
		tunnels) cat "$STATE/tunnels/$2.rec" 2>/dev/null ;;
		keys)    cat "$2" ;;
	esac
}

# ---- host actions -------------------------------------------------------
_connect() { "$SSH" "$1"; exit 0; }

_copyid() {
	have ssh-copy-id || { err "ssh-copy-id not found"; return; }
	ssh-copy-id "$1" || err "ssh-copy-id failed"
}

_forget() {
	h=$(_hosts | awk -F'\t' -v a="$1" '$1 == a { print ($2 != "" ? $2 : a); exit }')
	ssh-keygen -R "${h:-$1}" >/dev/null 2>&1 && echo "forgot the host key of ${h:-$1}" || echo "no host key for ${h:-$1}"
}

_put() {
	printf 'file or directory to upload to %s: ' "$1" >&2; read -r src </dev/tty
	[ -n "$src" ] && [ -e "$src" ] || { err "no such path: $src"; return; }
	printf 'remote directory [~]: ' >&2; read -r dst </dev/tty
	if have rsync; then rsync -avP -e "$SSH" -- "$src" "$1:${dst:-~}/" || err "upload failed"
	else scp -r -- "$src" "$1:${dst:-~}/" || err "upload failed"; fi
}
_get() {
	printf 'remote path on %s: ' "$1" >&2; read -r src </dev/tty
	[ -n "$src" ] || return
	printf 'local directory [.]: ' >&2; read -r dst </dev/tty
	if have rsync; then rsync -avP -e "$SSH" -- "$1:$src" "${dst:-.}/" || err "download failed"
	else scp -r -- "$1:$src" "${dst:-.}/" || err "download failed"; fi
}

_mount() {
	have sshfs || { err "sshfs not found (install sshfs)"; return; }
	mkdir -p "$MOUNT_DIR/$1"
	mountpoint -q "$MOUNT_DIR/$1" && { echo "$1 is already mounted"; return; }
	sshfs "$1:" "$MOUNT_DIR/$1" && echo "mounted at $MOUNT_DIR/$1" || err "sshfs failed"
}
_umount() {
	mountpoint -q "$MOUNT_DIR/$1" 2>/dev/null || { echo "$1 is not mounted"; return; }
	fusermount3 -u "$MOUNT_DIR/$1" 2>/dev/null || fusermount -u "$MOUNT_DIR/$1" 2>/dev/null || umount "$MOUNT_DIR/$1" || err "unmount failed"
}

_addhost() {
	eval "$(lt_wizard <<'X'
alias|Name to type (ssh NAME)
host|Host name or address
user|User (empty = your current user)
port|Port (empty = 22)
key|Private key path (empty = ssh default)
X
)" || return
	[ -n "${alias:-}" ] && [ -n "${host:-}" ] || return
	case $alias in *[!A-Za-z0-9._-]*) err "alias may only contain letters, digits . _ -"; return ;; esac
	_hosts | cut -f1 | grep -qxF -- "$alias" && { err "$alias already exists in $CONFIG"; return; }
	mkdir -p "$(dirname "$CONFIG")"; _backup
	{ printf '\nHost %s\n    HostName %s\n' "$alias" "$host"
	  [ -n "$user" ] && printf '    User %s\n' "$user"
	  [ -n "$port" ] && printf '    Port %s\n' "$port"
	  [ -n "$key" ] && printf '    IdentityFile %s\n' "$key"; } >>"$CONFIG"
	chmod 600 "$CONFIG" 2>/dev/null
	echo "added $alias to $CONFIG (backup kept)"
}

_rmhost() {
	lt_confirm "remove the Host $1 block from $CONFIG?" || return
	_backup
	awk -v a="$1" '
	tolower($1) == "host" { skip = 0; for (i = 2; i <= NF; i++) if ($i == a && NF == 2) skip = 1 }
	!skip { print }' "$CONFIG" >"$CONFIG.tmp.$$" && cat "$CONFIG.tmp.$$" >"$CONFIG"; rm -f "$CONFIG.tmp.$$"
	echo "removed $1 (backup kept)"
}

# ---- tunnels -------------------------------------------------------------
_tunnel() {
	h=$1
	eval "$(lt_wizard <<'X'
lport|Local port
rhost|Remote host as the server sees it (empty = localhost)
rport|Remote port
X
)" || return
	rhost=${rhost:-localhost}
	case $lport$rport in '' | *[!0-9]*) err "ports must be numbers"; return ;; esac
	[ -n "$lport" ] && [ -n "$rport" ] || { err "both ports are needed"; return; }
	mkdir -p "$STATE/tunnels"; id=$(printf '%s-%s' "$h" "$lport" | tr -c 'A-Za-z0-9._-' _)
	sock=$STATE/$id.sock
	if "$SSH" -f -N -M -S "$sock" -o ExitOnForwardFailure=yes -L "$lport:$rhost:$rport" "$h"; then
		printf 'HOST=%s\nLPORT=%s\nRHOST=%s\nRPORT=%s\nSOCK=%s\n' "$h" "$lport" "$rhost" "$rport" "$sock" >"$STATE/tunnels/$id.rec"
		echo "tunnel up: localhost:$lport -> $h -> $rhost:$rport"
	else err "could not open the tunnel"; fi
}
_stoptunnel() {
	for id in "$@"; do
		f=$STATE/tunnels/$id.rec; [ -f "$f" ] || continue
		. "$f"
		"$SSH" -S "$SOCK" -O exit "$HOST" >/dev/null 2>&1
		rm -f "$f" "$SOCK"; echo "stopped tunnel to $HOST (local port $LPORT)"
	done
}

# ---- keys ----------------------------------------------------------------
_newkey() {
	printf 'key name [id_ed25519_new]: ' >&2; read -r n </dev/tty; n=${n:-id_ed25519_new}
	case $n in */* ) err "no slashes in the name"; return ;; esac
	[ -e "$HOME/.ssh/$n" ] && { err "$HOME/.ssh/$n already exists"; return; }
	mkdir -p -m 700 "$HOME/.ssh"; ssh-keygen -t ed25519 -f "$HOME/.ssh/$n" -C "$(id -un)@$(hostname)" || err "ssh-keygen failed"
}
_showkey() { { cat "$1"; ssh-keygen -lf "$1"; } | ${PAGER:-less -R}; }
_copykey() {
	if [ -n "${WAYLAND_DISPLAY:-}" ] && have wl-copy; then wl-copy <"$1" && echo "copied $(basename "$1")"
	elif have xclip; then xclip -selection clipboard <"$1" && echo "copied $(basename "$1")"
	else err "no clipboard tool (wl-copy or xclip)"; fi
}
_agentadd() { ssh-add "${1%.pub}" || err "ssh-add failed"; }

# ---- dispatch ------------------------------------------------------------
_do() {
	act=$1; shift
	case $act in
		connect) _connect "$1" ;;
		copyid | forget | put | get | mount | umount | tunnel | rmhost) "_$act" "$1" ;;
		addhost) _addhost ;;
		stoptunnel) _stoptunnel "$@" ;;
		newkey) _newkey ;;
		showkey | copykey | agentadd) "_$act" "$1" ;;
		edit) ${EDITOR:-${VISUAL:-vi}} "$CONFIG" ;;
	esac
	[ "$ERR" = 1 ] && pause
	exit 0
}

case ${1:-} in
	_rows)     _rows_"$2"; exit 0 ;;
	_probe)    _rows_hosts_probe; exit 0 ;;
	_preview)  shift; _preview "$@"; exit 0 ;;
	_do)       shift; _do "$@" ;;
	-h | --help) sed -n '2,/^# <\/manwriter>/p' "$0" | sed 's/^# \{0,1\}//; /manwriter>/d'; exit 0 ;;
esac

view=${1:-hosts}
case $view in hosts | tunnels | keys) ;; *) echo "usage: ezssh [hosts|tunnels|keys]" >&2; exit 2 ;; esac
case $view in hosts) nxt=tunnels prv=keys ;; tunnels) nxt=keys prv=hosts ;; keys) nxt=hosts prv=tunnels ;; esac
TABS="tab: >$SELF $nxt # Tab: $nxt
btab: >$SELF $prv"

case $view in
hosts) LT_KEYS="enter:  !$SELF _do connect       # Connect
alt-t:  !$SELF _do tunnel        # Tunnel
alt-c:  !$SELF _do copyid        # Copy key
alt-f:  !$SELF _do put           # Upload
alt-g:  !$SELF _do get           # Download
alt-m:  !$SELF _do mount         # Mount
alt-u:  !$SELF _do umount        # Unmount
---
alt-k:  !$SELF _do forget        # Forget host key
alt-n:  !$SELF _do addhost       # Add host
ctrl-d: !$SELF _do rmhost        # Remove host
alt-e:  !$SELF _do edit          # Edit config
$TABS" ;;
tunnels) LT_KEYS="ctrl-x: !$SELF _do stoptunnel   # Stop
$TABS" ;;
keys) LT_KEYS="enter:  !$SELF _do showkey        # Show
alt-y:  !$SELF _do copykey       # Copy
alt-a:  !$SELF _do agentadd      # Add to agent
alt-n:  !$SELF _do newkey        # New key
$TABS" ;;
esac
export LT_KEYS
MORE=
[ "$view" = hosts ] && MORE="$SELF _probe"
if [ -n "$MORE" ]; then
	lt_select --mode select --refresh "$REFRESH_MS" --more "$MORE" --header "ssh · $view" --prompt 'search> ' --nth 2 \
		--seed "$SELF _rows $view" --preview "$SELF _preview $view" --keys - >/dev/null || true
else
	lt_select --mode select --refresh "$REFRESH_MS" --header "ssh · $view" --prompt 'search> ' --nth 2 \
		--seed "$SELF _rows $view" --preview "$SELF _preview $view" --keys - >/dev/null || true
fi
