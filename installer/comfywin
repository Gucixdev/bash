#!/usr/bin/env python3
"""comfywin - ComfyUI in one native window (WebKitGTK), not a new browser tab every time.

  comfywin [url]     # default http://127.0.0.1:8188/ ; a second call focuses the open window

Single instance: Gtk.Application with a fixed id, so launching again raises the same window.
Needs python-gobject + webkit2gtk-4.1. comfysetup uses it when present, Firefox otherwise.
"""
import sys, gi
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, WebKit2

URL = sys.argv[1] if len(sys.argv) > 1 else "http://127.0.0.1:8188/"


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.gucixdev.comfywin")
        self.win = None

    def do_activate(self):
        if self.win:
            self.win.present(); return
        self.win = Gtk.ApplicationWindow(application=self, title="ComfyUI")
        self.win.set_default_size(1400, 900)
        view = WebKit2.WebView()
        view.load_uri(URL)
        self.win.add(view)
        self.win.show_all()


sys.exit(App().run([sys.argv[0]]))
