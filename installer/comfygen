#!/usr/bin/env python3
"""comfygen - prompt in, pixel-art asset out, through a running ComfyUI (comfysetup starts it).

  comfygen "a small wooden house" assets/house.png                  # painted side-view asset, 256 px, transparent background
  comfygen --style pixel -s 64 -c 16 "blue worker with a hammer" out/worker.png

Pipeline: DreamShaper 8 (SD1.5) txt2img 512x512, white-background prompt -> background flood-filled transparent from the corner ->
trim -> resize (lanczos painted, nearest + palette cut for pixel). Needs ImageMagick. Stdlib only. Exit 0 = file written.
"""
import argparse, json, os, shutil, subprocess, sys, time, urllib.request, urllib.parse, tempfile

CKPT = "DreamShaper_8_pruned.safetensors"
STYLES = {
    "painted": "2D game asset, hand-painted stylized art, clean dark outline, rich colours, flat front view like a side-scrolling platformer, "
               "single object centered, isolated on a plain solid white background, no ground, no shadow",
    "paint": "crude MS Paint drawing, childlike amateur doodle, thick wobbly black outline, flat solid colours, no shading, no gradients, "
             "very simple shapes, low detail, grotesque cartoon, like The Binding of Isaac and Fear and Hunger, single object centered, "
             "plain solid white background",
    "pixel": "pixel art, 16-bit sprite, side view, flat colours, clean outline, single object centered, plain solid white background",
}
PAINT_NEG = "realistic, detailed, shading, soft shadows, gradient, 3d, painterly, textured, photo, rendered, smooth, glossy, intricate, "
NEG = ("isometric, top-down, perspective, 3d render, photo, realistic, blurry, text, watermark, frame, border, signature, "
       "multiple objects, cropped, ground, grass, shadow, gradient background, splash, swirl, abstract shapes, paint splatter, "
       "background elements, floating objects, extra weapons")

def workflow(prompt, seed, steps, ckpt, style="painted", neg="", ref=None, ref_w=0.9):
    w = {
        "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": ckpt}},
        "2": {"class_type": "CLIPTextEncode", "inputs": {"text": f"{prompt}, {STYLES[style]}", "clip": ["1", 1]}},
        "3": {"class_type": "CLIPTextEncode", "inputs": {"text": NEG + (", " + PAINT_NEG if style == "paint" else "") + (", " + neg if neg else ""), "clip": ["1", 1]}},
        "4": {"class_type": "EmptyLatentImage", "inputs": {"width": 512, "height": 512, "batch_size": 1}},
        "5": {"class_type": "KSampler", "inputs": {"model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0],
              "seed": seed, "steps": steps, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0}},
        "6": {"class_type": "VAEDecode", "inputs": {"samples": ["5", 0], "vae": ["1", 2]}},
        "7": {"class_type": "SaveImage", "inputs": {"images": ["6", 0], "filename_prefix": "comfygen"}},
    }
    if ref:   # style anchor: IP-Adapter feeds the reference picture's look into the model
        w["10"] = {"class_type": "LoadImage", "inputs": {"image": ref}}
        w["11"] = {"class_type": "IPAdapterModelLoader", "inputs": {"ipadapter_file": "ip-adapter_sd15.safetensors"}}
        w["12"] = {"class_type": "CLIPVisionLoader", "inputs": {"clip_name": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors"}}
        w["13"] = {"class_type": "IPAdapterAdvanced", "inputs": {"model": ["1", 0], "ipadapter": ["11", 0], "image": ["10", 0], "clip_vision": ["12", 0],
                   "weight": ref_w, "weight_type": "style transfer", "combine_embeds": "concat", "start_at": 0.0, "end_at": 1.0, "embeds_scaling": "V only"}}
        w["5"]["inputs"]["model"] = ["13", 0]
    return w

def upload(url, path):
    """put the reference picture into ComfyUI's input folder; returns the name LoadImage takes"""
    name = "ref_" + os.path.basename(path)
    bd = "----comfygen"
    body = (f"--{bd}\r\nContent-Disposition: form-data; name=\"image\"; filename=\"{name}\"\r\nContent-Type: image/png\r\n\r\n").encode() \
        + open(path, "rb").read() + f"\r\n--{bd}\r\nContent-Disposition: form-data; name=\"overwrite\"\r\n\r\ntrue\r\n--{bd}--\r\n".encode()
    req = urllib.request.Request(url + "/upload/image", data=body, headers={"Content-Type": f"multipart/form-data; boundary={bd}"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read())["name"]


def call(url, data=None):
    req = urllib.request.Request(url, data=None if data is None else json.dumps(data).encode(), headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read()

def magick():
    for n in ("magick", "convert"):
        if shutil.which(n):
            return n
    sys.exit("comfygen: ImageMagick (magick or convert) not found")

def main():
    a = argparse.ArgumentParser()
    a.add_argument("prompt"); a.add_argument("out")
    a.add_argument("--style", choices=list(STYLES), default="painted")
    a.add_argument("-s", "--size", type=int, default=None, help="longest side; default 256 painted, 64 pixel"); a.add_argument("-c", "--colors", type=int, default=None, help="pixel style only; default 16")
    a.add_argument("--seed", type=int, default=None); a.add_argument("--steps", type=int, default=28)
    a.add_argument("--url", default=os.environ.get("COMFYUI_URL", "http://127.0.0.1:8188")); a.add_argument("--ckpt", default=CKPT)
    a.add_argument("--raw", action="store_true", help="also keep the untouched 512 px image next to the output (.raw.png)")
    a.add_argument("--ref", help="reference picture for the style (IP-Adapter); one anchor for every asset"); a.add_argument("--ref-weight", type=float, default=0.9)
    a.add_argument("--neg", default="", help="extra negative prompt terms, appended")
    a.add_argument("--dump-workflow", metavar="FILE", help="write the API-format workflow JSON to FILE and exit (comfyflow turns it into a graph you can open in the UI)")
    o = a.parse_args()
    seed = o.seed if o.seed is not None else int(time.time()) % 2**31
    refname = upload(o.url, o.ref) if o.ref else None
    if o.dump_workflow:
        json.dump(workflow(o.prompt, seed, o.steps, o.ckpt, o.style, o.neg, refname, o.ref_weight), open(o.dump_workflow, "w"), indent=1)
        return
    try:
        pid = json.loads(call(o.url + "/prompt", {"prompt": workflow(o.prompt, seed, o.steps, o.ckpt, o.style, o.neg, refname, o.ref_weight)}))["prompt_id"]
    except Exception as e:
        sys.exit(f"comfygen: cannot queue on {o.url}: {e}")
    t0 = time.time()
    while True:
        h = json.loads(call(f"{o.url}/history/{pid}"))
        if pid in h and h[pid].get("outputs"):
            break
        if pid in h and h[pid].get("status", {}).get("status_str") == "error":
            msgs = [m for m in h[pid]["status"].get("messages", []) if m and m[0] == "execution_error"]
            sys.exit("comfygen: ComfyUI failed: " + (msgs[0][1].get("exception_message", "?").strip()[:300] if msgs else "see its log"))
        if time.time() - t0 > 900:
            sys.exit("comfygen: timed out after 15 min")
        time.sleep(1.5)
    img = h[pid]["outputs"]["7"]["images"][0]
    raw = call(o.url + "/view?" + urllib.parse.urlencode({"filename": img["filename"], "subfolder": img["subfolder"], "type": img["type"]}))
    os.makedirs(os.path.dirname(os.path.abspath(o.out)), exist_ok=True)
    tmp = tempfile.NamedTemporaryFile(suffix=".png", delete=False); tmp.write(raw); tmp.close()
    if o.raw:
        shutil.copy(tmp.name, o.out.rsplit(".", 1)[0] + ".raw.png")
    m = magick()
    size = o.size or {"painted": 256, "paint": 192}.get(o.style, 64)
    cmd = [m, tmp.name] + (["-shave", "8x8"] if o.style == "paint" else []) + ["-fuzz", "12%" if o.style == "painted" else "18%", "-fill", "none", "-draw", "color 0,0 floodfill", "-trim", "+repage"]
    if o.style == "paint":   # MS Paint look: hard edges, few flat colours, no dithering
        cmd += ["-filter", "point", "-resize", f"{size}x{size}", "+dither", "-colors", str(o.colors or 20), o.out]
    elif o.style == "pixel":
        cmd += ["-filter", "point", "-resize", f"{size}x{size}", "-colors", str(o.colors or 16), o.out]
    else:
        cmd += ["-filter", "lanczos", "-resize", f"{size}x{size}", o.out]
    subprocess.run(cmd, check=True)
    os.unlink(tmp.name)
    print(f"{o.out}  seed={seed}  {time.time()-t0:.0f}s")

main()
