#!/usr/bin/env bash
# sprite2grid - put many sprite images into one grid (sprite sheet) and say where each one went.
#
#   sprite2grid [-c COLS] [-p PAD] [-o grid.png] SPRITE.png...
#
#   -c COLS   columns of the grid (default: as square as possible)
#   -p PAD    transparent pixels between cells and around the sheet (default 0)
#   -o FILE   output image (default grid.png); FILE.tsv is written next to it
#
# Every cell has the size of the biggest sprite; smaller sprites sit in the top-left of their cell, transparent
# around. The .tsv has one line per sprite in order: index, file, column, row, x, y, w, h (w and h of the sprite itself),
# so a game engine can cut the sheet again. Needs ImageMagick. Exit: 0 fine, 1 failed, 2 bad usage.
set -u
case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac

die() { printf 'sprite2grid: %s\n' "$*" >&2; exit "${2:-2}"; }
cols=0 pad=0 out=grid.png
while getopts c:p:o: o; do
	case $o in
	c) cols=$OPTARG ;;
	p) pad=$OPTARG ;;
	o) out=$OPTARG ;;
	*) die "usage: sprite2grid [-c COLS] [-p PAD] [-o grid.png] SPRITE.png..." ;;
	esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || die "usage: sprite2grid [-c COLS] [-p PAD] [-o grid.png] SPRITE.png..."
[[ $cols =~ ^[0-9]+$ ]] || die "-c needs a number"
[[ $pad =~ ^[0-9]+$ ]] || die "-p needs a number"
command -v magick > /dev/null || die "ImageMagick (magick) is not installed" 1
files=()
for f in "$@"; do
	[ -f "$f" ] || die "no such file: $f" 1
	case $f in -*) files+=("./$f") ;; *) files+=("$f") ;; esac   # a name starting with - is not an option
done
set -- "${files[@]}"

n=$#
[ "$cols" -gt 0 ] || cols=$(awk -v n="$n" 'BEGIN { c = int(sqrt(n)); if (c * c < n) c++; print c }')
[ "$cols" -le "$n" ] || cols=$n
rows=$(((n + cols - 1) / cols))

# sizes of every sprite (first frame only), then the biggest one is the cell
sizes=$(magick identify -format '%[fx:w] %[fx:h]\n' "${@/%/[0]}" 2> /dev/null) || die "cannot read one of the images" 1
[ "$(printf '%s\n' "$sizes" | wc -l)" -eq "$n" ] || die "cannot read one of the images" 1
cw=$(printf '%s\n' "$sizes" | awk '$1 > m { m = $1 } END { print m }')
ch=$(printf '%s\n' "$sizes" | awk '$2 > m { m = $2 } END { print m }')
W=$((cols * cw + (cols + 1) * pad))
H=$((rows * ch + (rows + 1) * pad))

args=(-size "${W}x${H}" xc:none)
tsv=$(mktemp) || die "no temp file" 1
trap 'mv "$tsv" "${TMPDIR:-/tmp}/sprite2grid.tsv.$$" 2> /dev/null' EXIT
i=0
for f in "$@"; do
	c=$((i % cols)) r=$((i / cols))
	x=$((pad + c * (cw + pad))) y=$((pad + r * (ch + pad)))
	read -r w h <<< "$(printf '%s\n' "$sizes" | sed -n "$((i + 1))p")"
	args+=("${f}[0]" -geometry "+${x}+${y}" -composite)
	printf '%d\t%s\t%d\t%d\t%d\t%d\t%d\t%d\n' "$i" "$f" "$c" "$r" "$x" "$y" "$w" "$h" >> "$tsv"
	i=$((i + 1))
done
# write to a temp name first so a failed run never leaves a half sheet under the real name
part="$out.part.$$"
magick "${args[@]}" "png:$part" || { mv "$part" "${TMPDIR:-/tmp}/sprite2grid.part.$$" 2> /dev/null; die "ImageMagick failed" 1; }
mv "$part" "$out" && cp "$tsv" "$out.tsv" && mv "$out.tsv" "${out%.*}.tsv" || die "cannot write $out" 1
printf '%s: %d sprites, %d x %d cells of %dx%d, sheet %dx%d, map %s\n' "$out" "$n" "$cols" "$rows" "$cw" "$ch" "$W" "$H" "${out%.*}.tsv"
