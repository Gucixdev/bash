# Project-wide shellcheck settings. Each disable is deliberate:
#
# SC1007  `a= b=` is the idiom for "set several vars to empty" (lt_select, vm_load).
# SC1090  sourcing a per-VM / per-user config file chosen at run time.
# SC1091  /etc/os-release and friends are not in the repo.
# SC2089/SC2090
#         LT_KEYS holds quoting that is meant to be re-parsed later by the
#         `sh -c` fzf runs for a key binding, not expanded here.
disable=SC1007,SC1090,SC1091,SC2089,SC2090
