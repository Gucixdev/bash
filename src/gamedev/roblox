#!/usr/bin/env bash
# roblox - make a Roblox game from the command line: a Rojo project, checks, a place file. Publishing is roblox_publish.
#
#   roblox new NAME        scaffold ./NAME: default.project.json, src/ (server script, shared module, client script),
#                          selene.toml, roblox.conf, .gitignore, README. Existing files are never overwritten.
#   roblox check           run luau-analyze, selene and stylua --check over src/ for each one that is installed
#                          (a missing one is named and skipped), plus a built-in check that the project file is
#                          there and every "$path" in it exists. luau-analyze has no Roblox API definitions, so it
#                          reports globals such as `game` as unknown; the scaffold marks its scripts `--!nocheck`
#                          (syntax errors still show), remove that line to get type checking.
#   roblox build           rojo build -o build/NAME.rbxl (NAME is the "name" in default.project.json)
#   roblox publish ...     runs roblox_publish, its own file: the Open Cloud upload (a dry run unless --yes) and its key
#                          live only there, so building and checking never touch them.
#   roblox -h | --help
#
# Run these inside the project folder. Nothing asks a question.
#
# Getting the tools (nothing is installed by this script)
#   rojo           rokit add rojo-rbx/rojo   |   cargo install rojo --version ^7   |  binary from
#                  https://github.com/rojo-rbx/rojo/releases  |  an agx download row (agx add)
#   luau-analyze   release archive of https://github.com/luau-lang/luau (put it on PATH)
#   selene, stylua cargo install selene stylua   (or the GitHub releases)
#
# Exit status: 0 done (or checks skipped because no checker is installed); 1 a check or the build failed; 2 bad
# usage; 3 something needed is missing (project file, rojo).
#
# Verified against the docs on 2026-11-16: rojo build -o, the
# .luau script suffixes (Rojo 7.2+), stylua --check, luau-analyze FILE. Not verified: selene's exact CLI and
# `std = "roblox"` in selene.toml (written from memory), rojo's default.project.json for this layout.

case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac

set -u

say() { printf 'roblox: %s\n' "$*"; }
warn() { printf 'roblox: %s\n' "$*" >&2; }
die() { local rc=$1; shift; printf 'roblox: %s\n' "$*" >&2; exit "$rc"; }
have() { command -v "$1" > /dev/null 2>&1; }

PROJECT=default.project.json

need_project() {
	[ -f "$PROJECT" ] || die 3 "no $PROJECT here; run inside a project folder or 'roblox new NAME' first"
}

project_name() {
	local n
	n=$(sed -n 's/^[[:space:]]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PROJECT" | head -n 1)
	[ -n "$n" ] || die 3 "no \"name\" in $PROJECT"
	printf '%s\n' "$n" | tr -c 'A-Za-z0-9_.\n-' '_'
}

# put FILE: write stdin to FILE unless it already exists (so 'new' can be run again safely).
put() {
	if [ -e "$1" ] || [ -L "$1" ]; then	# -L: a dangling symlink must not be written through
		say "kept $1"
		cat > /dev/null
	else
		{ mkdir -p -- "$(dirname -- "$1")" && cat > "$1"; } || die 1 "cannot write $1"
		say "created $1"
	fi
}

cmd_new() {
	[ $# -eq 1 ] || die 2 "usage: roblox new NAME"
	local name=$1
	case $name in *[!A-Za-z0-9_-]* | '') die 2 "NAME may only contain letters, digits, - and _" ;; esac
	mkdir -p -- "$name" || die 1 "cannot create $name"
	cd -- "$name" || die 1 "cannot enter $name"

	put default.project.json << EOF
{
  "name": "$name",
  "tree": {
    "\$className": "DataModel",
    "ServerScriptService": { "\$path": "src/ServerScriptService" },
    "ReplicatedStorage": { "\$path": "src/ReplicatedStorage" },
    "StarterPlayer": {
      "\$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "\$className": "StarterPlayerScripts",
        "\$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },
    "Workspace": {
      "\$className": "Workspace",
      "Baseplate": {
        "\$className": "Part",
        "\$properties": {
          "Anchored": true,
          "Locked": true,
          "Position": [0, -10, 0],
          "Size": [512, 20, 512]
        }
      }
    }
  }
}
EOF
	put src/ReplicatedStorage/Greeting.luau << 'EOF'
--!nocheck
-- A ModuleScript: any plain .luau file. Shared by server and client.
local Greeting = {}

function Greeting.make(name: string): string
	return "Hello, " .. name .. "!"
end

return Greeting
EOF
	put src/ServerScriptService/Main.server.luau << 'EOF'
--!nocheck
-- A Script: *.server.luau. Greets every player that joins.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Greeting = require(ReplicatedStorage.Greeting)

Players.PlayerAdded:Connect(function(player)
	print(Greeting.make(player.Name))
end)
EOF
	put src/StarterPlayer/StarterPlayerScripts/Client.client.luau << 'EOF'
--!nocheck
-- A LocalScript: *.client.luau. Runs on each player's machine.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Greeting = require(ReplicatedStorage:WaitForChild("Greeting"))

print(Greeting.make("client"))
EOF
	put selene.toml << 'EOF'
std = "roblox"
EOF
	put roblox.conf << 'EOF'
# Open Cloud ids for roblox_publish (environment variables of the same name win). No API key here:
# it comes from ROBLOX_API_KEY or ~/.secrets.
# ROBLOX_UNIVERSE_ID=
# ROBLOX_PLACE_ID=
# ROBLOX_API=universes
# ROBLOX_VERSION_TYPE=Published
EOF
	put .gitignore << 'EOF'
build/
*.rbxl.lock
.env
sourcemap.json
EOF
	put README.md << EOF
# $name

A Roblox game built with Rojo and the \`roblox\` helper.

    roblox check      lint and format-check src/ with whatever is installed
    roblox build      build/$name.rbxl (needs rojo)
    roblox_publish    DRY RUN: shows the Open Cloud request, key masked
    roblox_publish --yes   really upload

Layout: src/ServerScriptService (*.server.luau), src/ReplicatedStorage (*.luau
modules), src/StarterPlayer/StarterPlayerScripts (*.client.luau).
default.project.json maps them into the game.

Publishing needs ROBLOX_UNIVERSE_ID and ROBLOX_PLACE_ID (environment or
roblox.conf) and an Open Cloud API key in ROBLOX_API_KEY or ~/.secrets, with
the permission \`roblox --help\` names. Keep the key out of this folder.

Live editing: \`rojo serve\` and the Rojo plugin in Studio.
EOF
	say "ready: cd $name && roblox check"
}

cmd_check() {
	[ $# -eq 0 ] || die 2 "usage: roblox check"
	need_project
	local rc=0 ran=0 p files=()

	# built-in: every "$path" in the project file exists
	while IFS= read -r p; do
		[ -n "$p" ] || continue
		if [ -e "$p" ]; then :; else
			warn "$PROJECT points at $p, which does not exist"
			rc=1
		fi
	done < <(grep -o '"\$path"[[:space:]]*:[[:space:]]*"[^"]*"' "$PROJECT" | sed 's/^"[^"]*"[[:space:]]*:[[:space:]]*"//; s/"$//')
	grep -q '"tree"' "$PROJECT" || { warn "$PROJECT has no \"tree\""; rc=1; }
	[ "$rc" -eq 0 ] && say "project file: ok"

	if [ -d src ]; then
		while IFS= read -r -d '' p; do files+=("$p"); done < <(find src \( -name '*.luau' -o -name '*.lua' \) -type f -print0 | sort -z)
	fi

	if have luau-analyze; then
		ran=$((ran + 1))
		if [ ${#files[@]} -eq 0 ]; then say "luau-analyze: no scripts under src/"
		elif luau-analyze "${files[@]}"; then say "luau-analyze: ok"
		else warn "luau-analyze: problems found"; rc=1; fi
	else
		say "luau-analyze not installed: type check skipped (release archive of github.com/luau-lang/luau)"
	fi
	if have selene; then
		ran=$((ran + 1))
		if [ -d src ] && ! selene src; then warn "selene: problems found"; rc=1; else say "selene: ok"; fi
	else
		say "selene not installed: lint skipped (cargo install selene)"
	fi
	if have stylua; then
		ran=$((ran + 1))
		if [ -d src ] && ! stylua --check src; then warn "stylua: formatting differs (run: stylua src)"; rc=1; else say "stylua: ok"; fi
	else
		say "stylua not installed: format check skipped (cargo install stylua)"
	fi
	[ "$ran" -gt 0 ] || say "no checker installed: only the project file was checked"
	exit "$rc"
}

cmd_build() {
	[ $# -eq 0 ] || die 2 "usage: roblox build"
	need_project
	have rojo || die 3 "rojo is not installed. Get it with: rokit add rojo-rbx/rojo  |  cargo install rojo --version ^7  |  a release binary from https://github.com/rojo-rbx/rojo/releases  |  an agx download row (agx add). Nothing was installed."
	local out name
	name=$(project_name) || exit $?	# project_name dies inside $(): without this the build went on as build/.rbxl
	out=build/$name.rbxl
	mkdir -p build || die 1 "cannot create build/"
	if rojo build -o "$out"; then say "built $out"; else die 1 "rojo build failed"; fi
}

[ $# -ge 1 ] || die 2 "usage: roblox new|check|build|publish (roblox --help)"
cmd=$1; shift
case $cmd in
new) cmd_new "$@" ;;
check) cmd_check "$@" ;;
build) cmd_build "$@" ;;
publish) exec "$(dirname -- "$(readlink -f -- "$0")")/roblox_publish" "$@" ;;
*) die 2 "unknown command: $cmd (roblox --help)" ;;
esac
