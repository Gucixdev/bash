#!/bin/sh
# <manwriter>
# ezman - read, write and build man pages in one tool. Built on
# lib/lazytui.sh.
#
#   ezman [SECTION]                  browse every page (below)
#   ezman new NAME SECTION "description" ["FLAG:desc" ...]
#   ezman gen                        build pages from <manwriter> sections
#
# Browsing is fzf over a colourful `ls`-style list of all pages, with a
# live coloured preview and Enter to read the whole page.
#
# Type to filter names and descriptions. Each name is coloured by its
# section like ls colours file types (1 commands green, 2 syscalls red,
# 3 library blue, 4 devices cyan, 5 file formats yellow, 6 games magenta,
# 7 misc white, 8 admin bold red). Your own pages (LOCAL_DIRS, top of the
# script, by default this repo's man/ directory) are listed first,
# marked "local", and open with `man -l`. Bold text in a page shows yellow
# and underlined text cyan.
#
# Alt-1..8 show one section, Alt-0 everything. Alt-S searches the *text*
# of all pages (man -K) and lets you pick from the matches. Without an
# apropos index (run `sudo mandb` once) the list is built from the page
# files instead, without descriptions.
#
# WRITING. `new` scaffolds NAME.SECTION in the current directory in this
# project's own man(7) style: .TH with today's date, NAME, one SYNOPSIS line
# and one OPTIONS entry per "FLAG:description" argument. It writes the
# boilerplate, not the prose: DESCRIPTION and SEE ALSO are left as TODO.
#
#   ezman new cb 1 "clipboard manager" "copy [TEXT]:copy onto the clipboard" "paste:print it"
#
# BUILDING. `gen` writes a page for every script (in housekeep/, this
# directory's parent and lib/) that has a manwriter section: the comment
# block between "# <manwriter>" and "# </manwriter>", like an HTML tag. In
# it the first line is "name - one-line description", "# @flag FLAG:DESC"
# lines become SYNOPSIS/OPTIONS entries, and everything else is the
# DESCRIPTION. Pages go to man/ next to housekeep/ (or housekeep/man).
# Scripts without a section are skipped.
#
# @flag SECTION:only this section (1-8, n, l) instead of all
# @flag new NAME SECTION DESC:scaffold a page in the current directory (FLAG:desc args add options)
# @flag gen:build every page from the scripts' manwriter sections
# @flag ENTER:read the page
# @flag ALT-S:full-text search
# </manwriter>

# ---- edit me ---------------------------------------------------------
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LOCAL_DIRS="${EZMAN_LOCAL:-$HERE/man $HERE/../man}"   # your own pages, *.1 .. *.8
PREVIEW_WINDOW="${EZMAN_PREVIEW:-right,60%,wrap}"
# ----------------------------------------------------------------------

SELF=$HERE/$(basename -- "$0")
# >>> lazytui (vendored from lib/lazytui.sh by ./vendor - edit the library, not this block) >>>
# _lt_hint KEYNAME LABEL -> key caps then LABEL (the nnn hint-bar look). KEYNAME is an fzf key
# (ctrl-r, alt-enter, ctrl-alt-x, shift-up, f5, space...). Every modifier gets its own coloured cap
# (Ctrl blue, Alt yellow, Shift green), the key itself is a reverse-video cap.
_lt_hint() {
	_lt_h=$1
	while :; do
		case $_lt_h in
			ctrl-?*)  printf '\033[30;44m Ctrl \033[0m'; _lt_h=${_lt_h#ctrl-} ;;
			alt-?*)   printf '\033[30;43m Alt \033[0m'; _lt_h=${_lt_h#alt-} ;;
			shift-?*) printf '\033[30;42m Shift \033[0m'; _lt_h=${_lt_h#shift-} ;;
			*) break ;;
		esac
	done
	case $_lt_h in
		?) _lt_h=$(printf %s "$_lt_h" | tr a-z A-Z) ;;
		enter) _lt_h=Enter ;; esc) _lt_h=Esc ;; tab) _lt_h=Tab ;; btab) _lt_h='Shift+Tab' ;; space) _lt_h=Space ;;
		bspace) _lt_h=Backspace ;; pgup) _lt_h=PgUp ;; pgdn) _lt_h=PgDn ;; del) _lt_h=Del ;;
		up) _lt_h='↑' ;; down) _lt_h='↓' ;; left) _lt_h='←' ;; right) _lt_h='→' ;;
	esac
	printf '\033[7m %s \033[0m %s   ' "$_lt_h" "$2"
}

# _lt_trim STR -> STR without leading/trailing blanks
_lt_trim() { printf %s "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

# _lt_script FILE CMD -> FILE runs CMD "$@" (keeps quoting out of fzf binds)
_lt_script() { printf '%s "$@"\n' "$2" >"$1"; }

lt_select() {
	_lt_mode=raw _lt_refresh=${LT_REFRESH:-0} _lt_seed= _lt_more= _lt_reload= _lt_preview= _lt_keys= \
	_lt_key=1 _lt_nth= _lt_header= _lt_prompt='> '
	while [ $# -gt 0 ]; do
		case $1 in
			--mode)    _lt_mode=$2;    shift 2 ;;
			--seed)    _lt_seed=$2;    shift 2 ;;
			--more)    _lt_more=$2;    shift 2 ;;
			--refresh) _lt_refresh=$2; shift 2 ;;
			--reload)  _lt_reload=$2;  shift 2 ;;
			--preview) _lt_preview=$2; shift 2 ;;
			--keys)    _lt_keys=$2;    shift 2 ;;
			--key)     _lt_key=$2;     shift 2 ;;
			--nth)     _lt_nth=$2;     shift 2 ;;
			--header)  _lt_header=$2;  shift 2 ;;
			--prompt)  _lt_prompt=$2;  shift 2 ;;
			*) echo "lt_select: unknown arg $1" >&2; return 2 ;;
		esac
	done
	case $_lt_refresh in '' | *[!0-9]*) echo "lt_select: --refresh wants milliseconds, got '$_lt_refresh'" >&2; return 2 ;; esac
	case $_lt_mode in raw | select) ;; *) echo "lt_select: --mode must be raw or select" >&2; return 2 ;; esac

	_lt_tmp=$(mktemp -d) || return 1
	if [ -n "$_lt_seed" ]; then
		_lt_script "$_lt_tmp/seed.sh" "$_lt_seed"
	else
		cat >"$_lt_tmp/list"
		printf 'cat "%s/list"\n' "$_lt_tmp" >"$_lt_tmp/seed.sh"
	fi

	if ! command -v fzf >/dev/null 2>&1; then
		_lt_fallback; _lt_rc=$?
		rm -rf "$_lt_tmp"; return $_lt_rc
	fi

	TAB=$(printf '\t')
	_lt_k="{+$_lt_key}"
	set -- --delimiter="$TAB" --ansi --prompt="$_lt_prompt" --footer-border=none --layout=reverse-list
	[ -n "$_lt_header" ] && set -- "$@" --header="$_lt_header"
	[ -n "$_lt_nth" ] && set -- "$@" --with-nth="$_lt_nth"
	if [ -n "$_lt_preview" ]; then
		_lt_script "$_lt_tmp/preview.sh" "$_lt_preview"
		set -- "$@" --preview="sh $_lt_tmp/preview.sh {$_lt_key}" \
			--preview-window="${LT_PREVIEW_WINDOW:-down,60%,wrap}"
	fi
	_lt_start=
	if [ -n "$_lt_more" ]; then
		cat >"$_lt_tmp/more.sh" <<EOF
out=\$(mktemp)
$_lt_more > "\$out" 2>/dev/null || true
if [ -s "\$out" ]; then
	curl -s -XPOST "127.0.0.1:\$1" --data "reload(cat \$out; rm -f \$out)" >/dev/null 2>&1 || rm -f "\$out"
else rm -f "\$out"; fi
EOF
		_lt_start="$_lt_start sh $_lt_tmp/more.sh \$FZF_PORT &"
	fi
	if [ "$_lt_refresh" -gt 0 ] && [ -z "$_lt_reload" ] && command -v curl >/dev/null 2>&1; then
		# background loop: run the seed, post it to fzf only when it changed;
		# it ends by itself once fzf's port stops answering
		_lt_secs=$(awk -v ms="$_lt_refresh" 'BEGIN { if (ms < 50) ms = 50; printf "%.3f", ms / 1000 }')
		cat >"$_lt_tmp/refresh.sh" <<EOF
port=\$1; last=$_lt_tmp/last; new=$_lt_tmp/new
sh $_lt_tmp/seed.sh >"\$last" 2>/dev/null
while sleep $_lt_secs; do
	[ -d $_lt_tmp ] || exit 0
	sh $_lt_tmp/seed.sh >"\$new" 2>/dev/null || continue
	cmp -s "\$last" "\$new" && continue
	cp "\$new" "\$last"
	curl -s -m 2 -XPOST "127.0.0.1:\$port" --data "reload-sync(cat $_lt_tmp/last)" >/dev/null 2>&1 || exit 0
done
EOF
		_lt_start="$_lt_start sh $_lt_tmp/refresh.sh \$FZF_PORT &"
		set -- "$@" --track --id-nth="$_lt_key"
	fi
	[ -n "$_lt_start" ] && set -- "$@" --listen --bind="start:execute-silent($_lt_start)"
	if [ -n "$_lt_reload" ]; then
		printf '%s\n' "$_lt_reload" | sed 's/{q}/"$1"/g' >"$_lt_tmp/reload.sh"
		set -- "$@" --bind="change:reload(sh $_lt_tmp/reload.sh {q})"
	fi

	# mode: select = no input line, space marks, / opens search
	_lt_bar= _lt_ubar=
	# our own fzf draws the key hint bar itself (--hints, held modifiers, clickable); others get a footer
	_lt_hints=
	case $(fzf --version 2>/dev/null) in *-c\ *) _lt_hints=1 ;; esac
	if [ "$_lt_mode" = select ]; then
		set -- "$@" --multi --no-input \
			--bind='space:toggle+down # mark,tab:down,btab:up,/:show-input # search' \
			--bind='esc:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo abort || echo "clear-query+hide-input"'
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint space mark)$(_lt_hint / search)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	else
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint type filter)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	fi

	# yaml key map -> binds + key bar
	_lt_n=0
	if [ -n "$_lt_keys" ]; then
		[ "$_lt_keys" = - ] && printf '%s\n' "${LT_KEYS:-}" >"$_lt_tmp/keys" || cat "$_lt_keys" >"$_lt_tmp/keys"
		while IFS= read -r _lt_line || [ -n "$_lt_line" ]; do
			_lt_line=$(_lt_trim "$_lt_line")
			case $_lt_line in '' | '#'*) continue ;; esac
			# a line of just --- starts a new line in the key bar
			[ "$_lt_line" = --- ] && { _lt_ubar="$_lt_ubar
"; _lt_fresh=1; continue; }
			_lt_kn=$(_lt_trim "${_lt_line%%:*}")
			_lt_rest=${_lt_line#*:}
			case $_lt_rest in
				*' # '*) _lt_label=$(_lt_trim "${_lt_rest##* # }"); _lt_act=$(_lt_trim "${_lt_rest% # *}") ;;
				*)       _lt_label=; _lt_act=$(_lt_trim "$_lt_rest") ;;
			esac
			_lt_n=$((_lt_n + 1))
			_lt_reloadact="+reload(sh $_lt_tmp/seed.sh)"
			case $_lt_act in
				refresh)  _lt_bind="reload(sh $_lt_tmp/seed.sh)" ;;
				quit)     _lt_bind=abort ;;
				'!'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#!}"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)$_lt_reloadact" ;;
				'>'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#>}"
				          _lt_bind="become(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
				accept | select-all | deselect-all | toggle | toggle-all | first | last | up | down | page-up | page-down | abort | clear-query | show-input | hide-input)
				          _lt_bind=$_lt_act ;;
				*)        _lt_script "$_lt_tmp/a$_lt_n.sh" "$_lt_act"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
			esac
			if [ -n "$_lt_hints" ] && [ -n "$_lt_label" ]; then set -- "$@" --bind="$_lt_kn:$_lt_bind # $_lt_label"
			else set -- "$@" --bind="$_lt_kn:$_lt_bind"; fi
			if [ -n "$_lt_label" ]; then
				_lt_ubar="$_lt_ubar$(_lt_hint "$_lt_kn" "$_lt_label")"
				_lt_fresh=
			fi
		done <"$_lt_tmp/keys"
	fi
	# defaults on line one, the key map's labels on line two
	if [ -n "$_lt_hints" ]; then set -- "$@" --hints
	else set -- "$@" --footer="$_lt_bar${_lt_ubar:+
$_lt_ubar}"; fi

	_lt_sel=$(sh "$_lt_tmp/seed.sh" | fzf "$@"); _lt_rc=$?
	rm -rf "$_lt_tmp"
	[ $_lt_rc -eq 0 ] || return 1
	[ -n "$_lt_sel" ] && printf '%s\n' "$_lt_sel" | cut -f"$_lt_key"
	return 0
}

# numbered prompt when fzf is missing
_lt_fallback() {
	sh "$_lt_tmp/seed.sh" >"$_lt_tmp/fb"
	[ -s "$_lt_tmp/fb" ] || return 1
	awk -F'\t' '{ printf "%3d) %s\n", NR, ($1 == "" ? $0 : $0) }' "$_lt_tmp/fb" | tr '\t' ' ' >&2
	printf 'pick number%s, q to cancel: ' "$([ "$_lt_mode" = select ] && echo 's (space separated)')" >&2
	read -r _lt_ans || return 1
	case $_lt_ans in '' | q) return 1 ;; esac
	for _lt_i in $_lt_ans; do sed -n "${_lt_i}p" "$_lt_tmp/fb"; done | cut -f"$_lt_key"
}

# <<< lazytui <<<
have() { command -v "$1" >/dev/null 2>&1; }
have man || { echo "ezman: man not found" >&2; exit 1; }


# _rows [SECTION] -> KEY<TAB>display
_rows() {
	want=${1:-all}
	for d in $LOCAL_DIRS; do
		[ -d "$d" ] || continue
		for f in "$d"/*.[1-8nl]; do
			[ -f "$f" ] || continue
			b=$(basename -- "$f"); sec=${b##*.}; name=${b%.*}
			[ "$want" = all ] || [ "$want" = "$sec" ] || continue
			desc=$(sed -n '/^\.SH NAME/{n;p;q}' "$f" | sed 's/^[^-]*\\- *//; s/\\//g')
			printf 'local:%s\t\033[1;35mlocal\033[0m \033[1;32m%-22.22s\033[0m \033[32m(%s)\033[0m \033[90m%s\033[0m\n' "$f" "$name" "$sec" "$desc"
		done
	done
	if have apropos && [ -n "$(apropos -l . 2>/dev/null | head -1)" ]; then
		apropos -l . 2>/dev/null
	else
		for p in $(manpath -q 2>/dev/null | tr : ' '); do
			find "$p" -type f -name '*.[1-8nl]*' 2>/dev/null
		done | awk -F/ '{ f = $NF; sub(/\.(gz|bz2|xz|zst)$/, "", f); n = f; sub(/\.[^.]*$/, "", n); s = f; sub(/.*\./, "", s); print n " (" s ") - " }' | sort -u
	fi | awk -v want="$want" '
	function color(s) {
		c = substr(s, 1, 1)
		if (c == "1") return "\033[32m"; if (c == "2") return "\033[31m"; if (c == "3") return "\033[34m"
		if (c == "4") return "\033[36m"; if (c == "5") return "\033[33m"; if (c == "6") return "\033[35m"
		if (c == "8") return "\033[1;31m"; return "\033[37m"
	}
	{
		p = index($0, " ("); if (p == 0) next
		name = substr($0, 1, p - 1); rest = substr($0, p + 2)
		q = index(rest, ")"); if (q == 0) next
		sec = substr(rest, 1, q - 1); desc = substr(rest, q + 1); sub(/^[ -]*/, "", desc)
		if (want != "all" && substr(sec, 1, length(want)) != want) next
		n = split(name, parts, /, /); first = parts[1]
		col = color(sec)
		printf "%s:%s\t      %s%-26.26s\033[0m %s(%s)\033[0m \033[90m%s\033[0m\n", sec, first, col, first, col, sec, desc
	}'
}

# _render KEY -> the page with bold/underline recoloured
_render() {
	k=$1
	export MAN_KEEP_FORMATTING=1 MANWIDTH="${FZF_PREVIEW_COLUMNS:-${MANWIDTH:-80}}"
	case $k in
		local:*) man -l -P cat "${k#local:}" ;;
		path:*)  man -l -P cat "${k#path:}" ;;
		*)       sec=${k%%:*}; name=${k#*:}; man -P cat "$sec" "$name" 2>/dev/null || man -P cat "$name" ;;
	esac 2>&1 | sed 's/_\x08\(.\)/\x1b[36m\1\x1b[0m/g; s/\(.\)\x08\1/\x1b[1;33m\1\x1b[0m/g'
}

_open() {   # KEY
	# less colours the overstrike bold/underline itself through its termcap hooks
	LESS_TERMCAP_md=$(printf '\033[1;33m'); LESS_TERMCAP_us=$(printf '\033[36m')
	LESS_TERMCAP_me=$(printf '\033[0m'); LESS_TERMCAP_ue=$(printf '\033[0m')
	LESS_TERMCAP_so=$(printf '\033[7m'); LESS_TERMCAP_se=$(printf '\033[0m')
	export LESS_TERMCAP_md LESS_TERMCAP_us LESS_TERMCAP_me LESS_TERMCAP_ue LESS_TERMCAP_so LESS_TERMCAP_se
	case $1 in
		local:*) man -l "${1#local:}" ;;
		path:*)  man -l "${1#path:}" ;;
		*)       man "${1%%:*}" "${1#*:}" ;;
	esac
	exit 0
}

_fulltext() {
	printf 'search the text of all man pages for: ' >&2
	read -r term </dev/tty
	[ -n "$term" ] || exit 0
	echo "searching..." >&2
	man -wK -- "$term" 2>/dev/null | sort -u | awk '{
		f = $0; b = f; sub(/.*\//, "", b); sub(/\.(gz|bz2|xz|zst)$/, "", b)
		n = b; sub(/\.[^.]*$/, "", n); s = b; sub(/.*\./, "", s)
		printf "path:%s\t%-26.26s (%s) %s\n", f, n, s, f }' >"${TMPDIR:-/tmp}/ezman.$$"
	if [ ! -s "${TMPDIR:-/tmp}/ezman.$$" ]; then echo "no page mentions '$term'" >&2; pause=1; read -r _ </dev/tty; rm -f "${TMPDIR:-/tmp}/ezman.$$"; exit 0; fi
	key=$(lt_select --seed "cat ${TMPDIR:-/tmp}/ezman.$$" --nth 2 --header "pages containing '$term'" --prompt 'page> ' --preview "$SELF _preview") || { rm -f "${TMPDIR:-/tmp}/ezman.$$"; exit 0; }
	rm -f "${TMPDIR:-/tmp}/ezman.$$"
	[ -n "$key" ] && _open "$key"
	exit 0
}


# _page OUTFILE NAME SECTION DESC BODYFILE [FLAG:desc]... writes one page;
# BODYFILE empty means a TODO description
_page() {
	out=$1 name=$2 section=$3 desc=$4 bodyf=$5; shift 5
	upper=$(printf %s "$name" | tr a-z A-Z)
	{
		printf '.TH %s %s "%s" "caveutils" "caveutils Manual"\n' "$upper" "$section" "$(date +%Y-%m-%d)"
		printf '.SH NAME\n%s \\- %s\n.SH SYNOPSIS\n' "$name" "$desc"
		if [ $# -eq 0 ]; then printf '.B %s\n' "$name"
		else
			first=1
			for spec in "$@"; do
				[ "$first" -eq 1 ] || printf '.br\n'
				first=0
				printf '.B %s %s\n' "$name" "${spec%%:*}"
			done
		fi
		printf '.SH DESCRIPTION\n.B %s\n' "$name"
		if [ -n "$bodyf" ] && [ -s "$bodyf" ]; then
			printf '.nf\n'
			sed -e 's/\\/\\\\/g' -e 's/^\./\\\&./' -e "s/^'/\\\\\\&'/" "$bodyf"
			printf '.fi\n'
		else
			printf 'TODO: real description here.\n'
		fi
		if [ $# -gt 0 ]; then
			printf '.SH OPTIONS\n'
			for spec in "$@"; do printf '.TP\n.B %s\n%s\n' "${spec%%:*}" "${spec#*:}"; done
		fi
		printf '.SH SEE ALSO\nTODO: related tools here.\n'
	} >"$out"
}

_new() {
	[ $# -ge 3 ] || { echo 'usage: ezman new NAME SECTION "description" ["FLAG:desc" ...]' >&2; exit 1; }
	name=$1 section=$2 desc=$3; shift 3
	_page "$name.$section" "$name" "$section" "$desc" "" "$@"
	echo "wrote $name.$section"
	exit 0
}

_gen() {
	outdir="$HERE/man"; [ -d "$HERE/../man" ] && outdir=$(CDPATH= cd -- "$HERE/../man" && pwd)
	mkdir -p "$outdir"
	tmp=$(mktemp -d) || exit 1
	for f in "$HERE"/* "$HERE"/../* "$HERE"/../lib/*; do
		[ -f "$f" ] && [ -x "$f" ] || continue
		n=$(basename -- "$f")
		awk '/^# <\/manwriter>/{exit} f{sub(/^# ?/,""); print} /^# <manwriter>/{f=1}' "$f" >"$tmp/sec"
		[ -s "$tmp/sec" ] || { echo "skip $n (no manwriter section)" >&2; continue; }
		desc=$(head -1 "$tmp/sec" | sed -E 's/^(real )?[A-Za-z0-9_-]+ +- +//')
		grep '^@flag ' "$tmp/sec" | sed 's/^@flag //' >"$tmp/flags"
		sed '1d; /^@flag /d' "$tmp/sec" | cat -s >"$tmp/body"
		set --
		while IFS= read -r l; do set -- "$@" "$l"; done <"$tmp/flags"
		_page "$outdir/$n.1" "$n" 1 "$desc" "$tmp/body" "$@"
		echo "$outdir/$n.1"
	done
	rm -rf "$tmp"
	exit 0
}

case ${1:-} in
	new | write) shift; _new "$@" ;;
	gen | all)   _gen ;;
	_rows)     shift; _rows "$@"; exit 0 ;;
	_preview)  shift; _render "$1"; exit 0 ;;
	_open)     shift; _open "$1" ;;
	_fulltext) _fulltext ;;
	-h | --help) sed -n '2,/^# <\/manwriter>/p' "$0" | sed 's/^# \{0,1\}//; /manwriter>/d'; exit 0 ;;
esac

sec=${1:-all}
LT_KEYS="enter: !$SELF _open              # Read
alt-s: !$SELF _fulltext          # Search text
---
alt-0: >$SELF all                # All
alt-1: >$SELF 1                  # 1 commands
alt-2: >$SELF 2                  # 2 syscalls
alt-3: >$SELF 3                  # 3 library
alt-4: >$SELF 4                  # 4 devices
alt-5: >$SELF 5                  # 5 files
alt-6: >$SELF 6                  # 6 games
alt-7: >$SELF 7                  # 7 misc
alt-8: >$SELF 8                  # 8 admin"
export LT_KEYS LT_PREVIEW_WINDOW="$PREVIEW_WINDOW"
lt_select --seed "$SELF _rows $sec" --nth 2 --header "man pages · section $sec" --prompt 'man> ' \
	--preview "$SELF _preview" --keys - >/dev/null || true
