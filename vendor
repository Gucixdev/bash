#!/usr/bin/env bash
# vendor - keeps every tool in this directory standalone.
#
# lib/lazytui.sh is the ONE source of the lt_* helpers (lt_select, lt_input, ...). A tool must not need the
# library (or any other tool) at run time, so each tool carries its own copy of exactly the functions it uses:
# the block between the two marker lines below, generated from the library with the functions the tool
# calls plus what those need. Edit the library, then run ./vendor to refresh every block. It changes nothing
# else in a tool, and is safe to run again.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

LIB=lib/lazytui.sh
BEGIN='# >>> lazytui (vendored from lib/lazytui.sh by ./vendor - edit the library, not this block) >>>'
END='# <<< lazytui <<<'
[ -f "$LIB" ] || { echo "vendor: $LIB not found" >&2; exit 1; }

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

# split the library into one file per function (with the comment lines right above it) + the order list
awk -v dir="$tmp" '
	/^#/ { cbuf = cbuf $0 "\n"; next }
	/^[A-Za-z_][A-Za-z0-9_]*\(\) *\{/ {
		name = $0; sub(/\(\).*/, "", name)
		out = dir "/fn." name
		printf "%s", cbuf > out; cbuf = ""
		print name >> (dir "/order")
		print $0 >> out
		if ($0 ~ /\}[ \t]*(#.*)?$/ && $0 !~ /\{[ \t]*(#.*)?$/) { close(out); infn = 0 } else infn = 1
		next
	}
	infn { print $0 >> out; if ($0 ~ /^\}/) { close(out); infn = 0 }; next }
	{ cbuf = "" }
' "$LIB"

refs() { grep -oE '\b_?lt_[a-z_]+\b' "$1" 2>/dev/null | sort -u || true; }

n=0
for f in *; do
	[ -f "$f" ] && [ -x "$f" ] && grep -qxF "$BEGIN" "$f" || continue

	# functions the tool calls, then everything those need
	sed "\|^$BEGIN\$|,\|^$END\$|d" "$f" >"$tmp/body"
	refs "$tmp/body" >"$tmp/need"
	while :; do
		: >"$tmp/more"
		while read -r name; do
			[ -f "$tmp/fn.$name" ] && refs "$tmp/fn.$name" >>"$tmp/more"
		done <"$tmp/need"
		sort -u "$tmp/need" "$tmp/more" >"$tmp/next"
		cmp -s "$tmp/next" "$tmp/need" && break
		cp "$tmp/next" "$tmp/need"
	done

	{
		echo "$BEGIN"
		while read -r name; do
			grep -qxF "$name" "$tmp/need" && [ -f "$tmp/fn.$name" ] || continue
			cat "$tmp/fn.$name"; echo
		done <"$tmp/order"
		echo "$END"
	} >"$tmp/block"

	awk -v blk="$tmp/block" -v b="$BEGIN" -v e="$END" '
		$0 == b { while ((getline l < blk) > 0) print l; skip = 1; next }
		$0 == e { skip = 0; next }
		!skip { print }
	' "$f" >"$tmp/new"
	chmod --reference="$f" "$tmp/new"
	if cmp -s "$tmp/new" "$f"; then echo "  $f: up to date"; else mv "$tmp/new" "$f"; echo "  $f: refreshed ($(grep -c '^[a-z_]*() *{' "$tmp/block") functions)"; fi
	n=$((n + 1))
done
echo "vendor: $n tools"
