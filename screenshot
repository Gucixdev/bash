#!/bin/sh
# screenshot - take a screenshot on Wayland or X11 with whatever tools the
# machine has.
#
#   screenshot [-d SECONDS] [-c] [-n] [MODE]
#
#   -d SECONDS  wait before capturing
#   -c          clipboard only: nothing is written to disk
#   -n          no clipboard copy, no notification

# ---- edit me ---------------------------------------------------------
# >>> lazytui (vendored from lib/lazytui.sh by ./vendor - edit the library, not this block) >>>
# _lt_hint KEYNAME LABEL -> key caps then LABEL (the nnn hint-bar look). KEYNAME is an fzf key
# (ctrl-r, alt-enter, ctrl-alt-x, shift-up, f5, space...). Every modifier gets its own coloured cap
# (Ctrl blue, Alt yellow, Shift green), the key itself is a reverse-video cap.
_lt_hint() {
	_lt_h=$1
	while :; do
		case $_lt_h in
			ctrl-?*)  printf '\033[30;44m Ctrl \033[0m'; _lt_h=${_lt_h#ctrl-} ;;
			alt-?*)   printf '\033[30;43m Alt \033[0m'; _lt_h=${_lt_h#alt-} ;;
			shift-?*) printf '\033[30;42m Shift \033[0m'; _lt_h=${_lt_h#shift-} ;;
			*) break ;;
		esac
	done
	case $_lt_h in
		?) _lt_h=$(printf %s "$_lt_h" | tr '[:lower:]' '[:upper:]') ;;
		enter) _lt_h=Enter ;; esc) _lt_h=Esc ;; tab) _lt_h=Tab ;; btab) _lt_h='Shift+Tab' ;; space) _lt_h=Space ;;
		bspace) _lt_h=Backspace ;; pgup) _lt_h=PgUp ;; pgdn) _lt_h=PgDn ;; del) _lt_h=Del ;;
		up) _lt_h='↑' ;; down) _lt_h='↓' ;; left) _lt_h='←' ;; right) _lt_h='→' ;;
	esac
	printf '\033[7m %s \033[0m %s   ' "$_lt_h" "$2"
}

# _lt_trim STR -> STR without leading/trailing blanks
_lt_trim() { printf %s "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

# _lt_script FILE CMD -> FILE runs CMD "$@" (keeps quoting out of fzf binds)
_lt_script() { printf '%s "$@"\n' "$2" >"$1"; }

lt_select() {
	_lt_mode=raw _lt_refresh=${LT_REFRESH:-0} _lt_seed= _lt_more= _lt_reload= _lt_preview= _lt_keys= \
	_lt_key=1 _lt_nth= _lt_header= _lt_prompt='> '
	while [ $# -gt 0 ]; do
		case $1 in
			--mode)    _lt_mode=$2;    shift 2 ;;
			--seed)    _lt_seed=$2;    shift 2 ;;
			--more)    _lt_more=$2;    shift 2 ;;
			--refresh) _lt_refresh=$2; shift 2 ;;
			--reload)  _lt_reload=$2;  shift 2 ;;
			--preview) _lt_preview=$2; shift 2 ;;
			--keys)    _lt_keys=$2;    shift 2 ;;
			--key)     _lt_key=$2;     shift 2 ;;
			--nth)     _lt_nth=$2;     shift 2 ;;
			--header)  _lt_header=$2;  shift 2 ;;
			--prompt)  _lt_prompt=$2;  shift 2 ;;
			*) echo "lt_select: unknown arg $1" >&2; return 2 ;;
		esac
	done
	case $_lt_refresh in '' | *[!0-9]*) echo "lt_select: --refresh wants milliseconds, got '$_lt_refresh'" >&2; return 2 ;; esac
	case $_lt_mode in raw | select) ;; *) echo "lt_select: --mode must be raw or select" >&2; return 2 ;; esac

	_lt_tmp=$(mktemp -d) || return 1
	if [ -n "$_lt_seed" ]; then
		_lt_script "$_lt_tmp/seed.sh" "$_lt_seed"
	else
		cat >"$_lt_tmp/list"
		printf 'cat "%s/list"\n' "$_lt_tmp" >"$_lt_tmp/seed.sh"
	fi

	if ! command -v fzf >/dev/null 2>&1; then
		_lt_fallback; _lt_rc=$?
		rm -rf "$_lt_tmp"; return $_lt_rc
	fi

	TAB=$(printf '\t')
	_lt_k="{+$_lt_key}"
	set -- --delimiter="$TAB" --ansi --prompt="$_lt_prompt" --footer-border=none --layout=reverse-list
	[ -n "$_lt_header" ] && set -- "$@" --header="$_lt_header"
	[ -n "$_lt_nth" ] && set -- "$@" --with-nth="$_lt_nth"
	if [ -n "$_lt_preview" ]; then
		_lt_script "$_lt_tmp/preview.sh" "$_lt_preview"
		set -- "$@" --preview="sh $_lt_tmp/preview.sh {$_lt_key}" \
			--preview-window="${LT_PREVIEW_WINDOW:-down,60%,wrap}"
	fi
	_lt_start=
	if [ -n "$_lt_more" ]; then
		cat >"$_lt_tmp/more.sh" <<EOF
out=\$(mktemp)
$_lt_more > "\$out" 2>/dev/null || true
if [ -s "\$out" ]; then
	curl -s -XPOST "127.0.0.1:\$1" --data "reload(cat \$out; rm -f \$out)" >/dev/null 2>&1 || rm -f "\$out"
else rm -f "\$out"; fi
EOF
		_lt_start="$_lt_start sh $_lt_tmp/more.sh \$FZF_PORT &"
	fi
	if [ "$_lt_refresh" -gt 0 ] && [ -z "$_lt_reload" ] && command -v curl >/dev/null 2>&1; then
		# background loop: run the seed, post it to fzf only when it changed;
		# it ends by itself once fzf's port stops answering
		_lt_secs=$(awk -v ms="$_lt_refresh" 'BEGIN { if (ms < 50) ms = 50; printf "%.3f", ms / 1000 }')
		cat >"$_lt_tmp/refresh.sh" <<EOF
port=\$1; last=$_lt_tmp/last; new=$_lt_tmp/new
sh $_lt_tmp/seed.sh >"\$last" 2>/dev/null
while sleep $_lt_secs; do
	[ -d $_lt_tmp ] || exit 0
	sh $_lt_tmp/seed.sh >"\$new" 2>/dev/null || continue
	cmp -s "\$last" "\$new" && continue
	cp "\$new" "\$last"
	curl -s -m 2 -XPOST "127.0.0.1:\$port" --data "reload-sync(cat $_lt_tmp/last)" >/dev/null 2>&1 || exit 0
done
EOF
		_lt_start="$_lt_start sh $_lt_tmp/refresh.sh \$FZF_PORT &"
		set -- "$@" --track --id-nth="$_lt_key"
	fi
	[ -n "$_lt_start" ] && set -- "$@" --listen --bind="start:execute-silent($_lt_start)"
	if [ -n "$_lt_reload" ]; then
		printf '%s\n' "$_lt_reload" | sed 's/{q}/"$1"/g' >"$_lt_tmp/reload.sh"
		set -- "$@" --bind="change:reload(sh $_lt_tmp/reload.sh {q})"
	fi

	# mode: select = no input line, space marks, / opens search
	_lt_bar= _lt_ubar=
	# our own fzf draws the key hint bar itself (--hints, held modifiers, clickable); others get a footer
	_lt_hints=
	case $(fzf --version 2>/dev/null) in *-c\ *) _lt_hints=1 ;; esac
	if [ "$_lt_mode" = select ]; then
		set -- "$@" --multi --no-input \
			--bind='space:toggle+down # mark,tab:down,btab:up,/:show-input # search' \
			--bind='esc:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo abort || echo "clear-query+hide-input"'
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint space mark)$(_lt_hint / search)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	else
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint type filter)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	fi

	# yaml key map -> binds + key bar
	_lt_n=0
	if [ -n "$_lt_keys" ]; then
		[ "$_lt_keys" = - ] && printf '%s\n' "${LT_KEYS:-}" >"$_lt_tmp/keys" || cat "$_lt_keys" >"$_lt_tmp/keys"
		while IFS= read -r _lt_line || [ -n "$_lt_line" ]; do
			_lt_line=$(_lt_trim "$_lt_line")
			case $_lt_line in '' | '#'*) continue ;; esac
			# a line of just --- starts a new line in the key bar
			[ "$_lt_line" = --- ] && { _lt_ubar="$_lt_ubar
"; _lt_fresh=1; continue; }
			_lt_kn=$(_lt_trim "${_lt_line%%:*}")
			_lt_rest=${_lt_line#*:}
			case $_lt_rest in
				*' # '*) _lt_label=$(_lt_trim "${_lt_rest##* # }"); _lt_act=$(_lt_trim "${_lt_rest% # *}") ;;
				*)       _lt_label=; _lt_act=$(_lt_trim "$_lt_rest") ;;
			esac
			_lt_n=$((_lt_n + 1))
			_lt_reloadact="+reload(sh $_lt_tmp/seed.sh)"
			case $_lt_act in
				refresh)  _lt_bind="reload(sh $_lt_tmp/seed.sh)" ;;
				quit)     _lt_bind=abort ;;
				'!'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#!}"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)$_lt_reloadact" ;;
				'>'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#>}"
				          _lt_bind="become(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
				accept | select-all | deselect-all | toggle | toggle-all | first | last | up | down | page-up | page-down | abort | clear-query | show-input | hide-input)
				          _lt_bind=$_lt_act ;;
				*)        _lt_script "$_lt_tmp/a$_lt_n.sh" "$_lt_act"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
			esac
			if [ -n "$_lt_hints" ] && [ -n "$_lt_label" ]; then set -- "$@" --bind="$_lt_kn:$_lt_bind # $_lt_label"
			else set -- "$@" --bind="$_lt_kn:$_lt_bind"; fi
			if [ -n "$_lt_label" ]; then
				_lt_ubar="$_lt_ubar$(_lt_hint "$_lt_kn" "$_lt_label")"
				_lt_fresh=
			fi
		done <"$_lt_tmp/keys"
	fi
	# defaults on line one, the key map's labels on line two
	if [ -n "$_lt_hints" ]; then set -- "$@" --hints
	else set -- "$@" --footer="$_lt_bar${_lt_ubar:+
$_lt_ubar}"; fi

	_lt_sel=$(sh "$_lt_tmp/seed.sh" | fzf "$@"); _lt_rc=$?
	rm -rf "$_lt_tmp"
	[ $_lt_rc -eq 0 ] || return 1
	[ -n "$_lt_sel" ] && printf '%s\n' "$_lt_sel" | cut -f"$_lt_key"
	return 0
}

# numbered prompt when fzf is missing
_lt_fallback() {
	sh "$_lt_tmp/seed.sh" >"$_lt_tmp/fb"
	[ -s "$_lt_tmp/fb" ] || return 1
	awk -F'\t' '{ printf "%3d) %s\n", NR, ($1 == "" ? $0 : $0) }' "$_lt_tmp/fb" | tr '\t' ' ' >&2
	printf 'pick number%s, q to cancel: ' "$([ "$_lt_mode" = select ] && echo 's (space separated)')" >&2
	read -r _lt_ans || return 1
	case $_lt_ans in '' | q) return 1 ;; esac
	for _lt_i in $_lt_ans; do sed -n "${_lt_i}p" "$_lt_tmp/fb"; done | cut -f"$_lt_key"
}

# <<< lazytui <<<

DIR="${SCREENSHOT_DIR:-$HOME/Pictures}"       # where files go
FORMAT="${SCREENSHOT_FORMAT:-png}"            # png, jpg or ppm (backend permitting)
NAME_FMT="${SCREENSHOT_NAME:-%Y%m%d_%Hh%Mm%Ss}"   # strftime, plus _screenshot.FORMAT
DELAY="${SCREENSHOT_DELAY:-0}"                # seconds to wait before capturing
COPY="${SCREENSHOT_COPY:-1}"                  # 1 = also copy to the clipboard
NOTIFY="${SCREENSHOT_NOTIFY:-1}"              # 1 = desktop notification
MODES="full screen area window active"        # order in the picker
# ----------------------------------------------------------------------

die() { echo "screenshot: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

mode_help() {
	case $1 in
		full)   echo "everything, all monitors" ;;
		screen) echo "one monitor (click to choose)" ;;
		area)   echo "drag a rectangle" ;;
		window) echo "click a visible window" ;;
		active) echo "the focused window" ;;
	esac
}

wayland() { [ -n "${WAYLAND_DISPLAY:-}" ]; }

# ---- geometry helpers (Wayland) --------------------------------------
# print "x,y wxh" rectangles of the visible windows, one per line
window_rects() {
	if have hyprctl && have jq && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
		ws=$(hyprctl monitors -j | jq -c '[.[].activeWorkspace.id]')
		hyprctl clients -j | jq -r --argjson ws "$ws" \
			'.[] | select(.mapped and (.hidden|not) and ([.workspace.id] | inside($ws))) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
	elif have swaymsg && have jq; then
		swaymsg -t get_tree | jq -r '.. | select(.pid? and .visible?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"'
	else
		return 1
	fi
}
active_rect() {
	if have hyprctl && have jq && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
		hyprctl activewindow -j | jq -r 'select(.address) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
	elif have swaymsg && have jq; then
		swaymsg -t get_tree | jq -r '.. | select(.focused? == true) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' | head -1
	else
		return 1
	fi
}

# ---- backends: capture_NAME MODE OUTFILE -----------------------------
capture_grim() {
	mode=$1; out=$2
	case $mode in
		full) grim -t "$FORMAT" "$out" ;;
		screen)
			have slurp || { echo "screenshot: no slurp, using full" >&2; grim -t "$FORMAT" "$out"; return; }
			o=$(slurp -o -f '%o') || return 1
			[ -n "$o" ] || return 1
			sleep_delay; grim -t "$FORMAT" -o "$o" "$out" ;;
		area)
			have slurp || die "area needs slurp"
			g=$(slurp) || return 1
			sleep_delay; grim -t "$FORMAT" -g "$g" "$out" ;;
		window)
			if rects=$(window_rects) && [ -n "$rects" ] && have slurp; then
				g=$(printf '%s\n' "$rects" | slurp -r) || return 1
			else
				echo "screenshot: no window list on this compositor, using area" >&2
				have slurp || die "window needs slurp"
				g=$(slurp) || return 1
			fi
			sleep_delay; grim -t "$FORMAT" -g "$g" "$out" ;;
		active)
			sleep_delay
			g=$(active_rect) && [ -n "$g" ] || { echo "screenshot: can't find the focused window, using full" >&2; grim -t "$FORMAT" "$out"; return; }
			grim -t "$FORMAT" -g "$g" "$out" ;;
	esac
}

capture_x11() {
	mode=$1; out=$2
	if have maim; then
		case $mode in
			full|screen) sleep_delay; maim "$out" ;;
			area)   maim -s "$out"  ;;
			window) maim -s -B -i "$(xdotool selectwindow 2>/dev/null)" "$out" 2>/dev/null || maim -s "$out" ;;
			active) sleep_delay; have xdotool || die "active needs xdotool"; maim -i "$(xdotool getactivewindow)" "$out" ;;
		esac
	elif have scrot; then
		case $mode in
			full|screen) sleep_delay; scrot "$out" ;;
			area|window) scrot -s "$out" ;;
			active)      sleep_delay; scrot -u "$out" ;;
		esac
	else   # ImageMagick import
		case $mode in
			full|screen) sleep_delay; import -window root "$out" ;;
			area|window) import "$out" ;;
			active)      sleep_delay; import -window "$(xdotool getactivewindow 2>/dev/null || echo root)" "$out" ;;
		esac
	fi
}

# desktop tools that write the file themselves, one flag per mode
capture_desktop() {
	mode=$1; out=$2
	if have spectacle; then
		case $mode in
			full) spectacle -b -n -f -o "$out" ;;
			screen) spectacle -b -n -m -o "$out" ;;
			area) spectacle -b -n -r -o "$out" ;;
			window) spectacle -b -n -a -o "$out" ;;
			active) spectacle -b -n -a -o "$out" ;;
		esac
	elif have gnome-screenshot; then
		case $mode in
			full|screen) gnome-screenshot -f "$out" ;;
			area)        gnome-screenshot -a -f "$out" ;;
			window|active) gnome-screenshot -w -f "$out" ;;
		esac
	else   # flameshot has no file flag without its own GUI save: use --path
		case $mode in
			full|screen) flameshot full -p "$(dirname -- "$out")" ;;
			*)           flameshot gui  -p "$(dirname -- "$out")" ;;
		esac
	fi
}

sleep_delay() { [ "$DELAY" -gt 0 ] && sleep "$DELAY"; return 0; }

pick_backend() {
	if wayland && have grim; then echo grim
	elif ! wayland && { have maim || have scrot || have import; }; then echo x11
	elif have spectacle || have gnome-screenshot || have flameshot; then echo desktop
	else return 1
	fi
}

to_clipboard() {   # FILE
	mime=image/png; case $FORMAT in jpg | jpeg) mime=image/jpeg ;; esac
	if wayland && have wl-copy; then wl-copy -t "$mime" <"$1"
	elif have xclip; then xclip -selection clipboard -t "$mime" -i "$1"
	elif have xsel; then echo "screenshot: xsel can't copy images, skipped" >&2
	else return 1; fi
}

# ---- args ------------------------------------------------------------
MODE=
CLIPONLY=0
while [ $# -gt 0 ]; do
	case $1 in
		-d) DELAY=${2:?-d needs seconds}; shift 2 ;;
		-c) CLIPONLY=1; shift ;;
		-n) COPY=0; NOTIFY=0; shift ;;
		-h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
		-*) die "unknown option $1" ;;
		*) MODE=$1; shift ;;
	esac
done
case $DELAY in '' | *[!0-9]*) die "delay must be whole seconds, got '$DELAY'" ;; esac

if [ -z "$MODE" ]; then
	rows=$(for m in $MODES; do printf '%s\t%-8s %s\n' "$m" "$m" "$(mode_help "$m")"; done)
	MODE=$(printf '%s\n' "$rows" | lt_select --nth 2 --header 'screenshot' --prompt 'mode> ') || exit 0
fi
case " $MODES " in *" $MODE "*) ;; *) die "unknown mode '$MODE' (one of: $MODES)" ;; esac

backend=$(pick_backend) || die "no screenshot tool found (wayland: grim slurp; x11: maim, scrot or import)"
if [ "$CLIPONLY" = 1 ]; then
	COPY=1
	tmpd=$(mktemp -d) || die "cannot create a temp dir"
	trap 'rm -rf "$tmpd"' EXIT INT TERM
	out="$tmpd/shot.$FORMAT"
else
	mkdir -p "$DIR" || die "cannot create $DIR"
	base="$DIR/$(date +"$NAME_FMT")_screenshot"
	out="$base.$FORMAT"; n=1
	while [ -e "$out" ]; do n=$((n + 1)); out="$base-$n.$FORMAT"; done
fi

capture_$backend "$MODE" "$out" || { rm -f "$out"; die "cancelled or failed"; }
[ -s "$out" ] || { rm -f "$out"; die "capture produced no file"; }

if [ "$CLIPONLY" = 1 ]; then
	to_clipboard "$out" || die "no clipboard tool (wl-copy or xclip)"
	[ "$NOTIFY" = 1 ] && have notify-send && notify-send -i "$out" "Screenshot copied" "to the clipboard"
	exit 0
fi

echo "$out"
[ "$COPY" = 1 ] && { to_clipboard "$out" || echo "screenshot: no clipboard tool, not copied" >&2; }
[ "$NOTIFY" = 1 ] && have notify-send && notify-send -i "$out" "Screenshot saved" "$out"
exit 0
