#!/bin/sh
# <manwriter>
# real screen lock - invokes this project's own already-vendored
# suckless slock (coreutils/slock/, real, already built - checked by
# hand) instead of reimplementing a screen locker. Falls back to a
# plain `slock` on PATH if the vendored build isn't reachable (e.g.
# this script copied somewhere the repo layout doesn't match).
# </manwriter>

here="$(cd "$(dirname "$0")" && pwd)"
vendored="$here/../../coreutils/slock/slock"

if [ -x "$vendored" ]; then
	exec "$vendored"
elif command -v slock >/dev/null 2>&1; then
	exec slock
else
	echo "no slock binary found (build coreutils/slock, or install slock)"
	exit 1
fi
