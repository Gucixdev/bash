#!/bin/sh
# cleaner - find disk bloat with the real tool for each kind, show what
# would go, ask once.
#
# Covers the package cache, orphaned packages (listed only, never removed
# automatically: that is a judgement call), the systemd journal, container
# images (podman/docker), unused Flatpak runtimes, npm/pip/cargo caches,
# ~/.cache and the freedesktop Trash. A category is skipped when its tool
# is not installed. The package-manager backend is detected at run time:
# pacman, apt, dnf, zypper, apk, xbps or portage.
#
# Nothing is deleted before the dry-run listing and one confirmation.
#
# usage: cleaner

case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac

echo "=== package cache ==="
pm=""
if command -v paccache >/dev/null 2>&1; then
	pm=pacman
	paccache -d -k3
elif command -v apt-get >/dev/null 2>&1; then
	pm=apt
	apt-get -s autoclean 2>&1 | tail -5
elif command -v dnf >/dev/null 2>&1; then
	pm=dnf
	echo "(dnf clean has no real dry-run mode - real cache size below)"
	du -sh /var/cache/dnf 2>/dev/null
elif command -v zypper >/dev/null 2>&1; then
	pm=zypper
	du -sh /var/cache/zypp 2>/dev/null
elif command -v apk >/dev/null 2>&1; then
	pm=apk
	du -sh /var/cache/apk 2>/dev/null
elif command -v xbps-remove >/dev/null 2>&1; then
	pm=xbps
	du -sh /var/cache/xbps 2>/dev/null
elif command -v eclean >/dev/null 2>&1; then
	pm=portage
	eclean -n packages 2>&1 | tail -5
else
	echo "no known package manager cache tool found"
fi

if [ "$pm" = "pacman" ] && command -v pacman >/dev/null 2>&1; then
	echo
	echo "=== orphaned packages (listed only, never auto-removed) ==="
	orphans="$(pacman -Qtdq 2>/dev/null)"
	if [ -z "$orphans" ]; then
		echo "none"
	else
		printf "%s\n" "$orphans"
		echo "remove by hand with: sudo pacman -Rns \$(pacman -Qtdq)"
	fi
fi

echo
echo "=== systemd journal ==="
if command -v journalctl >/dev/null 2>&1; then
	journalctl --disk-usage
else
	echo "journalctl not found (not a systemd system)"
fi

echo
echo "=== container images (podman/docker, dangling only) ==="
if command -v podman >/dev/null 2>&1; then
	podman images --filter dangling=true 2>/dev/null
elif command -v docker >/dev/null 2>&1; then
	docker images --filter dangling=true 2>/dev/null
else
	echo "no podman/docker found"
fi

echo
echo "=== Flatpak ==="
if command -v flatpak >/dev/null 2>&1; then
	# real, deliberate: flatpak has no dry-run flag for `uninstall
	# --unused` (checked by hand, `flatpak uninstall --help`) - running
	# it here just to "preview" would actually remove things, so this
	# only reports the current runtime count instead of pretending to
	# preview an operation that can't actually be previewed.
	echo "$(flatpak list --runtime | wc -l) runtime(s) installed - unused ones removed on confirm below"
else
	echo "flatpak not found"
fi

echo
echo "=== language-toolchain caches ==="
command -v npm >/dev/null 2>&1 && { echo "npm cache: $(du -sh "$(npm config get cache 2>/dev/null)" 2>/dev/null | cut -f1)"; }
command -v pip >/dev/null 2>&1 && { echo "pip cache: $(du -sh "$HOME/.cache/pip" 2>/dev/null | cut -f1)"; }
command -v cargo >/dev/null 2>&1 && { echo "cargo registry cache: $(du -sh "$HOME/.cargo/registry" 2>/dev/null | cut -f1)"; }

echo
echo "=== ~/.cache files older than 30 days ==="
stale="$(find "$HOME/.cache" -type f -mtime +30 2>/dev/null)"
if [ -z "$stale" ]; then
	echo "nothing stale"
else
	printf "%s\n" "$stale" | wc -l | xargs echo "files:"
fi

echo
echo "=== Trash entries older than 30 days ==="
trash_files="${XDG_DATA_HOME:-$HOME/.local/share}/Trash/files"
stale_trash="$(find "$trash_files" -maxdepth 1 -mtime +30 2>/dev/null)"
if [ -z "$stale_trash" ]; then
	echo "nothing stale"
else
	printf "%s\n" "$stale_trash" | wc -l | xargs echo "entries:"
fi

printf "\nproceed with real cleanup? [y/N] "
read -r confirm
if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
	echo "cancelled - nothing removed"
	exit 0
fi

case "$pm" in
pacman) sudo paccache -r -k3 ;;
apt) sudo apt-get -y autoclean ;;
dnf) sudo dnf clean all ;;
zypper) sudo zypper clean ;;
apk) sudo apk cache clean ;;
xbps) sudo xbps-remove -O ;;
portage) sudo eclean packages ;;
esac

command -v journalctl >/dev/null 2>&1 && sudo journalctl --vacuum-time=2weeks
command -v podman >/dev/null 2>&1 && podman image prune -f
command -v docker >/dev/null 2>&1 && docker image prune -f
command -v flatpak >/dev/null 2>&1 && flatpak uninstall --unused --noninteractive --assumeyes
command -v npm >/dev/null 2>&1 && npm cache clean --force
command -v pip >/dev/null 2>&1 && pip cache purge
command -v cargo >/dev/null 2>&1 && cargo cache -a 2>/dev/null
[ -n "$stale" ] && printf "%s\n" "$stale" | xargs -r rm -f
[ -n "$stale_trash" ] && printf "%s\n" "$stale_trash" | xargs -r rm -rf
echo "done"
