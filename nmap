#!/bin/sh
# nmap - presets in front of the real nmap.
#
# Picks the first nmap on PATH that is not this script, so it is safe to
# put on PATH under the name nmap. Presets cover the scans reached for
# day to day; anything else goes straight through with `--`.
#
# usage: nmap                  pick a preset and a target interactively
#        nmap PRESET TARGET    quick | full | ping | service
#        nmap -- ARGS...       pass ARGS to the real nmap unchanged

case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac

# first nmap on PATH that is not this script (this file may itself be on PATH as "nmap")
self=$(readlink -f -- "$0" 2>/dev/null || echo "$0")
REAL=
oldifs=$IFS; IFS=:
for d in $PATH; do
	c="${d:-.}/nmap"
	[ -x "$c" ] && [ -f "$c" ] || continue
	[ "$(readlink -f -- "$c" 2>/dev/null || echo "$c")" = "$self" ] && continue
	REAL=$c; break
done
IFS=$oldifs
[ -n "$REAL" ] || { echo "nmap: need the real nmap on PATH" >&2; exit 1; }

if [ "$1" = "--" ]; then
	shift
	exec "$REAL" "$@"
fi

preset=$1
target=$2

if [ -z "$preset" ]; then
	echo "presets: [1] quick (top ports, fast)  [2] full TCP  [3] ping sweep (who's up)  [4] service/version detect"
	printf "preset [1]: "
	read -r preset
	[ -n "$preset" ] || preset=1
fi
if [ -z "$target" ]; then
	printf "target (host, CIDR, or range): "
	read -r target
	[ -n "$target" ] || exit 1
fi

case "$preset" in
	1|quick) exec "$REAL" -T4 -F "$target" ;;
	2|full)  exec "$REAL" -p- "$target" ;;
	3|ping|sweep) exec "$REAL" -sn "$target" ;;
	4|service|version) exec "$REAL" -sV "$target" ;;
	*) echo "nmap: unknown preset '$preset'" >&2; exit 2 ;;
esac
