#!/usr/bin/env bash
# todo - minimal todo.txt task capture.
#
# One task per line in ${XDG_DATA_HOME:-~/.local/share}/todo/todo.txt,
# todo.txt convention: priority and creation date. Finished tasks move to
# done.txt, they are not deleted.
#
# usage: todo "task description"    add a task
#        todo ls                    list tasks, numbered
#        todo done N                finish task N

case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac


todo_dir="${XDG_DATA_HOME:-$HOME/.local/share}/todo"
mkdir -p "$todo_dir"
todo_file="$todo_dir/todo.txt"
done_file="$todo_dir/done.txt"
touch "$todo_file" "$done_file"

if [ "$1" = "ls" ]; then
	awk '{ printf "%3d  %s\n", NR, $0 }' "$todo_file"
elif [ "$1" = "done" ] && [ -n "$2" ]; then
	line="$(sed -n "${2}p" "$todo_file")"
	if [ -z "$line" ]; then
		echo "no task #$2"
		exit 1
	fi
	echo "x $(date +%Y-%m-%d) $line" >> "$done_file"
	sed -i "${2}d" "$todo_file"
	echo "done: $line"
elif [ -n "$1" ]; then
	echo "(B) $(date +%Y-%m-%d) $*" >> "$todo_file"
	echo "added"
else
	echo 'usage: todo "task description"  |  todo ls  |  todo done N' >&2
	exit 1
fi
