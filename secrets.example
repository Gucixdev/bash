# Shape of ~/.secrets: KEY=value per line, mode 600, kept outside any repo.
# Load it from your shell rc with `set -a; . ~/.secrets; set +a`. The tools
# read plain environment variables, nothing here is auto-loaded by them.

# gh - GitHub. Optional: without it the token the real gh is logged in with
# is used. Needed for private repos, your repo list, create/remove/public/
# private, and to avoid rate limits; remove also needs the delete_repo scope.
GH_TOKEN=

# hf - Hugging Face Hub. Needed for private/gated repos.
HF_TOKEN=
