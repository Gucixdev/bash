# Shape of ~/.secrets: KEY=value per line, mode 600, kept outside any repo.
# Load it from your shell rc with `set -a; . ~/.secrets; set +a`. The tools
# read plain environment variables, nothing here is auto-loaded by them.

# gitgrab - GitHub. Optional: without it the token `gh` is logged in with is
# used. Needed for private repos or to avoid rate limits.
GH_TOKEN=

# ezhf - Hugging Face Hub. Needed for private/gated repos.
HF_TOKEN=
