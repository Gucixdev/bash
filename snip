#!/bin/sh
# snip - region screenshot straight to the clipboard, no file written.
#
# Pairs with `screenshot`, which saves a file. Needs slurp (region
# select), grim (capture) and wl-copy (Wayland clipboard).
#
# usage: snip

case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac

for t in slurp grim wl-copy; do
	command -v "$t" >/dev/null 2>&1 || { echo "snip: need '$t' on PATH" >&2; exit 1; }
done

geom=$(slurp) || exit 1
grim -g "$geom" - | wl-copy --type image/png
