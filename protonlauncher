#!/usr/bin/env bash
# protonlauncher - run a Windows game or exe through a Proton install, one prefix per game.
# Wraps the real thing: Proton's own `proton` script from Steam's compatibilitytools.d (GE-Proton and friends,
# what ProtonUp installs) or steamapps/common/Proton*. Prefixes live in ~/.local/share/protonlauncher/prefixes.
# Optional helpers are used when present: gamemoderun, mangohud, gamescope, winetricks. Steam itself is not needed.
#
#   protonlauncher                          no arguments: a menu
#   protonlauncher tools                    Proton installs found (TSV: name, kind, path), newest first
#   protonlauncher list                     prefixes (one per game): name, tool, preset, last run
#   protonlauncher run [-n] [-p NAME] [-t TOOL] [-e PRESET] [--gamescope] [--mangohud] [--no-gamemode] EXE [ARGS]
#                                           show the plan, then run EXE; -n = only show. Prefix defaults to the
#                                           exe's folder name, tool to the newest GE-Proton (else newest found)
#   protonlauncher presets                  env presets: default, dxvk-async, wined3d, lowend, debug
#   protonlauncher prefix [new|rm|path] NAME   make / remove (to the trash) / print a prefix
#   protonlauncher winecfg NAME             Wine configuration inside that prefix
#   protonlauncher winetricks NAME [ARGS]   system winetricks on that prefix
#   protonlauncher doctor                   check what is there and what is missing
#
# Environment: PROTON_DIRS (extra directories holding Proton installs, colon separated)
#   PROTONLAUNCHER_HOME (prefix root)  STEAM_ROOT (Steam directory for STEAM_COMPAT_CLIENT_INSTALL_PATH)

# shellcheck disable=SC1007  # a= b= sets several variables to empty on purpose (lazytui block)
set -u
case ${1:-} in -h | --help | help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac

die() { printf 'protonlauncher: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" > /dev/null 2>&1; }
HOME_DIR=${PROTONLAUNCHER_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/protonlauncher}
PFX=$HOME_DIR/prefixes

# >>> lazytui (copy of lib/lazytui) >>>
# _lt_hint KEYNAME LABEL -> key caps then LABEL (the nnn hint-bar look). KEYNAME is an fzf key
# (ctrl-r, alt-enter, ctrl-alt-x, shift-up, f5, space...). Every modifier gets its own coloured cap
# (Ctrl blue, Alt yellow, Shift green), the key itself is a reverse-video cap.
_lt_hint() {
	_lt_h=$1
	while :; do
		case $_lt_h in
			ctrl-?*)  printf '\033[30;44m Ctrl \033[0m'; _lt_h=${_lt_h#ctrl-} ;;
			alt-?*)   printf '\033[30;43m Alt \033[0m'; _lt_h=${_lt_h#alt-} ;;
			shift-?*) printf '\033[30;42m Shift \033[0m'; _lt_h=${_lt_h#shift-} ;;
			*) break ;;
		esac
	done
	case $_lt_h in
		?) _lt_h=$(printf %s "$_lt_h" | tr '[:lower:]' '[:upper:]') ;;
		enter) _lt_h=Enter ;; esc) _lt_h=Esc ;; tab) _lt_h=Tab ;; btab) _lt_h='Shift+Tab' ;; space) _lt_h=Space ;;
		bspace) _lt_h=Backspace ;; pgup) _lt_h=PgUp ;; pgdn) _lt_h=PgDn ;; del) _lt_h=Del ;;
		up) _lt_h='↑' ;; down) _lt_h='↓' ;; left) _lt_h='←' ;; right) _lt_h='→' ;;
	esac
	printf '\033[7m %s \033[0m %s   ' "$_lt_h" "$2"
}

# _lt_trim STR -> STR without leading/trailing blanks
_lt_trim() { printf %s "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

# _lt_script FILE CMD -> FILE runs CMD "$@" (keeps quoting out of fzf binds)
_lt_script() { printf '%s "$@"\n' "$2" >"$1"; }

lt_confirm() {   # lt_confirm "question" -> 0 on y
	printf '%s [y/N] ' "$1" >&2
	read -r _lt_a || return 1
	case $_lt_a in y | Y | yes | YES | t | T | tak) return 0 ;; *) return 1 ;; esac
}

lt_input() {   # lt_input "prompt" [default] -> stdout
	printf '%s%s: ' "$1" "${2:+ [$2]}" >&2
	read -r _lt_a || return 1
	printf '%s\n' "${_lt_a:-${2:-}}"
}

lt_select() {
	_lt_mode=raw _lt_refresh=${LT_REFRESH:-0} _lt_seed= _lt_more= _lt_reload= _lt_preview= _lt_keys= \
	_lt_key=1 _lt_nth= _lt_header= _lt_prompt='> '
	while [ $# -gt 0 ]; do
		case $1 in
			--mode)    _lt_mode=$2;    shift 2 ;;
			--seed)    _lt_seed=$2;    shift 2 ;;
			--more)    _lt_more=$2;    shift 2 ;;
			--refresh) _lt_refresh=$2; shift 2 ;;
			--reload)  _lt_reload=$2;  shift 2 ;;
			--preview) _lt_preview=$2; shift 2 ;;
			--keys)    _lt_keys=$2;    shift 2 ;;
			--key)     _lt_key=$2;     shift 2 ;;
			--nth)     _lt_nth=$2;     shift 2 ;;
			--header)  _lt_header=$2;  shift 2 ;;
			--prompt)  _lt_prompt=$2;  shift 2 ;;
			*) echo "lt_select: unknown arg $1" >&2; return 2 ;;
		esac
	done
	case $_lt_refresh in '' | *[!0-9]*) echo "lt_select: --refresh wants milliseconds, got '$_lt_refresh'" >&2; return 2 ;; esac
	case $_lt_mode in raw | select) ;; *) echo "lt_select: --mode must be raw or select" >&2; return 2 ;; esac

	_lt_tmp=$(mktemp -d) || return 1
	if [ -n "$_lt_seed" ]; then
		_lt_script "$_lt_tmp/seed.sh" "$_lt_seed"
	else
		cat >"$_lt_tmp/list"
		printf 'cat "%s/list"\n' "$_lt_tmp" >"$_lt_tmp/seed.sh"
	fi

	if ! command -v fzf >/dev/null 2>&1; then
		_lt_fallback; _lt_rc=$?
		rm -rf "$_lt_tmp"; return $_lt_rc
	fi
	# what this fzf can do: the C fzf the menus were built with takes a label on each bind and draws the
	# key bar itself (--hints); upstream fzf needs 0.63 for the footer bar, 0.71 to keep the cursor on its
	# row across refreshes. An older one gets the numbered list.
	_lt_hints= _lt_fzfv=$(fzf --version 2>/dev/null)
	case $_lt_fzfv in *-c\ * | *-c) _lt_hints=1 ;; esac
	_lt_minor=$(printf '%s\n' "$_lt_fzfv" | sed -n 's/^0\.\([0-9][0-9]*\).*/\1/p')
	[ -n "$_lt_minor" ] || _lt_minor=999
	if [ -z "$_lt_hints" ] && [ "$_lt_minor" -lt 63 ]; then
		echo "lt_select: fzf ${_lt_fzfv%% *} is too old for these menus (0.63 or newer), here is a numbered list" >&2
		_lt_fallback; _lt_rc=$?
		rm -rf "$_lt_tmp"; return $_lt_rc
	fi

	TAB=$(printf '\t')
	_lt_k="{+$_lt_key}"
	set -- --delimiter="$TAB" --ansi --prompt="$_lt_prompt" --footer-border=none --layout=reverse-list
	[ -n "$_lt_header" ] && set -- "$@" --header="$_lt_header"
	[ -n "$_lt_nth" ] && set -- "$@" --with-nth="$_lt_nth"
	if [ -n "$_lt_preview" ]; then
		_lt_script "$_lt_tmp/preview.sh" "$_lt_preview"
		set -- "$@" --preview="sh $_lt_tmp/preview.sh {$_lt_key}" \
			--preview-window="${LT_PREVIEW_WINDOW:-down,60%,wrap}"
	fi
	_lt_start=
	if [ -n "$_lt_more" ]; then
		cat >"$_lt_tmp/more.sh" <<EOF
out=\$(mktemp)
$_lt_more > "\$out" 2>/dev/null || true
if [ -s "\$out" ]; then
	curl -s -XPOST "127.0.0.1:\$1" --data "reload(cat \$out; rm -f \$out)" >/dev/null 2>&1 || rm -f "\$out"
else rm -f "\$out"; fi
EOF
		_lt_start="$_lt_start sh $_lt_tmp/more.sh \$FZF_PORT &"
	fi
	if [ "$_lt_refresh" -gt 0 ] && [ -z "$_lt_reload" ] && command -v curl >/dev/null 2>&1; then
		# background loop: run the seed, post it to fzf only when it changed;
		# it ends by itself once fzf's port stops answering
		_lt_secs=$(awk -v ms="$_lt_refresh" 'BEGIN { if (ms < 50) ms = 50; printf "%.3f", ms / 1000 }')
		cat >"$_lt_tmp/refresh.sh" <<EOF
port=\$1; last=$_lt_tmp/last; new=$_lt_tmp/new
sh $_lt_tmp/seed.sh >"\$last" 2>/dev/null
while sleep $_lt_secs; do
	[ -d $_lt_tmp ] || exit 0
	sh $_lt_tmp/seed.sh >"\$new" 2>/dev/null || continue
	cmp -s "\$last" "\$new" && continue
	cp "\$new" "\$last"
	curl -s -m 2 -XPOST "127.0.0.1:\$port" --data "reload-sync(cat $_lt_tmp/last)" >/dev/null 2>&1 || exit 0
done
EOF
		_lt_start="$_lt_start sh $_lt_tmp/refresh.sh \$FZF_PORT &"
		if [ -n "$_lt_hints" ] || [ "$_lt_minor" -ge 71 ]; then set -- "$@" --track --id-nth="$_lt_key"; fi
	fi
	[ -n "$_lt_start" ] && set -- "$@" --listen --bind="start:execute-silent($_lt_start)"
	if [ -n "$_lt_reload" ]; then
		printf '%s\n' "$_lt_reload" | sed 's/{q}/"$1"/g' >"$_lt_tmp/reload.sh"
		set -- "$@" --bind="change:reload(sh $_lt_tmp/reload.sh {q})"
	fi

	# mode: select = no input line, space marks, / opens search
	_lt_bar= _lt_ubar=
	# our own fzf draws the key hint bar itself (--hints, held modifiers, clickable); others get a footer
	if [ "$_lt_mode" = select ]; then
		if [ -n "$_lt_hints" ]; then _lt_mark=' # mark' _lt_find=' # search'; else _lt_mark= _lt_find=; fi
		set -- "$@" --multi --no-input \
			--bind="space:toggle+down$_lt_mark,tab:down,btab:up,/:show-input$_lt_find" \
			--bind='esc:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo abort || echo "clear-query+hide-input"'
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint space mark)$(_lt_hint / search)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	else
		_lt_bar="$(_lt_hint '↑↓' move)$(_lt_hint type filter)$(_lt_hint enter accept)$(_lt_hint esc quit)"
	fi

	# yaml key map -> binds + key bar
	_lt_n=0
	if [ -n "$_lt_keys" ]; then
		[ "$_lt_keys" = - ] && printf '%s\n' "${LT_KEYS:-}" >"$_lt_tmp/keys" || cat "$_lt_keys" >"$_lt_tmp/keys"
		while IFS= read -r _lt_line || [ -n "$_lt_line" ]; do
			_lt_line=$(_lt_trim "$_lt_line")
			case $_lt_line in '' | '#'*) continue ;; esac
			# a line of just --- starts a new line in the key bar
			[ "$_lt_line" = --- ] && { _lt_ubar="$_lt_ubar
"; _lt_fresh=1; continue; }
			_lt_kn=$(_lt_trim "${_lt_line%%:*}")
			_lt_rest=${_lt_line#*:}
			case $_lt_rest in
				*' # '*) _lt_label=$(_lt_trim "${_lt_rest##* # }"); _lt_act=$(_lt_trim "${_lt_rest% # *}") ;;
				*)       _lt_label=; _lt_act=$(_lt_trim "$_lt_rest") ;;
			esac
			_lt_n=$((_lt_n + 1))
			_lt_reloadact="+reload(sh $_lt_tmp/seed.sh)"
			case $_lt_act in
				refresh)  _lt_bind="reload(sh $_lt_tmp/seed.sh)" ;;
				quit)     _lt_bind=abort ;;
				'!'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#!}"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)$_lt_reloadact" ;;
				'>'*)     _lt_script "$_lt_tmp/a$_lt_n.sh" "${_lt_act#>}"
				          _lt_bind="become(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
				accept | select-all | deselect-all | toggle | toggle-all | first | last | up | down | page-up | page-down | abort | clear-query | show-input | hide-input)
				          _lt_bind=$_lt_act ;;
				*)        _lt_script "$_lt_tmp/a$_lt_n.sh" "$_lt_act"
				          _lt_bind="execute(sh $_lt_tmp/a$_lt_n.sh $_lt_k)" ;;
			esac
			if [ -n "$_lt_hints" ] && [ -n "$_lt_label" ]; then set -- "$@" --bind="$_lt_kn:$_lt_bind # $_lt_label"
			else set -- "$@" --bind="$_lt_kn:$_lt_bind"; fi
			if [ -n "$_lt_label" ]; then
				_lt_ubar="$_lt_ubar$(_lt_hint "$_lt_kn" "$_lt_label")"
				_lt_fresh=
			fi
		done <"$_lt_tmp/keys"
	fi
	# defaults on line one, the key map's labels on line two
	if [ -n "$_lt_hints" ]; then set -- "$@" --hints
	else set -- "$@" --footer="$_lt_bar${_lt_ubar:+
$_lt_ubar}"; fi

	_lt_sel=$(sh "$_lt_tmp/seed.sh" | fzf "$@"); _lt_rc=$?
	rm -rf "$_lt_tmp"
	[ $_lt_rc -eq 0 ] || return 1
	[ -n "$_lt_sel" ] && printf '%s\n' "$_lt_sel" | cut -f"$_lt_key"
	return 0
}

# numbered prompt when fzf is missing
_lt_fallback() {
	sh "$_lt_tmp/seed.sh" >"$_lt_tmp/fb"
	[ -s "$_lt_tmp/fb" ] || return 1
	awk -F'\t' '{ printf "%3d) %s\n", NR, ($1 == "" ? $0 : $0) }' "$_lt_tmp/fb" | tr '\t' ' ' >&2
	printf 'pick number%s, q to cancel: ' "$([ "$_lt_mode" = select ] && echo 's (space separated)')" >&2
	read -r _lt_ans || return 1
	case $_lt_ans in '' | q) return 1 ;; esac
	for _lt_i in $_lt_ans; do sed -n "${_lt_i}p" "$_lt_tmp/fb"; done | cut -f"$_lt_key"
}

# lt_realbin NAME -> path of the real NAME in PATH, skipping this script
# itself. For tools that wrap a program of the same name (a script called
# docker or flatpak) so they never call themselves.
lt_realbin() {
	_lt_old=$IFS; IFS=:
	for _lt_d in $PATH; do
		IFS=$_lt_old
		_lt_c=$_lt_d/$1
		if [ -x "$_lt_c" ] && [ ! -d "$_lt_c" ] && [ "$(readlink -f -- "$_lt_c" 2>/dev/null || echo "$_lt_c")" != "$(readlink -f -- "$0" 2>/dev/null || echo "$0")" ]; then printf '%s\n' "$_lt_c"; return 0; fi
		IFS=:
	done
	IFS=$_lt_old
	return 1
}

# <<< lazytui <<<

# ---- tools ----------------------------------------------------------------
steam_roots() { # existing Steam directories, one per line
	for r in "${STEAM_ROOT:-}" "$HOME/.steam/steam" "${XDG_DATA_HOME:-$HOME/.local/share}/Steam" "$HOME/.var/app/com.valvesoftware.Steam/data/Steam"; do
		[ -n "$r" ] && [ -d "$r" ] && readlink -f "$r"
	done | awk '!s[$0]++'
}
tool_dirs() { # dir TAB kind
	steam_roots | while IFS= read -r r; do
		printf '%s\tcustom\n' "$r/compatibilitytools.d"
		printf '%s\tsteam\n' "$r/steamapps/common"
	done
	_ifs=$IFS; IFS=:
	# shellcheck disable=SC2086   # split on : on purpose
	for d in ${PROTON_DIRS:-}; do printf '%s\tcustom\n' "$d"; done
	IFS=$_ifs
}
tools_list() { # name TAB kind TAB path, newest version first
	tool_dirs | while IFS='	' read -r d k; do
		[ -d "$d" ] || continue
		for t in "$d"/*/; do
			[ -x "${t}proton" ] || [ -f "${t}proton" ] || continue
			t=${t%/}
			case $k:${t##*/} in steam:Proton* | custom:*) printf '%s\t%s\t%s\n' "${t##*/}" "$k" "$t" ;; esac
		done
	done | awk -F '\t' '!s[$1]++' | sort -t '	' -k1,1 -V -r
}
default_tool() { # newest GE-Proton, else the first one found
	_d=$(tools_list | awk -F '\t' '$1 ~ /^GE-Proton/ { print $1; exit }')
	[ -n "$_d" ] || _d=$(tools_list | head -1 | cut -f1)
	printf '%s\n' "$_d"
}
tool_path() { tools_list | awk -F '\t' -v n="$1" '$1 == n { print $3; exit }'; }

# ---- presets --------------------------------------------------------------
presets() { # name TAB env assignments TAB wrappers (gamemode mangohud gamescope) TAB note
	printf 'default\tPROTON_NO_FSYNC=0\tgamemode\tgamemode when present\n'
	printf 'dxvk-async\tDXVK_ASYNC=1 DXVK_STATE_CACHE=1\tgamemode\tless shader stutter (GE builds)\n'
	printf 'wined3d\tPROTON_USE_WINED3D=1\tgamemode\tOpenGL instead of DXVK/VKD3D: old GPUs, old games\n'
	printf 'lowend\tDXVK_ASYNC=1 PROTON_NO_ESYNC=1 DXVK_FRAME_RATE=30\tgamemode gamescope\t720p upscaled, 30 fps cap\n'
	printf 'debug\tPROTON_LOG=1 WINEDEBUG=err+all\t\tlog in ~/steam-APPID.log\n'
}
preset_field() { presets | awk -F '\t' -v n="$1" -v c="$2" '$1 == n { print $c; f = 1 } END { exit !f }'; }

# ---- prefixes -------------------------------------------------------------
safe_name() { case $1 in '' | */* | .* | *[!A-Za-z0-9._-]*) return 1 ;; esac; }
prefix_dir() { safe_name "$1" || die "bad prefix name '$1' (letters, digits, . _ - only)"; printf '%s/%s\n' "$PFX" "$1"; }
conf_get() { [ -f "$1/.pl.conf" ] && sed -n "s/^$2=//p" "$1/.pl.conf" | tail -1; }
conf_set() { # conf_set DIR KEY VALUE, atomic
	mkdir -p "$1"
	_t=$(mktemp "$1/.pl.XXXXXX") || return 1
	{ [ -f "$1/.pl.conf" ] && grep -v "^$2=" "$1/.pl.conf"; printf '%s=%s\n' "$2" "$3"; } > "$_t"
	mv "$_t" "$1/.pl.conf"
}
cmd_list() {
	printf 'name\ttool\tpreset\tlast run\n'
	for d in "$PFX"/*/; do
		[ -d "$d" ] || continue
		printf '%s\t%s\t%s\t%s\n' "$(basename "$d")" "$(conf_get "${d%/}" tool)" "$(conf_get "${d%/}" preset)" "$(conf_get "${d%/}" last)"
	done
}
cmd_prefix() {
	case ${1:-} in
		new) d=$(prefix_dir "${2:-}") || exit 1; mkdir -p "$d/pfx" && echo "$d" ;;
		path) prefix_dir "${2:-}" ;;
		rm)
			d=$(prefix_dir "${2:-}") || exit 1
			[ -d "$d" ] || die "no such prefix: $2"
			echo "will move $d ($(du -sh "$d" 2> /dev/null | cut -f1)) to the trash"
			lt_confirm "remove?" || { echo cancelled; return 0; }
			if have trash-put; then trash-put -- "$d"; else mkdir -p "$HOME_DIR/.trash"; mv -- "$d" "$HOME_DIR/.trash/$2.$(date +%s)"; fi ;;
		'' ) cmd_list ;;
		*) die "prefix: new NAME | path NAME | rm NAME" ;;
	esac
}

# ---- run ------------------------------------------------------------------
cmd_run() {
	dry= name= tool= preset=default gs= mh= nogm=
	while [ $# -gt 0 ]; do
		case $1 in
			-n | --dry-run) dry=1; shift ;;
			-p | --prefix) name=${2:-}; shift 2 || die "-p needs a name" ;;
			-t | --tool) tool=${2:-}; shift 2 || die "-t needs a tool name" ;;
			-e | --preset) preset=${2:-}; shift 2 || die "-e needs a preset" ;;
			--gamescope) gs=1; shift ;;
			--mangohud) mh=1; shift ;;
			--no-gamemode) nogm=1; shift ;;
			--) shift; break ;;
			-*) die "run: unknown option $1" ;;
			*) break ;;
		esac
	done
	[ $# -gt 0 ] || die "usage: protonlauncher run [options] EXE [ARGS]"
	exe=$1; shift
	[ -f "$exe" ] || die "no such file: $exe"
	exe=$(readlink -f "$exe")
	[ -n "$name" ] || name=$(basename "$(dirname "$exe")" | sed 's/[^A-Za-z0-9._-]/_/g; s/^[._-]*//')
	[ -n "$name" ] || name=game
	pdir=$(prefix_dir "$name") || exit 1
	[ -n "$tool" ] || tool=$(conf_get "$pdir" tool)
	[ -n "$tool" ] || tool=$(default_tool)
	[ -n "$tool" ] || die "no Proton install found. Put GE-Proton in ~/.steam/steam/compatibilitytools.d (ProtonUp / steamdeck's protonup), or set PROTON_DIRS. See: protonlauncher doctor"
	tp=$(tool_path "$tool")
	[ -n "$tp" ] || die "tool '$tool' not found (protonlauncher tools)"
	penv=$(preset_field "$preset" 2) || die "unknown preset '$preset' (protonlauncher presets)"
	pwrap=$(preset_field "$preset" 3)
	case " $pwrap " in *' gamescope '*) gs=1 ;; esac
	gm=; case " $pwrap " in *' gamemode '*) [ -n "$nogm" ] || gm=1 ;; esac
	wrap=()
	[ -n "$gm" ] && { if have gamemoderun; then wrap+=(gamemoderun); else echo "protonlauncher: gamemoderun not found, going without" >&2; fi; }
	[ -n "$mh" ] && { if have mangohud; then wrap+=(mangohud); else echo "protonlauncher: mangohud not found, going without" >&2; fi; }
	if [ -n "$gs" ]; then
		if have gamescope; then wrap+=(gamescope -W 1920 -H 1080 -w 1280 -h 720 -f --); else echo "protonlauncher: gamescope not found, going without" >&2; fi
	fi
	root=$(steam_roots | head -1)
	[ -n "$root" ] || root=$HOME_DIR/steam-stub
	cmd=("${wrap[@]}" "$tp/proton" run "$exe" "$@")
	{
		printf 'tool    : %s (%s)\n' "$tool" "$tp"
		printf 'prefix  : %s\n' "$pdir"
		printf 'preset  : %s  %s\n' "$preset" "$penv"
		printf 'command : %s\n' "${cmd[*]}"
	} >&2
	[ -n "$dry" ] && return 0
	mkdir -p "$pdir/pfx"
	conf_set "$pdir" tool "$tool"; conf_set "$pdir" preset "$preset"; conf_set "$pdir" last "$(date '+%F %H:%M')"
	# shellcheck disable=SC2086   # $penv is a list of NAME=value words
	exec env STEAM_COMPAT_DATA_PATH="$pdir" STEAM_COMPAT_CLIENT_INSTALL_PATH="$root" SteamAppId=0 SteamGameId=0 $penv "${cmd[@]}"
}
cmd_in_prefix() { # winecfg / winetricks
	what=$1; shift
	[ -n "${1:-}" ] || die "usage: protonlauncher $what NAME"
	pdir=$(prefix_dir "$1") || exit 1; shift
	[ -d "$pdir/pfx" ] || die "no such prefix: ${pdir##*/} (protonlauncher prefix new NAME, or run a game first)"
	tool=$(conf_get "$pdir" tool); [ -n "$tool" ] || tool=$(default_tool)
	tp=$(tool_path "$tool")
	[ -n "$tp" ] || die "no Proton install found (protonlauncher doctor)"
	root=$(steam_roots | head -1); [ -n "$root" ] || root=$HOME_DIR/steam-stub
	case $what in
		winecfg)
			exec env STEAM_COMPAT_DATA_PATH="$pdir" STEAM_COMPAT_CLIENT_INSTALL_PATH="$root" "$tp/proton" run winecfg ;;
		winetricks)
			have winetricks || die "winetricks is missing (pacman -S winetricks / apt install winetricks)"
			w=$tp/files/bin/wine; [ -x "$w" ] || w=$tp/dist/bin/wine
			[ -x "$w" ] || w=$(command -v wine) || die "no wine found in $tool, and none on PATH"
			echo "winetricks on $pdir/pfx with $w" >&2
			exec env WINEPREFIX="$pdir/pfx" WINE="$w" winetricks "$@" ;;
	esac
}

# ---- doctor ---------------------------------------------------------------
cmd_doctor() {
	bad=0
	chk() { case $1 in ok) printf '  ok    %-12s %s\n' "$2" "$3" ;; warn) printf '  warn  %-12s %s\n' "$2" "$3" ;; *) printf '  FAIL  %-12s %s\n' "$2" "$3"; bad=1 ;; esac; }
	n=$(tools_list | wc -l)
	if [ "$n" -gt 0 ]; then chk ok proton "$n install(s), default: $(default_tool)"; else chk fail proton "none found - install GE-Proton into ~/.steam/steam/compatibilitytools.d (ProtonUp, or /data/dev/github/steamdeck's protonup)"; fi
	[ -n "$(steam_roots)" ] && chk ok steam "$(steam_roots | head -1)" || chk warn steam "no Steam directory - a stub is used for STEAM_COMPAT_CLIENT_INSTALL_PATH"
	for c in gamemoderun mangohud gamescope winetricks; do have "$c" && chk ok "$c" "" || chk warn "$c" "missing - optional"; done
	have vulkaninfo && { vulkaninfo --summary > /dev/null 2>&1 && chk ok vulkan "works" || chk warn vulkan "vulkaninfo fails - check the GPU driver"; } || chk warn vulkan "vulkaninfo missing (vulkan-tools)"
	have fzf && chk ok fzf "menus" || chk warn fzf "missing - menus become numbered lists"
	chk ok prefixes "$PFX ($(find "$PFX" -mindepth 1 -maxdepth 1 -type d 2> /dev/null | wc -l) prefix(es))"
	return $bad
}

# ---- menu -----------------------------------------------------------------
menu() {
	while :; do
		_c=$(printf '%s\t%s\n' run "run an exe" list "prefixes" tools "Proton installs" presets "env presets" \
			winecfg "winecfg in a prefix" winetricks "winetricks in a prefix" doctor "check setup" quit "leave" |
			lt_select --header "protonlauncher  ($(tools_list | wc -l) Proton install(s))" --prompt 'proton> ' --mode select) || return 0
		_c=${_c%%	*}
		case $_c in
			quit | '') return 0 ;;
			run)
				exe=$(lt_input "exe path") || return 0
				[ -n "$exe" ] || continue
				"$0" run -n "$exe" && lt_confirm "run it?" && "$0" run "$exe" ;;
			winecfg | winetricks)
				p=$(cmd_list | tail -n +2 | cut -f1 | lt_select --prompt 'prefix> ' --mode select) || continue
				"$0" "$_c" "${p%%	*}" ;;
			*) "$0" "$_c" || true ;;
		esac
		printf '\n[enter] ' >&2; read -r _ || return 0
	done
}

case ${1:-} in
	tools) printf 'name\tkind\tpath\n'; tools_list ;;
	list) cmd_list ;;
	run) shift; cmd_run "$@" ;;
	presets) printf 'name\tenv\twrappers\tnote\n'; presets ;;
	prefix) shift; cmd_prefix "$@" ;;
	winecfg | winetricks) w=$1; shift; cmd_in_prefix "$w" "$@" ;;
	doctor) cmd_doctor ;;
	'') if [ -t 0 ] && [ -t 1 ]; then menu; else tools_list | head -5; cmd_list; fi ;;
	*) die "unknown command '$1' (protonlauncher --help)" ;;
esac
